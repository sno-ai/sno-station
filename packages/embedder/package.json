{
  "name": "@snoai/embedder",
  "version": "1.1.0",
  "description": "Local on-device text embeddings with a pinned model, used by Sno Station.",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sno-ai/sno-station.git",
    "directory": "packages/embedder"
  },
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.mts", "import": "./dist/index.mjs" }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsdown src/index.ts --no-config --format esm --target node22 --platform node --dts --deps.never-bundle @snoai/utils",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/"
  },
  "devDependencies": { "tsdown": "0.23.0" },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@snoai/utils": "^1.1.0",
    "async-mutex": "^0.5.0",
    "lru-cache": "^11.0.0"
  }
}
