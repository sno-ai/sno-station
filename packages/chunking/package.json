{
	"name": "@snoai/chunking",
	"version": "1.0.1",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sno-ai/sno-station.git",
		"directory": "packages/chunking"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"package.json"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/ tests/",
		"lint:fix": "biome check --write src/ tests/",
		"test": "vitest run tests"
	},
	"dependencies": {
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@types/node": "^26.6.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.5"
	}
}
