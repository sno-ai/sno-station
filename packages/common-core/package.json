{
	"name": "@snoai/common-core",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"publishConfig": { "access": "public" },
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sno-ai/sno-station.git",
		"directory": "packages/common-core"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md",
		"package.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/ tests/",
		"lint:fix": "biome check --write src/ tests/",
		"test": "npm run build && node --test tests/**/*.test.mjs"
	},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.3.0",
		"uuid": "^14.0.0"
	},
	"devDependencies": {
		"@types/node": "^22.0.0"
	},
	"engines": {
		"node": ">=22.14.0"
	}
}
