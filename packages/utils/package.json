{
  "name": "@snoai/utils",
  "version": "1.1.2",
  "description": "Logs you can actually read. When something goes wrong in Sno Station, this is how you find out why.",
  "license": "Apache-2.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sno-ai/sno-station.git",
    "directory": "packages/utils"
  },
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./logger": { "types": "./dist/logger.d.ts", "default": "./dist/logger.js" },
    "./log-encoder": { "types": "./dist/log-encoder.d.ts", "default": "./dist/log-encoder.js" },
    "./log-context": { "types": "./dist/log-context.d.ts", "default": "./dist/log-context.js" },
    "./log-site-catalog.json": "./dist/log-site-catalog.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "dependencies": { "fs-native-extensions": "^1.5.1" },
  "devDependencies": { "@babel/parser": "^7.29.8", "tsx": "^4.23.15" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx scripts/build-log-catalog.ts",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/"
  }
}
