{
	"name": "@snoai/sqlite-crypto",
	"version": "1.0.0",
	"license": "Apache-2.0",
	"publishConfig": { "access": "public" },
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sno-ai/sno-station.git",
		"directory": "packages/sqlite-crypto"
	},
	"description": "Local AES-256 encryption for SNO Station Core SQLite databases.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md",
		"package.json"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"scripts": {
		"build": "npm --prefix ../utils run build && tsc -p tsconfig.json",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"test:unit": "vitest run --config vitest.config.ts ../../tests/packages/sqlite-crypto/unit",
		"test:integration": "vitest run --config vitest.config.ts ../../tests/packages/sqlite-crypto/integration",
		"test:e2e": "vitest run --config vitest.config.ts ../../tests/packages/sqlite-crypto/e2e --passWithNoTests",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@snoai/utils": "^1.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"better-sqlite3-multiple-ciphers": "^13.0.3",
		"tar-stream": "3.2.1"
	},
	"devDependencies": {
		"@types/node": "^22.19.17",
		"@types/tar-stream": "^3.1.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.5"
	}
}
