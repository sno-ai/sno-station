{
	"name": "@snoai/sno-station-core-crypto",
	"version": "0.2.0",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sno-ai/sno-station.git",
		"directory": "packages/sno-station-core-crypto"
	},
	"description": "Local AES-256 encryption for SNO Station Core SQLite databases. Single audit surface for DEK lifecycle, encrypted DB open, manifest, canary, file-fallback, passphrase wrap, and .sno-station-core export.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"sno-station-core": "./dist/cli/sno-station-core.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md",
		"package.json"
	],
	"engines": {
		"node": ">=22.14.0"
	},
	"scripts": {
		"build": "npm --prefix ../utils run build && tsc -p tsconfig.json",
		"prepack": "npm run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"test:unit": "vitest run --config vitest.config.ts ../../tests/packages/sno-station-core-crypto/unit",
		"test:integration": "vitest run --config vitest.config.ts ../../tests/packages/sno-station-core-crypto/integration",
		"test:e2e": "vitest run --config vitest.config.ts ../../tests/packages/sno-station-core-crypto/e2e --passWithNoTests",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@snoai/utils": "file:../utils",
		"@types/better-sqlite3": "^9.6.0",
		"@napi-rs/keyring": "^2.0.0",
		"argon2": "^0.45.1",
		"better-sqlite3-multiple-ciphers": "^13.0.3",
		"tar-stream": "3.2.0"
	},
	"devDependencies": {
		"@types/node": "^22.19.17",
		"@types/tar-stream": "^3.1.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.5"
	}
}
