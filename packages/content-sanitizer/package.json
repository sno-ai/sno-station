{
	"name": "@snoai/content-sanitizer",
	"version": "0.99.3",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sno-ai/sno-station.git",
		"directory": "packages/content-sanitizer"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"package.json"
	],
