{
	"name": "@snoai/sno-observe",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sno-ai/sno-station.git",
		"directory": "packages/sno-observe"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"LICENSE",
		"README.md",
		"package.json"
	],
	"scripts": {
		"build": "npm run build --workspace @snoai/common-core && tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"lint:no-hmac": "bash scripts/check-no-hmac.sh",
		"lint:no-bun-apis": "bash scripts/check-no-bun-apis.sh",
		"lint:deep-import-blocked": "node scripts/check-deep-import-blocked.mjs",
		"lint:guards": "npm run lint:no-hmac && npm run lint:no-bun-apis && npm run lint:deep-import-blocked",
		"test:unit": "npm run build && node --test ../../tests/packages/sno-observe/unit/*.test.mjs",
		"test:integration": "npm run build && node --test ../../tests/packages/sno-observe/integration/*.test.mjs",
		"test:all": "npm run build && node --test ../../tests/packages/sno-observe/**/*.test.mjs"
	},
	"dependencies": {
		"@snoai/utils": "file:../utils",
		"@snoai/common-core": "file:../common-core",
		"better-sqlite3": "^13.0.3",
		"js-tiktoken": "^1.0.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.0.0"
	},
	"engines": {
		"node": ">=22.14.0"
	}
}
