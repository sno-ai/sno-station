#!/usr/bin/env bash
# Read machine-wide work using Reach's existing work projection.
set -Eeuo pipefail
release="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PATH="$release/vendor/bin${PATH:+:$PATH}"
root="${SNO_REACH_ROOT:-$HOME/.local/state/sno-reach}"
[[ -d "$root" ]] || { printf 'reach: read squad work %s: inventory unavailable\n' "$root" >&2; exit 73; }
status=0
# One header read per message projects every work item (`state --all-work`), instead of a full mailbox scan per work.
rows=''
if rows="$("$release/lib/reach-main" state --json --all-work)"; then :
else
    status=$?
    printf 'reach: project squad work: state failed (%s); some work is incomplete\n' "$status" >&2
fi
if [[ -n "$rows" ]]; then
    printf '%s\n' "$rows" | jq -sc '
        # Rows arrive grouped by work in name order; a handoff links only cards of the same work. A transfer card names
        # the original card in its body text; an ordinary answer names it only in its headers (References).
        group_by(.work)[] | map(. + {owner:(.recipient // "unknown"), text:(.body | split("\n\n") | .[1:] | join("\n\n"))}) |
        . as $items |
        map(. as $original |
            [$items[] | select(.recipient != $original.recipient and (.text | contains($original.message_id)))] as $targets |
            if ($targets | length) == 1 then
                . + {handoff_to:$targets[0].recipient,handoff_sender:$targets[0].sender,handoff_message_id:$targets[0].message_id,
                    handoff_state:$targets[0].state,handoff_since:$targets[0].since,handoff_blocked_on:$targets[0].blocked_on}
            elif ($targets | length) > 1 then . + {owner:"unknown",handoff_error:"multiple linked handoff cards"}
            else . end) |
        . as $linked | .[] |
        select(. as $candidate | any($linked[]; . as $original |
            $candidate.recipient != $original.recipient and ($candidate.text | contains($original.message_id))) | not) |
        del(.body, .text)'
fi
exit "$status"
