#!/usr/bin/env bash
if [ "${BASH_VERSINFO[0]}" -lt 5 ]; then
    printf 'sno-reach: needs Bash 5 or newer on PATH as bash (this one is %s); install it and run again.\n' "$BASH_VERSION" >&2
    exit 69
fi
set -Eeuo pipefail
readonly REACH_STARTED="$EPOCHREALTIME"
readonly NOTIFICATION_DEADLINE=$((SECONDS + 150))

check_prerequisites() {
    local tool use available version missing=0
    for tool in realpath find stat sed sha256sum timeout flock jq; do
        available=yes
        case "$tool" in
            realpath) use='resolve file paths' ;;
            find) use='scan mailbox files' ;;
            stat) use='inspect file identity' ;;
            sed) use='edit message headers' ;;
            sha256sum) use='verify file digests' ;;
            timeout) use='bound command waits' ;;
            flock) use='lock shared state' ;;
            jq) use='read and write JSON' ;;
        esac
        if ! command -v "$tool" >/dev/null 2>&1; then
            available=no
        else
            case "$tool" in
                realpath) realpath -e -- / >/dev/null 2>&1 || available=no ;;
                find) find / -maxdepth 0 -printf '' >/dev/null 2>&1 || available=no ;;
                stat) stat -c %d / >/dev/null 2>&1 || available=no ;;
                sed|timeout)
                    version="$("$tool" --version 2>/dev/null)" || available=no
                    version="${version%%$'\n'*}"
                    if [[ "$tool" == sed ]]; then
                        [[ "$version" == *'GNU sed'* ]] || available=no
                    else
                        [[ "$version" == *'GNU coreutils'* ]] || available=no
                    fi ;;
            esac
        fi
        if [[ "$available" == no ]]; then
            printf 'sno-reach: needs %s — %s; install it and run again.\n' "$tool" "$use" >&2
            missing=$((missing + 1))
        fi
    done
    ((missing == 0)) || exit 69
}
check_prerequisites

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
readonly SCRIPT_DIR
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly REPO_ROOT
readonly ADDRESS_RE='^[a-z][a-z0-9-]{0,31}\.[a-z0-9][a-z0-9-]{0,63}@[a-z0-9][a-z0-9.-]{0,252}$'
readonly TOKEN_RE='^[^[:space:][:cntrl:]]+$'
readonly NAME_RE='^[^[:space:][:cntrl:]<>,]+$'
readonly MESSAGE_ID_RE='^<[^<>[:space:]]+>$'
readonly MACHINE_ID_RE='^[0-9a-f]{32}$'
readonly UPDATED_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
readonly LINTER="$REPO_ROOT/lib/reach-lint"
readonly DELIVER="$REPO_ROOT/lib/reach-deliver"
readonly REACHABILITY="$REPO_ROOT/lib/reach-reachability"
readonly SEND_RATE_LIMIT_DEFAULT_MAX=6
readonly SEND_RATE_LIMIT_DEFAULT_WINDOW_SECONDS=600
readonly -a SSH_OPTIONS=(
    -o BatchMode=yes
    -o ConnectTimeout=5
    -o StrictHostKeyChecking=yes
    -o ForwardAgent=no
)

export PATH="$REPO_ROOT/vendor/bin${PATH:+:$PATH}"
export LC_ALL=C

TEMP_DIR=''
STANDBY_HOLDER=''

cleanup() {
    local status=$?

    trap - EXIT HUP INT TERM
    if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
        rm -r -- "$TEMP_DIR" || {
            printf 'reach: failed to remove temporary directory: %s\n' \
                "$TEMP_DIR" >&2
            ((status == 0)) && status=74
        }
    fi
    if [[ -n "$STANDBY_HOLDER" && -f "$STANDBY_HOLDER" &&
          ! -L "$STANDBY_HOLDER" ]] &&
       [[ "$(<"$STANDBY_HOLDER")" == "$$" ]]; then
        rm -f -- "$STANDBY_HOLDER" || true
    fi
    exit "$status"
}

die() {
    local status="$1"
    shift

    printf 'reach: %s\n' "$*" >&2
    exit "$status"
}

usage() {
    printf 'usage: sno reach <verb> [options]\n'
    printf '%s\n' 'spawn register unregister seats call watch ring send reply inbox wait dismiss log state flush init rebind doctor export lint remind'
    if (($#)); then exit "$1"; else exit 64; fi
}

require_tools() {
    local tool missing=0

    for tool in "$@"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            printf 'sno-reach: needs %s — run this operation; install it and run again.\n' "$tool" >&2
            missing=$((missing + 1))
        fi
    done
    ((missing == 0)) || exit 69
}

validate_address() {
    local address="$1"

    [[ "$address" =~ $ADDRESS_RE ]] ||
        die 64 "invalid address: $address; rule=$ADDRESS_RE"
}

require_local_reader_address() {
    require_safe_caller_dir "$1" "$2" >/dev/null
}

validate_machine_id() {
    [[ "$1" =~ $MACHINE_ID_RE ]] ||
        die 64 'machine id must be 32 lowercase hexadecimal characters'
}

validate_updated() {
    [[ "$1" =~ $UPDATED_RE ]] ||
        die 64 'updated timestamp must be UTC RFC 3339 seconds'
}

utc_now() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

remote_program_literal() {
    # One identity implementation on both hosts, without assuming checkout paths.
    printf 'reach_machine_id() {\n'
    cat "$REPO_ROOT/lib/reach-machine-id"
    printf '\n}\n'
    cat <<'SNO_REACH_REMOTE_PROGRAM'
set -eu
LC_ALL=C
export LC_ALL

session_dir=''
delivery_tmp=''
card_tmp=''
card_lock=''

cleanup_remote() {
    remote_status=$?
    trap - EXIT HUP INT TERM
    [ -z "$delivery_tmp" ] || rm -f -- "$delivery_tmp" 2>/dev/null || true
    [ -z "$card_tmp" ] || rm -f -- "$card_tmp" 2>/dev/null || true
    if [ -n "$card_lock" ]; then
        rm -f -- "$card_lock/owner" 2>/dev/null || true
        rmdir -- "$card_lock" 2>/dev/null || true
    fi
    [ -z "$session_dir" ] || rm -rf -- "$session_dir" 2>/dev/null || true
    exit "$remote_status"
}

remote_error() {
    remote_status=$1
    remote_token=$2
    printf 'ERROR %s\n' "$remote_token" >&2
    exit "$remote_status"
}

trap cleanup_remote EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

session_dir=$(mktemp -d "${TMPDIR:-/tmp}/sno-reach-remote.XXXXXXXXXX") ||
    remote_error 74 IO
carriage_return=$(printf '\r')

canonical_count() {
    count_value=$1
    count_limit=$2
    case "$count_value" in
        0) ;;
        [1-9]*)
            case "$count_value" in
                *[!0-9]*) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
    [ "${#count_value}" -le "$count_limit" ]
}

read_frame() {
    expected_name=$1
    minimum_count=$2
    maximum_count=$3

    IFS= read -r frame_header || remote_error 64 PROTOCOL
    [ "${#frame_header}" -le 64 ] || remote_error 64 PROTOCOL
    case "$frame_header" in
        *"$carriage_return"*) remote_error 64 PROTOCOL ;;
    esac
    case "$frame_header" in
        "$expected_name "*) frame_count=${frame_header#"$expected_name "} ;;
        *) remote_error 64 PROTOCOL ;;
    esac
    canonical_count "$frame_count" 20 || remote_error 64 PROTOCOL
    [ "${#frame_count}" -le "${#maximum_count}" ] ||
        remote_error 64 PROTOCOL
    [ "$frame_count" -ge "$minimum_count" ] 2>/dev/null ||
        remote_error 64 PROTOCOL
    [ "$frame_count" -le "$maximum_count" ] 2>/dev/null ||
        remote_error 64 PROTOCOL

    frame_path="$session_dir/$expected_name"
    if ! dd bs=1 count="$frame_count" of="$frame_path" 2>/dev/null; then
        remote_error 64 PROTOCOL
    fi
    actual_count=$(wc -c <"$frame_path" | tr -d ' ')
    [ "$actual_count" = "$frame_count" ] || remote_error 64 PROTOCOL
    separator_path="$session_dir/separator"
    if ! dd bs=1 count=1 of="$separator_path" 2>/dev/null; then
        remote_error 64 PROTOCOL
    fi
    [ "$(wc -c <"$separator_path" | tr -d ' ')" = 1 ] ||
        remote_error 64 PROTOCOL
    [ "$(od -An -tu1 "$separator_path" | tr -d ' ')" = 10 ] ||
        remote_error 64 PROTOCOL
}

require_eof() {
    extra_path="$session_dir/extra"
    dd bs=1 count=1 of="$extra_path" 2>/dev/null || remote_error 64 PROTOCOL
    [ "$(wc -c <"$extra_path" | tr -d ' ')" = 0 ] ||
        remote_error 64 PROTOCOL
}

frame_text() {
    frame_name=$1
    cat "$session_dir/$frame_name"
}

valid_address() {
    printf '%s\n' "$1" |
        grep -Eq '^[a-z][a-z0-9-]{0,31}\.[a-z0-9][a-z0-9-]{0,63}@[a-z0-9][a-z0-9.-]{0,252}$'
}

valid_machine_id() {
    printf '%s\n' "$1" | grep -Eq '^[0-9a-f]{32}$'
}

valid_updated() {
    printf '%s\n' "$1" |
        grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
}

safe_root() {
    root_value=$1
    case "$root_value" in
        /*) ;;
        *) return 1 ;;
    esac
    case "$root_value" in
        *'/../'*|*'/./'*|*/..|*/.|*'//'*) return 1 ;;
    esac
    ! printf '%s' "$root_value" | grep -q '[[:cntrl:]]'
}

safe_target() {
    target_path=$1
    [ ! -L "$target_path" ] || remote_error 65 PATH-UNSAFE
}

safe_maildir() {
    target_path=$1
    safe_target "$target_path"
    [ -d "$target_path" ] || remote_error 65 PATH-UNSAFE
    for component_name in tmp new cur; do
        component_path=$target_path/$component_name
        [ -d "$component_path" ] && [ ! -L "$component_path" ] ||
            remote_error 65 PATH-UNSAFE
    done
    tmp_device=$(df -P "$target_path/tmp" | awk 'END { print $1 }') ||
        remote_error 74 IO
    new_device=$(df -P "$target_path/new" | awk 'END { print $1 }') ||
        remote_error 74 IO
    [ -n "$tmp_device" ] && [ "$tmp_device" = "$new_device" ] ||
        remote_error 74 CROSS-FILESYSTEM
}

release_card_lock() {
    [ -n "$card_lock" ] || return 0
    rm -f -- "$card_lock/owner" || remote_error 74 IO
    rmdir -- "$card_lock" || remote_error 74 IO
    card_lock=''
}

acquire_card_lock() {
    lock_path=$target_path/.card.lock
    lock_attempt=0

    while [ "$lock_attempt" -lt 2 ]; do
        if mkdir -- "$lock_path" 2>/dev/null; then
            card_lock=$lock_path
            printf '%s\n' "$$" >"$card_lock/owner" || remote_error 74 IO
            return 0
        fi
        [ -d "$lock_path" ] && [ ! -L "$lock_path" ] ||
            remote_error 65 PATH-UNSAFE
        owner_path=$lock_path/owner
        if [ ! -e "$owner_path" ] && [ ! -L "$owner_path" ]; then
            if rmdir -- "$lock_path" 2>/dev/null; then
                lock_attempt=$((lock_attempt + 1))
                continue
            fi
            remote_error 75 CARD-BUSY
        fi
        [ -f "$owner_path" ] && [ ! -L "$owner_path" ] ||
            remote_error 75 CARD-BUSY
        lock_owner=$(cat "$owner_path") || remote_error 75 CARD-BUSY
        case "$lock_owner" in
            ''|*[!0-9]*) remote_error 75 CARD-BUSY ;;
        esac
        if kill -0 "$lock_owner" 2>/dev/null; then
            remote_error 75 CARD-BUSY
        fi
        rm -f -- "$owner_path" || remote_error 75 CARD-BUSY
        rmdir -- "$lock_path" || remote_error 75 CARD-BUSY
        lock_attempt=$((lock_attempt + 1))
    done
    remote_error 75 CARD-BUSY
}


validate_card() {
    card_path_value=$1
    expected_address_value=$2
    [ -f "$card_path_value" ] && [ ! -L "$card_path_value" ] || remote_error 65 SEAT-INVALID
    command -v jq >/dev/null 2>&1 || remote_error 69 TOOL-UNAVAILABLE
    jq -e --arg address "$expected_address_value" '
      type == "object" and
      (keys == ["address","history","host","machine_id","name","owns","role","runtime","seat","supervisor","updated"]) and
      .address == $address and .role == ($address | split(".")[0]) and
      .seat == ($address | split("@")[0] | sub("^[^.]+\\."; "")) and
      .host == ($address | split("@")[1]) and
      (.machine_id | type == "string" and test("^[0-9a-f]{32}$")) and
      (.name | type == "string" and test("^[^[:space:][:cntrl:]<>,]+$")) and
      (.runtime | type == "string" and length > 0) and
      (.supervisor | type == "string" and test("^[a-z][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,63}@[a-z0-9][a-z0-9.-]{0,252}$")) and
      (.owns | type == "array") and (.history | type == "array") and
      (.updated | type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"))
    ' "$card_path_value" >/dev/null || remote_error 65 SEAT-INVALID
    card_machine=$(jq -r .machine_id "$card_path_value")
    card_name=$(jq -r .name "$card_path_value")
    card_runtime=$(jq -r .runtime "$card_path_value")
    card_supervisor=$(jq -r .supervisor "$card_path_value")
}

read_live_machine() {
    live_machine=$(reach_machine_id) || remote_error 74 IO
    valid_machine_id "$live_machine" || remote_error 65 MACHINE-MISMATCH
}

prepare_target() {
    root_value=$1
    address_value=$2
    safe_root "$root_value" || remote_error 65 PATH-UNSAFE
    valid_address "$address_value" || remote_error 64 INVALID-ADDRESS
    target_path=$root_value/$address_value
}


rebind_card() {
    machine_value=$1
    reason_value=$2
    updated_value=$3
    valid_machine_id "$machine_value" || remote_error 64 INVALID-ARGUMENT
    [ -n "$reason_value" ] && [ "${#reason_value}" -le 4096 ] ||
        remote_error 64 INVALID-ARGUMENT
    ! printf '%s' "$reason_value" | grep -q '[[:cntrl:]]' ||
        remote_error 64 INVALID-ARGUMENT
    valid_updated "$updated_value" || remote_error 64 INVALID-ARGUMENT
    read_live_machine
    [ "$machine_value" = "$live_machine" ] ||
        remote_error 65 MACHINE-MISMATCH
    safe_maildir "$target_path"
    acquire_card_lock
    card_path=$target_path/seat.json
    validate_card "$card_path" "$address_value"
    old_machine=$card_machine
    escaped_reason=$(printf '%s' "$reason_value" |
        sed 's/\\/\\\\/g; s/"/\\"/g') || remote_error 74 IO
    card_tmp=$(mktemp "$target_path/.card.rebind.XXXXXXXXXX") ||
        remote_error 74 IO
    REACH_REBIND_REASON="$escaped_reason" awk -v new_machine="$machine_value" -v old_machine="$old_machine" \
        -v changed="$updated_value" '
        BEGIN { reason = ENVIRON["REACH_REBIND_REASON"] }
        /^[[:space:]]*"machine_id"[[:space:]]*:/ {
            print "  \"machine_id\": \"" new_machine "\","
            next
        }
        /^[[:space:]]*"updated"[[:space:]]*:/ {
            print "  \"updated\": \"" changed "\","
            next
        }
        /^[[:space:]]*"history"[[:space:]]*:[[:space:]]*\[\][[:space:]]*$/ {
            print "  \"history\": ["
            print "    {\"machine_id\":\"" old_machine "\",\"replaced_at\":\"" changed "\",\"reason\":\"" reason "\"}"
            print "  ]"
            next
        }
        /^[[:space:]]*"history"[[:space:]]*:[[:space:]]*\[[[:space:]]*$/ {
            in_history = 1
            count = 0
            print
            next
        }
        in_history && /^[[:space:]]*\][[:space:]]*$/ {
            for (i = 1; i <= count; i++) {
                sub(/,[[:space:]]*$/, "", entries[i])
                print entries[i] ","
            }
            print "    {\"machine_id\":\"" old_machine "\",\"replaced_at\":\"" changed "\",\"reason\":\"" reason "\"}"
            print
            in_history = 0
            next
        }
        in_history {
            entries[++count] = $0
            next
        }
        { print }
        END { if (in_history) exit 1 }
    ' "$card_path" >"$card_tmp" || remote_error 74 IO
    validate_card "$card_tmp" "$address_value"
    mv -- "$card_tmp" "$card_path" || remote_error 74 IO
    card_tmp=''
    release_card_lock
    printf 'REBOUND\n'
}

IFS= read -r protocol_line || remote_error 64 PROTOCOL
[ "$protocol_line" = 'SNO-REACH-REMOTE/1' ] || remote_error 64 PROTOCOL
IFS= read -r operation || remote_error 64 PROTOCOL

case "$operation" in
    DELIVER)
        read_frame root 1 4096
        root_value=$(frame_text root)
        read_frame address 1 255
        address_value=$(frame_text address)
        read_frame basename 1 255
        basename_value=$(frame_text basename)
        IFS= read -r body_header || remote_error 64 PROTOCOL
        [ "${#body_header}" -le 64 ] || remote_error 64 PROTOCOL
        case "$body_header" in
            'body '*) body_count=${body_header#body } ;;
            *) remote_error 64 PROTOCOL ;;
        esac
        canonical_count "$body_count" 20 || remote_error 64 PROTOCOL
        prepare_target "$root_value" "$address_value"
        case "$basename_value" in
            ''|.|..|*/*|*[!A-Za-z0-9._-]*)
                remote_error 64 INVALID-BASENAME
                ;;
        esac
        safe_maildir "$target_path"
        card_path=$target_path/seat.json
        validate_card "$card_path" "$address_value"
        read_live_machine
        [ "$card_machine" = "$live_machine" ] ||
            remote_error 65 \
                "MACHINE-MISMATCH:card=${card_machine}:live=${live_machine}"
        delivery_tmp=$(mktemp "$target_path/tmp/reach-remote.XXXXXXXXXX") ||
            remote_error 74 IO
        printf 'READY %s %s\n' "$$" "$basename_value"
        if ! cat >"$delivery_tmp"; then
            remote_error 74 IO
        fi
        actual_count=$(wc -c <"$delivery_tmp" | tr -d ' ')
        [ "$actual_count" = "$body_count" ] ||
            remote_error 74 SHORT-BODY
        no_reply_value=$(sed -n '
            /^[[:space:]]*$/q
            s/\r$//
            /^[Xx]-[Nn][Oo]-[Rr][Ee][Pp][Ll][Yy]:[[:space:]]*true[[:space:]]*$/ {
                p
                q
            }
        ' "$delivery_tmp") || remote_error 74 IO
        if [ -n "$no_reply_value" ]; then
            destination_path=$target_path/cur/$basename_value:2,R
        else
            destination_path=$target_path/new/$basename_value
        fi
        if [ -e "$destination_path" ] || [ -L "$destination_path" ]; then
            [ -f "$destination_path" ] && [ ! -L "$destination_path" ] ||
                remote_error 74 DESTINATION-CONFLICT
            cmp -s "$delivery_tmp" "$destination_path" ||
                remote_error 74 DESTINATION-CONFLICT
            rm -f -- "$delivery_tmp" || remote_error 74 IO
            delivery_tmp=''
            printf 'ALREADY\n'
        else
            ln -- "$delivery_tmp" "$destination_path" ||
                remote_error 74 IO
            cmp -s "$delivery_tmp" "$destination_path" ||
                remote_error 74 IO
            rm -f -- "$delivery_tmp" || remote_error 74 IO
            delivery_tmp=''
            printf 'PLACED\n'
        fi
        ;;
    INIT)
        read_frame root 1 4096
        root_value=$(frame_text root)
        read_frame address 1 255
        address_value=$(frame_text address)
        read_frame machine-id 32 32
        machine_value=$(frame_text machine-id)
        read_frame card 1 65536
        requested_card=$session_dir/card
        require_eof
        prepare_target "$root_value" "$address_value"
        valid_machine_id "$machine_value" ||
            remote_error 64 INVALID-ARGUMENT
        validate_card "$requested_card" "$address_value"
        [ "$card_machine" = "$machine_value" ] ||
            remote_error 65 CARD-CONFLICT
        grep -Eq '^[[:space:]]*"history"[[:space:]]*:[[:space:]]*\[\][[:space:]]*$' \
            "$requested_card" || remote_error 65 CARD-CONFLICT
        read_live_machine
        [ "$machine_value" = "$live_machine" ] ||
            remote_error 65 MACHINE-MISMATCH
        if [ -e "$root_value" ] || [ -L "$root_value" ]; then
            [ -d "$root_value" ] && [ ! -L "$root_value" ] ||
                remote_error 65 PATH-UNSAFE
        else
            mkdir -p -- "$root_value" || remote_error 74 IO
        fi
        safe_target "$target_path"
        if [ ! -e "$target_path" ]; then
            mkdir -- "$target_path" || remote_error 74 IO
        fi
        [ -d "$target_path" ] && [ ! -L "$target_path" ] ||
            remote_error 65 PATH-UNSAFE
        for component_name in tmp new cur; do
            component_path=$target_path/$component_name
            if [ -e "$component_path" ] || [ -L "$component_path" ]; then
                [ -d "$component_path" ] && [ ! -L "$component_path" ] ||
                    remote_error 65 PATH-UNSAFE
            else
                mkdir -- "$component_path" || remote_error 74 IO
            fi
        done
        safe_maildir "$target_path"
        acquire_card_lock
        card_path=$target_path/seat.json
        if [ -e "$card_path" ] || [ -L "$card_path" ]; then
            validate_card "$card_path" "$address_value"
            stored_identity=$(jq -cS '{address,name,machine_id}' "$card_path") || remote_error 65 SEAT-INVALID
            requested_identity=$(jq -cS '{address,name,machine_id}' "$requested_card") || remote_error 65 SEAT-INVALID
            [ "$stored_identity" = "$requested_identity" ] || remote_error 65 SEAT-CONFLICT
            init_result=INIT-UNCHANGED
        else
            card_tmp=$(mktemp "$target_path/.card.init.XXXXXXXXXX") ||
                remote_error 74 IO
            cp -- "$requested_card" "$card_tmp" || remote_error 74 IO
            mv -- "$card_tmp" "$card_path" || remote_error 74 IO
            card_tmp=''
            init_result=INIT-CREATED
        fi
        release_card_lock
        printf '%s\n' "$init_result"
        ;;
    REBIND)
        read_frame root 1 4096
        root_value=$(frame_text root)
        read_frame address 1 255
        address_value=$(frame_text address)
        read_frame machine-id 32 32
        machine_value=$(frame_text machine-id)
        read_frame reason 1 4096
        reason_value=$(frame_text reason)
        read_frame updated 20 20
        updated_value=$(frame_text updated)
        require_eof
        prepare_target "$root_value" "$address_value"
        rebind_card "$machine_value" "$reason_value" "$updated_value"
        ;;
    DOCTOR|PREFLIGHT)
        read_frame root 1 4096
        root_value=$(frame_text root)
        read_frame address 1 255
        address_value=$(frame_text address)
        require_eof
        prepare_target "$root_value" "$address_value"
        safe_maildir "$target_path"
        card_path=$target_path/seat.json
        validate_card "$card_path" "$address_value"
        read_live_machine
        [ "$card_machine" = "$live_machine" ] ||
            remote_error 65 MACHINE-MISMATCH
        if [ "$operation" = PREFLIGHT ]; then
            [ -f "$target_path/reachable.json" ] && [ ! -L "$target_path/reachable.json" ] || remote_error 65 REGISTER-FIRST
            jq -e --arg address "$address_value" '.address == $address and (.channel == "acp" or .channel == "tmux" or .channel == "orca") and (.handle | type == "string" and length > 0)' "$target_path/reachable.json" >/dev/null || remote_error 65 REACHABILITY-INVALID
        fi
        printf 'DOCTOR-OK\n'
        ;;
    RING)
        read_frame root 1 4096
        root_value=$(frame_text root)
        read_frame address 1 255
        address_value=$(frame_text address)
        read_frame sender 1 255
        sender_value=$(frame_text sender)
        require_eof
        prepare_target "$root_value" "$address_value"
        valid_address "$sender_value" || remote_error 64 INVALID-ADDRESS
        reach_program=${HOME-}/.local/bin/sno-reach
        [ -x "$reach_program" ] || remote_error 69 TOOL-UNAVAILABLE
        ring_outcome=$(SNO_REACH_ROOT=$root_value SNO_REACH_ADDR=$sender_value \
            "$reach_program" ring "$address_value" 2>/dev/null) || remote_error 75 RING-FAILED
        printf '%s\n' "$ring_outcome"
        ;;
    *)
        remote_error 64 PROTOCOL
        ;;
esac
SNO_REACH_REMOTE_PROGRAM
}

mailbox_root() {
    if [[ -n "${SNO_REACH_ROOT:-}" ]]; then
        printf '%s\n' "$SNO_REACH_ROOT"
    elif [[ -n "${HOME:-}" ]]; then
        printf '%s\n' "$HOME/.local/state/sno-reach"
    else
        die 78 'SNO_REACH_ROOT is unset and HOME is unavailable'
    fi
}




require_maildir() {
    local maildir="$1"
    local component

    for component in tmp new cur; do
        [[ -d "$maildir/$component" ]] ||
            die 73 "caller Maildir component is unavailable: $maildir/$component"
    done
}

make_temp_dir() {
    [[ -z "$TEMP_DIR" ]] ||
        die 74 'internal temporary directory was requested twice'
    TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/reach.XXXXXXXXXX")" ||
        die 74 'could not create a private temporary directory'
}

parse_as_only() {
    CALLER=''
    while (($# > 0)); do
        case "$1" in
            --as)
                (($# >= 2)) || usage
                [[ -z "$CALLER" ]] || die 64 '--as appears more than once'
                [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2"
                shift 2
                ;;
            *)
                die 64 "unknown option: $1"
                ;;
        esac
    done
    [[ -n "$CALLER" ]] || CALLER="${SNO_REACH_ADDR:-}"
    [[ -n "$CALLER" ]] || die 64 '--as is required'
    validate_address "$CALLER"
}

parse_flush_options() {
    CALLER=''
    FLUSH_ENTRY="${SNO_REACH_OUTBOX_ENTRY:-}"
    while (($# > 0)); do
        case "$1" in
            --as)
                (($# >= 2)) || usage
                [[ -z "$CALLER" ]] || die 64 '--as appears more than once'
                [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2"
                shift 2
                ;;
            *)
                die 64 "unknown option: $1"
                ;;
        esac
    done
    [[ -n "$CALLER" ]] || CALLER="${SNO_REACH_ADDR:-}"
    [[ -n "$CALLER" ]] || die 64 '--as is required'
    validate_address "$CALLER"
}

parse_poll_options() {
    CALLER='' REPLY_TO='' EXPECTED_FROM='' TIMEOUT_SECS='' INTERVAL_SECS=5 IDLE_SECS=''
    local option value
    local -A used=()
    while (($#)); do
        (($# >= 2)) || usage
        option="$1" value="$2"
        [[ -z "${used[$option]:-}" ]] || die 64 "duplicate option: $option"
        used["$option"]=1
        case "$option" in
            --as) [[ -n "$value" ]] || die 64 '--as must not be blank'; CALLER="$value" ;;
            --reply-to) REPLY_TO="$value"; [[ "$value" =~ $MESSAGE_ID_RE ]] || die 64 '--reply-to requires a Message-ID' ;;
            --from) EXPECTED_FROM="$value"; validate_address "$value" ;;
            --timeout|--every|--idle)
                [[ "$value" =~ ^[0-9]{1,8}$ ]] || die 64 "$option requires integer seconds"
                value="$((10#$value))"
                case "$option" in
                    --timeout) ((value <= 280)) || die 64 '--timeout must not exceed 280 seconds'; TIMEOUT_SECS="$value" ;;
                    --every) ((value > 0)) || die 64 '--every must be positive'; INTERVAL_SECS="$value" ;;
                    --idle) ((value <= 280)) || die 64 '--idle must not exceed 280 seconds'; IDLE_SECS="$value" ;;
                esac ;;
            *) die 64 "unknown wait option: $option" ;;
        esac
        shift 2
    done
    [[ -n "$CALLER" ]] || CALLER="${SNO_REACH_ADDR:-}"
    validate_address "$CALLER"
    [[ -n "$TIMEOUT_SECS" ]] || die 64 '--timeout is required'
}

parse_reply_options() {
    CALLER='' MESSAGE='' REPLY_STATE='' REASON=''
    local option
    local -A used=()
    while (($#)); do
        (($# >= 2)) || usage
        option="$1"
        [[ -z "${used[$option]:-}" ]] || die 64 "duplicate option: $option"
        used["$option"]=1
        case "$option" in
            --as) [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2" ;;
            --card) MESSAGE="$2" ;;
            --state)
                case "$2" in accepted|completed|failed|cancelled|refused) REPLY_STATE="$2" ;; *) die 64 'invalid reply --state' ;; esac ;;
            --reason) REASON="$2"; [[ -n "$REASON" && "$REASON" != *[$'\001'-$'\037'$'\177']* ]] || die 64 'invalid --reason' ;;
            *) die 64 "unknown reply option: $option" ;;
        esac
        shift 2
    done
    [[ -n "$CALLER" ]] || CALLER="${SNO_REACH_ADDR:-}"
    validate_address "$CALLER"
    [[ -n "$MESSAGE" ]] || die 64 '--card is required'
}

parse_dismiss_options() {
    CALLER='' MESSAGE='' REASON=''
    local -A used=()
    while (($#)); do
        (($# >= 2)) || usage
        [[ -z "${used[$1]:-}" ]] || die 64 "duplicate option: $1"
        used["$1"]=1
        case "$1" in --as) [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2" ;; --card) MESSAGE="$2" ;; --reason) REASON="$2" ;; *) die 64 "unknown dismiss option: $1" ;; esac
        shift 2
    done
    [[ -n "$CALLER" ]] || CALLER="${SNO_REACH_ADDR:-}"
    validate_address "$CALLER"
    [[ -n "$MESSAGE" && -n "$REASON" && "$REASON" != *[$'\001'-$'\037'$'\177']* ]] || die 64 'dismiss requires --card and a printable --reason'
}

json_escape() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

write_card() {
    local output_file="$1"
    local address="$2"
    local machine_id="$3"
    local name="$4"
    local runtime="$5"
    local supervisor="$6"
    shift 6
    local role="${address%%.*}"
    local tail="${address#*.}"
    local seat="${tail%%@*}"
    local host="${address##*@}"
    local updated
    local value
    local separator=''

    updated="$(utc_now)"
    {
        printf '{\n'
        printf '  "address": "%s",\n' "$(json_escape "$address")"
        printf '  "role": "%s",\n' "$(json_escape "$role")"
        printf '  "seat": "%s",\n' "$(json_escape "$seat")"
        printf '  "host": "%s",\n' "$(json_escape "$host")"
        printf '  "machine_id": "%s",\n' "$machine_id"
        printf '  "name": "%s",\n' "$(json_escape "$name")"
        printf '  "runtime": "%s",\n' "$(json_escape "$runtime")"
        printf '  "owns": ['
        for value in "$@"; do
            printf '%s"%s"' "$separator" "$(json_escape "$value")"
            separator=', '
        done
        printf '],\n'
        printf '  "supervisor": "%s",\n' "$(json_escape "$supervisor")"
        printf '  "updated": "%s",\n' "$updated"
        printf '  "history": []\n'
        printf '}\n'
    } >"$output_file" ||
        die 74 'could not render canonical agent card'
}

append_text_frame() {
    local output_file="$1"
    local name="$2"
    local value="$3"

    printf '%s %s\n%s\n' "$name" "${#value}" "$value" >>"$output_file" ||
        die 74 "could not write remote $name frame"
}

append_file_frame() {
    local output_file="$1"
    local name="$2"
    local input_file="$3"
    local size

    size="$(wc -c <"$input_file" | tr -d ' ')"
    printf '%s %s\n' "$name" "$size" >>"$output_file" ||
        die 74 "could not write remote $name header"
    cat "$input_file" >>"$output_file" ||
        die 74 "could not write remote $name payload"
    printf '\n' >>"$output_file" ||
        die 74 "could not terminate remote $name frame"
}

execute_fixed_request() {
    local wire_file="$1"
    local address="$2"
    local expected_re="$3"
    local host="${address##*@}"
    local local_host
    local literal
    local output_file="$TEMP_DIR/remote.output"
    local error_file="$TEMP_DIR/remote.stderr"
    local request_status
    local -a output_lines=() deadline=()
    [[ -z "${4:-}" ]] || deadline=(timeout --foreground --signal=TERM --kill-after=5 "$4")

    local_host="$(hostname)" ||
        die 74 'could not determine the local host'
    literal="$(remote_program_literal)"
    set +e
    if [[ "$host" == "$local_host" ]]; then
        "${deadline[@]}" /bin/sh -c "$literal" <"$wire_file" \
            >"$output_file" 2>"$error_file"
        request_status=$?
    else
        # Fixed receiver program is the remote command.
        # shellcheck disable=SC2029
        "${deadline[@]}" ssh "${SSH_OPTIONS[@]}" "$host" "$literal" <"$wire_file" \
            >"$output_file" 2>"$error_file"
        request_status=$?
    fi
    set -e
    if ((request_status != 0)); then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        return "$request_status"
    fi
    [[ ! -s "$error_file" ]] || {
        cat "$error_file" >&2
        return 74
    }
    mapfile -t output_lines <"$output_file"
    if ((${#output_lines[@]} != 1)) ||
       [[ ! "${output_lines[0]}" =~ $expected_re ]]; then
        printf 'reach: fixed receiver returned invalid success output\n' >&2
        return 74
    fi
    printf '%s\n' "${output_lines[0]}"
}

parse_init_options() {
    CALLER='' NAME='' OWNS=() RUNTIME=unbound
    while (($#)); do
        case "$1" in
            --as) (($# >= 2)) || usage; [[ -z "$CALLER" ]] || die 64 'duplicate --as'; [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2"; shift 2 ;;
            --name) (($# >= 2)) || usage; [[ -z "$NAME" ]] || die 64 'duplicate --name'; NAME="$2"; shift 2 ;;
            *) die 64 "unknown init option: $1" ;;
        esac
    done
    [[ -n "$CALLER" ]] || CALLER="$(printenv SNO_REACH_ADDR || true)"
    validate_address "$CALLER"
    [[ "$NAME" =~ $NAME_RE ]] || die 64 '--name must be one display-safe token'
    MACHINE_ID="$("$REPO_ROOT/lib/reach-machine-id")" || die 74 'machine identity is unavailable'
    validate_machine_id "$MACHINE_ID"
    SUPERVISOR="$CALLER"
}


parse_rebind_options() {
    CALLER='' REASON=''
    while (($#)); do
        case "$1" in
            --as) (($# >= 2)) || usage; [[ -z "$CALLER" ]] || die 64 'duplicate --as'; [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2"; shift 2 ;;
            --reason) (($# >= 2)) || usage; [[ -z "$REASON" ]] || die 64 'duplicate --reason'; REASON="$2"; shift 2 ;;
            *) die 64 "unknown rebind option: $1" ;;
        esac
    done
    [[ -n "$CALLER" ]] || CALLER="$(printenv SNO_REACH_ADDR || true)"
    validate_address "$CALLER"
    [[ -n "$REASON" && "$REASON" != *[$'\001'-$'\037'$'\177']* ]] || die 64 '--reason requires printable text'
    MACHINE_ID="$("$REPO_ROOT/lib/reach-machine-id")" || die 74 'machine identity is unavailable'
    validate_machine_id "$MACHINE_ID"
}

run_init() {
    local root
    local wire_file
    local card_file
    local request_status

    parse_init_options "$@"
    root="$(mailbox_root)"
    make_temp_dir
    wire_file="$TEMP_DIR/init.wire"
    card_file="$TEMP_DIR/seat.json"
    write_card "$card_file" "$CALLER" "$MACHINE_ID" "$NAME" \
        "$RUNTIME" "$SUPERVISOR" "${OWNS[@]}"
    printf 'SNO-REACH-REMOTE/1\nINIT\n' >"$wire_file"
    append_text_frame "$wire_file" root "$root"
    append_text_frame "$wire_file" address "$CALLER"
    append_text_frame "$wire_file" machine-id "$MACHINE_ID"
    append_file_frame "$wire_file" card "$card_file"
    set +e
    execute_fixed_request "$wire_file" "$CALLER" \
        '^(INIT-CREATED|INIT-UNCHANGED)$'
    request_status=$?
    set -e
    exit "$request_status"
}


run_rebind() {
    local root
    local wire_file
    local updated
    local request_status

    parse_rebind_options "$@"
    root="$(mailbox_root)"
    updated="$(utc_now)"
    validate_updated "$updated"
    make_temp_dir
    wire_file="$TEMP_DIR/rebind.wire"
    printf 'SNO-REACH-REMOTE/1\nREBIND\n' >"$wire_file"
    append_text_frame "$wire_file" root "$root"
    append_text_frame "$wire_file" address "$CALLER"
    append_text_frame "$wire_file" machine-id "$MACHINE_ID"
    append_text_frame "$wire_file" reason "$REASON"
    append_text_frame "$wire_file" updated "$updated"
    set +e
    execute_fixed_request "$wire_file" "$CALLER" '^REBOUND$'
    request_status=$?
    set -e
    exit "$request_status"
}

run_doctor() {
    local root state config machine
    parse_as_only "$@"
    root="$(mailbox_root)"
    if [[ -n "$(printenv SNO_MBOX_ROOT || true)" || -n "$(printenv SNO_EXECUTOR_ADDR || true)" ]]; then
        printf 'reach: warning: SNO_MBOX_ROOT and SNO_EXECUTOR_ADDR are ignored; use SNO_REACH_ROOT and SNO_REACH_ADDR\n' >&2
    fi
    [[ ! -d "$HOME/.local/state/agent-mbox" ]] ||
        printf 'reach: legacy state present, not read\n' >&2
    require_safe_caller_dir "$root" "$CALLER" >/dev/null
    [[ -f "$root/$CALLER/seat.json" && ! -L "$root/$CALLER/seat.json" ]] ||
        die 65 "seat.json is unavailable: $root/$CALLER/seat.json"
    machine="$("$REPO_ROOT/lib/reach-machine-id")" || die 74 'machine identity is unavailable'
    jq -e --arg address "$CALLER" --arg machine "$machine" '
        .address == $address and .machine_id == $machine and
        (.name | type == "string" and length > 0) and (.owns | type == "array")
    ' "$root/$CALLER/seat.json" >/dev/null || die 65 "seat.json identity mismatch: $CALLER"
    state="$("$REACHABILITY" status --root "$root" --as "$CALLER")"
    case "$state" in
        present$'\t'*) ;;
        *) die 65 "registration missing or stale for $CALLER; run sno reach register --as $CALLER --channel <channel> --handle <locator>" ;;
    esac
    config="$HOME/.config/sno-reach/agents.json"
    "$REPO_ROOT/lib/reach-transport" for-kind codex >/dev/null
    if [[ -f "$config" ]] && jq -e 'length > 0' "$config" >/dev/null; then
        command -v acpx >/dev/null || die 69 "acpx is required by $config"
    fi
    printf 'prerequisites: ok\nDOCTOR-OK\n'
}

observe_append() {
    local root="$1" status detail
    shift
    (
        trap - EXIT
        if timeout --foreground --signal=TERM --kill-after=1 5 sno observe append "$@"; then
            exit 0
        else
            status=$?
        fi
        detail="sno observe append $1 failed (exit $status); event not recorded"
        ((status != 127)) || detail="sno: not found; $1 event not recorded"
        { printf '%s\n' "$detail" >>"$root/reach.log"; } 2>/dev/null || true
    ) </dev/null >/dev/null 2>&1
}

observe_harness() {
    local root="$1" address="$2" default="$3"
    if [[ -f "$root/$address/reachable.json" ]]; then
        jq -r --arg default "$default" '.harness // $default' "$root/$address/reachable.json" 2>/dev/null
    else
        printf '%s\n' "$default"
    fi
}

observe_message() {
    local root="$1" kind="$2" caller="$3" callee="$4" status="$5" started="$6"
    local ended="$EPOCHREALTIME" from=codex to outcome="${7:-}" receipt="${8:-}" elapsed
    local -a fields=()
    [[ ! -v CLAUDECODE ]] || from=claude-code
    if ! from="$(observe_harness "$root" "$caller" "$from")" ||
       ! to="$(observe_harness "$root" "$callee" unknown)"; then
        { printf 'reach.message %s: cannot read harness; event not recorded\n' "$kind" >>"$root/reach.log"; } 2>/dev/null || true
        return 0
    fi
    if [[ -z "$outcome" ]]; then
        case "$status" in 0) outcome=ok ;; 4|124|137) outcome=timeout ;; *) outcome=refused ;; esac
    fi
    [[ -z "$receipt" ]] || fields+=("--receipt=$receipt")
    elapsed=$(( (${ended/./} - ${started/./}) / 1000 ))
    observe_append "$root" reach.message "--agent=$from" "--kind=$kind" "--from_harness=$from" \
        "--to_harness=$to" "--outcome=$outcome" "--latency_ms=$elapsed" "${fields[@]}"
}

run_register() {
    local root channel='' handle='' pane session server identity kind harness=codex recorded
    [[ ! -v CLAUDECODE ]] || harness=claude-code
    CALLER=''
    while (($#)); do
        case "$1" in
            --as) (($# >= 2)) || usage; [[ -z "$CALLER" ]] || die 64 'duplicate --as'; [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2"; shift 2 ;;
            --channel) (($# >= 2)) || usage; [[ -z "$channel" ]] || die 64 'duplicate --channel'; channel="$2"; shift 2 ;;
            --handle) (($# >= 2)) || usage; [[ -z "$handle" ]] || die 64 'duplicate --handle'; [[ -n "$2" ]] || die 64 '--handle must not be blank'; handle="$2"; shift 2 ;;
            *) die 64 "unknown register option: $1" ;;
        esac
    done
    [[ -n "$CALLER" ]] || CALLER="$(printenv SNO_REACH_ADDR || true)"
    validate_address "$CALLER"
    root="$(mailbox_root)"
    require_safe_caller_dir "$root" "$CALLER" >/dev/null
    if [[ -n "${SNO_REACH_HARNESS:-}" ]]; then
        harness="$SNO_REACH_HARNESS"
    elif recorded="$(observe_harness "$root" "$CALLER" "$harness")"; then
        harness="$recorded"
    fi
    case "$channel" in
        tmux)
            pane="$(timeout --foreground 5 tmux display-message -pt "$handle" '#{pane_id}')" || die 65 "tmux handle is unavailable: $handle"
            [[ "$pane" =~ ^%[0-9]+$ ]] || die 65 'tmux pane identity is invalid'
            session="$(timeout --foreground 5 tmux display-message -pt "$pane" '#S')"
            server="$(timeout --foreground 5 tmux display-message -pt "$pane" '#{socket_path}#{pid}')" || die 65 'tmux server is unavailable'
            server="$(printf '%s\t%s\n' "$(tmux display-message -pt "$pane" '#{socket_path}')" "$(tmux display-message -pt "$pane" '#{pid}')" | sha256sum | cut -d ' ' -f1)"
            handle="tmux-$server:$session"
            identity="$pane" kind=tmux-pane
            timeout --foreground 5 tmux set-option -pt "$pane" @sno_reach_address "$CALLER"
            timeout --foreground 5 tmux set-option -pt "$pane" @sno_reach_root "$root"
            ;;
        acp)
            [[ "$handle" =~ ^acp-([a-zA-Z0-9][a-zA-Z0-9_-]*):(/[^:[:cntrl:]]*):([^:[:space:]]+)$ ]] || die 64 'ACP handle must be acp-agent:/absolute/cwd:session'
            identity="$(printf '%s' "$handle" | cut -d : -f3)" kind=acp-session
            ;;
        orca)
            local orca inventory
            orca="$(command -v orca-ide || command -v orca)" || die 69 'Orca command unavailable'
            [[ "$orca" != /usr/bin/orca ]] || die 69 'Orca terminal command unavailable'
            inventory="$(timeout --foreground 20 "$orca" terminal list --json)" || die 65 'Orca inventory failed'
            identity="$(jq -er --arg handle "$handle" '[.result.terminals[]? | select(.connected == true and .handle == $handle)] | select(length == 1) | .[0].tabId' <<<"$inventory")" || die 65 'Orca handle is not uniquely connected'
            kind='orca-tab' ;;
        *) die 64 '--channel must be acp, tmux or orca' ;;
    esac
    "$REACHABILITY" register --root "$root" --as "$CALLER" --channel "$channel" --handle "$handle" --identity-kind "$kind" --identity "$identity" --harness "$harness"
    observe_append "$root" reach.register "--agent=$harness" "--harness=$harness" --action=register
}

run_unregister() {
    local root harness=codex
    parse_as_only "$@"
    root="$(mailbox_root)"
    require_safe_caller_dir "$root" "$CALLER" >/dev/null
    [[ ! -v CLAUDECODE ]] || harness=claude-code
    harness="$(observe_harness "$root" "$CALLER" "$harness")" || true
    "$REACHABILITY" unregister --root "$root" --as "$CALLER"
    observe_append "$root" reach.register "--agent=$harness" "--harness=$harness" --action=unregister
}

extract_recipients() {
    local message="$1"
    local output_file="$2"
    local raw_file="$TEMP_DIR/recipients.raw"
    local recipient
    local -A seen=()
    local count=0

    if ! maddr -a -h to:cc:bcc: "$message" >"$raw_file"; then
        die 65 'could not extract To, Cc, and Bcc recipients'
    fi
    : >"$output_file"
    while IFS= read -r recipient; do
        [[ "$recipient" =~ $ADDRESS_RE ]] ||
            die 65 "invalid recipient address: $recipient"
        if [[ -z "${seen[$recipient]+present}" ]]; then
            seen["$recipient"]=1
            printf '%s\n' "$recipient" >>"$output_file" ||
                die 74 'could not write validated recipient list'
            ((count += 1))
        fi
    done <"$raw_file"
    ((count > 0)) || die 65 'message has no To, Cc, or Bcc recipients'
}

print_corrected_send_command() {
    local correction="$1"
    local delay_seconds="${2:-0}"
    local maximum="${3:-}"
    local window="${4:-}"

    if ((delay_seconds > 0)); then
        printf 'reach: corrected command: sleep %q; SNO_REACH_RATE_LIMIT_MAX=%q SNO_REACH_RATE_LIMIT_WINDOW_SECONDS=%q %q send --as %q < message.eml\n' \
            "$delay_seconds" "$maximum" "$window" "$REPO_ROOT/bin/sno-reach" \
            "$CALLER" >&2
    else
        printf 'reach: corrected command: %s, then run: %q send --as %q < corrected-message.eml\n' \
            "$correction" "$REPO_ROOT/bin/sno-reach" "$CALLER" >&2
    fi
}

# A card whose body is blank is delivered, counted, and unactionable: the
# recipient sees a subject and nothing to answer. Refuse it at the door rather
# than in the linter, which also runs over messages already staged in an outbox.
message_body_has_content() {
    local message="$1"

    awk '
        seen { if ($0 ~ /[^[:space:]]/) { found = 1; exit } next }
        $0 == "" || $0 == "\r" { seen = 1 }
        END { exit(found ? 0 : 1) }
    ' "$message"
}

preflight_send_headers() {
    local message="$1"
    local message_type="$2"
    local header_status
    local to_file="$TEMP_DIR/send-to-recipients"

    if ! message_body_has_content "$message"; then
        printf '%s\n' \
            'reach: message body is empty; a card with no body gives the recipient nothing to act on' \
            >&2
        print_corrected_send_command 'write the card body below the blank line'
        return 65
    fi

    set +e
    mhdr -h x-no-reply "$message" >/dev/null 2>&1
    header_status=$?
    set -e
    if ((header_status == 0)) && [[ "$message_type" == question ]]; then
        printf '%s\n' \
            'reach: X-No-Reply is invalid for X-Type: question; a question owes an answer' \
            >&2
        print_corrected_send_command 'remove X-No-Reply'
        return 65
    fi
    ((header_status == 0 || header_status == 1)) ||
        die 74 'could not inspect validated X-No-Reply header'

    case "$message_type" in
        info)
            if ! maddr -a -h to: "$message" >"$to_file"; then
                die 65 'could not inspect To recipients for send policy'
            fi
            if [[ -s "$to_file" ]]; then
                printf '%s\n' \
                    'reach: X-Type: info must not address a To recipient; move every informational recipient to Cc' \
                    >&2
                print_corrected_send_command 'move every To recipient to Cc'
                return 65
            fi
            ;;
        answer)
            if ! maddr -a -h to: "$message" >"$to_file"; then
                die 65 'could not inspect To recipients for send policy'
            fi
            if [[ ! -s "$to_file" ]]; then
                printf '%s\n' \
                    'reach: X-Type: answer requires a To recipient; move the answering recipient from Cc to To' \
                    >&2
                print_corrected_send_command \
                    'move the answering recipient from Cc to To'
                return 65
            fi
            ;;
    esac
}

validate_rate_limit_value() {
    local name="$1"
    local value="$2"

    [[ "$value" =~ ^[1-9][0-9]{0,8}$ ]] ||
        die 64 "$name must be an integer from 1 through 999999999"
}

preflight_send_rate_limit() {
    local root="$1"
    local message="$2"
    local message_type="$3"
    local maximum="${SNO_REACH_RATE_LIMIT_MAX:-$SEND_RATE_LIMIT_DEFAULT_MAX}"
    local window="${SNO_REACH_RATE_LIMIT_WINDOW_SECONDS:-$SEND_RATE_LIMIT_DEFAULT_WINDOW_SECONDS}"
    local caller_dir
    local state_root
    local lock_path
    local lock_fd
    local recipients_file="$TEMP_DIR/rate-limit-recipients"
    local recipient
    local bucket
    local marker
    local basename
    local marker_epoch
    local now
    local cutoff
    local count
    local oldest
    local retry_after
    local message_id
    local marker_path
    local -a recipients=()
    local -a created=()
    local -a expired=()

    [[ "$message_type" != question ]] || return 0
    validate_rate_limit_value SNO_REACH_RATE_LIMIT_MAX "$maximum"
    validate_rate_limit_value SNO_REACH_RATE_LIMIT_WINDOW_SECONDS "$window"
    caller_dir="$(require_safe_caller_dir "$root" "$CALLER")"
    state_root="$caller_dir/send-rate-limit"
    if [[ ! -e "$state_root" && ! -L "$state_root" ]]; then
        mkdir -- "$state_root" ||
            die 74 "could not create send rate-limit state: $state_root"
    fi
    [[ -d "$state_root" && ! -L "$state_root" ]] ||
        die 65 "send rate-limit state is unsafe: $state_root"
    lock_path="$caller_dir/.send-rate-limit.lock"
    [[ ! -L "$lock_path" ]] ||
        die 65 "send rate-limit lock is unsafe: $lock_path"
    exec {lock_fd}>"$lock_path" ||
        die 74 "could not open send rate-limit lock: $lock_path"
    flock "$lock_fd" ||
        die 74 "could not acquire send rate-limit lock: $lock_path"

    extract_recipients "$message" "$recipients_file"
    mapfile -t recipients <"$recipients_file"
    now="$(date +%s)" || die 74 'could not read the current epoch second'
    [[ "$now" =~ ^[0-9]+$ ]] ||
        die 74 'current epoch second is not numeric'
    cutoff=$((now - window))

    for recipient in "${recipients[@]}"; do
        expired=()
        bucket="$state_root/$recipient"
        if [[ ! -e "$bucket" && ! -L "$bucket" ]]; then
            mkdir -- "$bucket" ||
                die 74 "could not create send rate-limit bucket: $bucket"
        fi
        [[ -d "$bucket" && ! -L "$bucket" ]] ||
            die 65 "send rate-limit bucket is unsafe: $bucket"
        marker="$(find "$bucket" -mindepth 1 -maxdepth 1 ! -type f \
            -print -quit)"
        [[ -z "$marker" ]] ||
            die 65 "send rate-limit bucket contains unsafe state: $marker"
        count=0
        oldest=0
        while IFS= read -r marker; do
            basename="${marker##*/}"
            [[ "$basename" =~ ^([0-9]+)\.[A-Za-z0-9]+$ ]] ||
                die 65 "send rate-limit marker is malformed: $marker"
            marker_epoch="${BASH_REMATCH[1]}"
            if ((marker_epoch > cutoff)); then
                count=$((count + 1))
                if ((oldest == 0 || marker_epoch < oldest)); then
                    oldest="$marker_epoch"
                fi
            else
                expired+=("$marker")
            fi
        done < <(find "$bucket" -mindepth 1 -maxdepth 1 -type f \
            -print | sort)
        for marker in "${expired[@]}"; do
            rm -- "$marker" ||
                die 74 "could not remove expired send rate-limit marker: $marker"
        done
        if ((count >= maximum)); then
            retry_after=$((oldest + window - now + 1))
            ((retry_after > 0)) || retry_after=1
            printf 'reach: send rate limit refused sender=%s recipient=%s count=%s limit=%s window=%ss\n' \
                "$CALLER" "$recipient" "$count" "$maximum" "$window" >&2
            print_corrected_send_command '' "$retry_after" \
                "$maximum" "$window"
            flock -u "$lock_fd"
            exec {lock_fd}>&-
            return 65
        fi
    done

    read_required_header "$message" message-id "$TEMP_DIR/rate-message-id" ||
        die 74 'could not read validated Message-ID for send rate limit'
    message_id="$(<"$TEMP_DIR/rate-message-id")"
    for recipient in "${recipients[@]}"; do
        bucket="$state_root/$recipient"
        marker_path="$(mktemp "$bucket/$now.XXXXXXXXXX")" || {
            for marker in "${created[@]}"; do
                rm -f -- "$marker" || true
            done
            die 74 "could not reserve send rate-limit capacity: $bucket"
        }
        created+=("$marker_path")
        printf '%s\n' "$message_id" >"$marker_path" || {
            for marker in "${created[@]}"; do
                rm -f -- "$marker" || true
            done
            die 74 "could not record send rate-limit capacity: $marker_path"
        }
    done
    flock -u "$lock_fd"
    exec {lock_fd}>&-
}





# The chain half, split out so a refusal can name which half failed. A
# subordinate that used a card type it may not send is a different fault from a
# sender outside the chain, and reporting the first as the second sends the
# sender hunting a permission problem it does not have.




preflight_strict_recipient_registry() {
    local message="$1" root="$2" recipient recipient_file="$TEMP_DIR/preflight-all" wire
    extract_recipients "$message" "$recipient_file"
    while IFS= read -r recipient; do
        if [[ "${recipient##*@}" == "$(hostname)" ]]; then
            require_safe_caller_dir "$root" "$recipient" >/dev/null
        else
            wire="$TEMP_DIR/preflight-remote"
            printf 'SNO-REACH-REMOTE/1\nDOCTOR\n' >"$wire"
            append_text_frame "$wire" root "$root"
            append_text_frame "$wire" address "$recipient"
            execute_fixed_request "$wire" "$recipient" '^DOCTOR-OK$' >/dev/null || die 65 "remote identity preflight failed: $recipient"
        fi
    done <"$recipient_file"
}



preflight_recipient_reachability() {
    local root="$1" message="$3" recipient state wire
    local recipient_file="$TEMP_DIR/preflight-to"
    maddr -a -h to: "$message" >"$recipient_file" || die 65 'cannot parse To recipients'
    while IFS= read -r recipient; do
        if [[ "${recipient##*@}" != "$(hostname)" ]]; then
            wire="$TEMP_DIR/preflight-reachability"
            printf 'SNO-REACH-REMOTE/1\nPREFLIGHT\n' >"$wire"
            append_text_frame "$wire" root "$root"
            append_text_frame "$wire" address "$recipient"
            execute_fixed_request "$wire" "$recipient" '^DOCTOR-OK$' >/dev/null || die 65 "remote registration missing: $recipient; that seat must run sno reach register --as $recipient --channel <channel> --handle <locator>"
            continue
        fi
        state="$("$REACHABILITY" status --root "$root" --as "$recipient")" || return $?
        case "$state" in
            present$'\t'*|stale$'\t'*) ;;
            *) die 65 "recipient is not registered: $recipient; that seat must run sno reach register --as $recipient --channel <channel> --handle <locator>" ;;
        esac
    done <"$recipient_file"
}

require_safe_caller_dir() {
    local root="$1" caller="$2" caller_dir="$1/$2" component machine
    [[ "$root" == /* && -d "$root" && ! -L "$root" ]] || die 65 "state root is unsafe: $root"
    [[ -d "$caller_dir" && ! -L "$caller_dir" && -O "$caller_dir" ]] || die 65 "caller mailbox is unavailable or not owned: $caller_dir"
    for component in tmp new cur; do
        [[ -d "$caller_dir/$component" && ! -L "$caller_dir/$component" && -O "$caller_dir/$component" ]] || die 65 "unsafe Maildir component: $caller_dir/$component"
    done
    [[ -f "$caller_dir/seat.json" && ! -L "$caller_dir/seat.json" ]] || die 65 "seat.json is unavailable: $caller_dir/seat.json; run sno reach init --as $caller --name <display>"
    machine="$("$REPO_ROOT/lib/reach-machine-id")" || die 74 'machine identity is unavailable'
    jq -e --arg address "$caller" --arg machine "$machine" '
       keys == ["address","history","host","machine_id","name","owns","role","runtime","seat","supervisor","updated"] and
       .address == $address and .machine_id == $machine and
       .role == ($address | split(".")[0]) and
       .seat == ($address | split("@")[0] | sub("^[^.]+\\."; "")) and
       .host == ($address | split("@")[1]) and
       (.name | type == "string" and length > 0) and
       (.owns | type == "array") and (.history | type == "array") and
       (.supervisor | type == "string" and length > 0)
    ' "$caller_dir/seat.json" >/dev/null || die 65 "seat.json identity mismatch: $caller"
    printf '%s\n' "$caller_dir"
}

require_safe_outbox() {
    local caller_dir="$1"
    local create="$2"
    local outbox="$caller_dir/outbox"

    if [[ -e "$outbox" || -L "$outbox" ]]; then
        [[ -d "$outbox" && ! -L "$outbox" ]] ||
            die 65 "caller outbox path is unsafe: $outbox"
    elif [[ "$create" == yes ]]; then
        mkdir -- "$outbox" ||
            die 74 "could not create caller outbox: $outbox"
    else
        return 1
    fi
    printf '%s\n' "$outbox"
}

new_entry_basename() {
    local caller_host="$1"

    printf '%s.M%sP%sQ%s.%s\n' \
        "$(date +%s)" "$$" "$$" "$RANDOM" "$caller_host"
}

stage_outbox_entry() {
    local root="$1"
    local caller="$2"
    local message="$3"
    local recipient_file="$4"
    local caller_dir
    local outbox
    local private_dir
    local basename
    local final_dir

    caller_dir="$(require_safe_caller_dir "$root" "$caller")"
    outbox="$(require_safe_outbox "$caller_dir" yes)"
    private_dir="$(mktemp -d "$outbox/.reach-outbox.XXXXXXXXXX")" ||
        die 74 'could not create private outbox entry'
    cp -- "$message" "$private_dir/message" ||
        die 74 'could not stage exact outbox message'
    cp -- "$recipient_file" "$private_dir/recipients" ||
        die 74 'could not stage exact outbox recipients'

    while true; do
        basename="$(new_entry_basename "${caller##*@}")"
        final_dir="$outbox/$basename"
        [[ ! -e "$final_dir" && ! -L "$final_dir" ]] || continue
        if mv -- "$private_dir" "$final_dir"; then
            printf '%s\n' "$final_dir"
            return 0
        fi
        die 74 'could not make complete outbox entry visible atomically'
    done
}

find_rendered_copy() {
    local render_root="$1"
    local recipient="$2"
    local output_file="$3"
    local -a copies=()

    mapfile -t copies < <(
        find "$render_root/$recipient/new" "$render_root/$recipient/cur" \
            -mindepth 1 -maxdepth 1 -type f -print
    )
    ((${#copies[@]} == 1)) || {
        printf 'reach: canonical renderer produced %d copies for %s\n' \
            "${#copies[@]}" "$recipient" >&2
        return 74
    }
    printf '%s\n' "${copies[0]}" >"$output_file"
}

deliver_remote_copy() {
    local root="$1"
    local recipient="$2"
    local basename="$3"
    local body_file="$4"
    local literal
    local body_size
    local error_file="$TEMP_DIR/deliver.$RANDOM.stderr"
    local ready
    local remote_pid
    local input_fd
    local output_fd
    local request_status
    local -a results=()

    literal="$(remote_program_literal)"
    body_size="$(wc -c <"$body_file" | tr -d ' ')"
    # Fixed receiver program is the remote command.
    # shellcheck disable=SC2029
    coproc REACH_REMOTE_DELIVERY {
        ssh "${SSH_OPTIONS[@]}" "${recipient##*@}" "$literal" \
            2>"$error_file"
    }
    remote_pid=$REACH_REMOTE_DELIVERY_PID
    output_fd=${REACH_REMOTE_DELIVERY[0]}
    input_fd=${REACH_REMOTE_DELIVERY[1]}

    set +e
    {
        printf 'SNO-REACH-REMOTE/1\nDELIVER\n'
        printf 'root %s\n%s\n' "${#root}" "$root"
        printf 'address %s\n%s\n' "${#recipient}" "$recipient"
        printf 'basename %s\n%s\n' "${#basename}" "$basename"
        printf 'body %s\n' "$body_size"
    } >&"$input_fd"
    request_status=$?
    set -e
    if ((request_status != 0)); then
        exec {input_fd}>&- || true
        wait "$remote_pid" 2>/dev/null || true
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        return 74
    fi

    if ! IFS= read -r -t 10 -u "$output_fd" ready; then
        exec {input_fd}>&- || true
        wait "$remote_pid" 2>/dev/null || true
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        printf 'reach: remote receiver did not emit READY\n' >&2
        return 74
    fi
    if [[ ! "$ready" =~ ^READY\ [1-9][0-9]*\ (.+)$ ]] ||
       [[ "${BASH_REMATCH[1]}" != "$basename" ]]; then
        exec {input_fd}>&- || true
        wait "$remote_pid" 2>/dev/null || true
        printf 'reach: remote receiver emitted invalid READY\n' >&2
        return 74
    fi

    set +e
    cat "$body_file" >&"$input_fd"
    request_status=$?
    exec {input_fd}>&-
    if ((request_status == 0)); then
        mapfile -t results <&"$output_fd"
        request_status=$?
    fi
    exec {output_fd}<&-
    wait "$remote_pid"
    local wait_status=$?
    set -e
    if ((request_status != 0 || wait_status != 0)); then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        return "$((wait_status != 0 ? wait_status : 74))"
    fi
    [[ ! -s "$error_file" ]] || {
        cat "$error_file" >&2
        return 74
    }
    ((${#results[@]} == 1)) ||
        return 74
    [[ "${results[0]}" == PLACED || "${results[0]}" == ALREADY ]] ||
        return 74
}

record_remote_delivery() {
    local root="$1" caller="$2" recipient="$3" body_file="$4"
    local message_id digest key receipt_dir receipt temporary sent_dir

    message_id="$(mhdr -h message-id "$body_file")"
    [[ "$message_id" =~ $MESSAGE_ID_RE ]] ||
        die 65 'remote delivered copy has an invalid Message-ID'
    digest="$(sha256sum "$body_file" | cut -d ' ' -f1)"
    key="$(printf '%s\n%s\n' "$message_id" "$recipient" | sha256sum | cut -c1-64)"
    receipt_dir="$root/$caller/delivery-receipts"
    mkdir -p -- "$receipt_dir" || die 74 'could not create delivery receipt directory'
    [[ -d "$receipt_dir" && ! -L "$receipt_dir" ]] ||
        die 65 'delivery receipt directory is unsafe'
    receipt="$receipt_dir/$key.json"
    temporary="$(mktemp "$receipt_dir/.delivery-receipt.XXXXXXXXXX")" ||
        die 74 'could not create private delivery receipt'
    jq -n --arg recipient "$recipient" --arg message_id "$message_id" \
        --arg sha256 "$digest" \
        '{version:1, recipient:$recipient, message_id:$message_id,
          sha256:$sha256, transport:"remote"}' >"$temporary" ||
        die 74 'could not render delivery receipt'
    chmod 0600 "$temporary" || die 74 'could not protect delivery receipt'
    mv -- "$temporary" "$receipt" || die 74 'could not publish delivery receipt'

    # The recipient's store lives on another machine; keep the copy here so this
    # machine can derive the work's progress (progress_load reads sent/).
    sent_dir="$root/$caller/sent"
    mkdir -p -- "$sent_dir" || die 74 'could not create sent directory'
    [[ -d "$sent_dir" && ! -L "$sent_dir" ]] || die 65 'sent directory is unsafe'
    temporary="$(mktemp "$sent_dir/.sent.XXXXXXXXXX")" || die 74 'could not create sent copy'
    cp -- "$body_file" "$temporary" || die 74 'could not write sent copy'
    mv -- "$temporary" "$sent_dir/$key" || die 74 'could not publish sent copy'
}

rewrite_entry_recipients() {
    local entry="$1"
    local remaining_file="$2"
    local temporary

    if [[ ! -s "$remaining_file" ]]; then
        rm -r -- "$entry" ||
            die 74 "could not remove completed outbox entry: $entry"
        rmdir -- "$(dirname -- "$entry")" 2>/dev/null || true
        return 0
    fi
    temporary="$(mktemp "$entry/.recipients.XXXXXXXXXX")" ||
        die 74 'could not stage remaining recipient list'
    cp -- "$remaining_file" "$temporary" ||
        die 74 'could not write remaining recipient list'
    mv -- "$temporary" "$entry/recipients" ||
        die 74 'could not replace remaining recipient list atomically'
}

process_outbox_entry() {
    local root="$1"
    local caller="$2"
    local entry="$3"
    local basename="${entry##*/}"
    local message="$entry/message"
    local queued_file="$entry/recipients"
    local all_file="$TEMP_DIR/all-recipients.$RANDOM"
    local remaining_file="$TEMP_DIR/remaining.$RANDOM"
    local render_root="$TEMP_DIR/render.$RANDOM"
    local caller_host="${caller##*@}"
    local recipient
    local recipient_host
    local actual_maildir
    local rendered_path_file="$TEMP_DIR/rendered-path.$RANDOM"
    local rendered_path
    local render_status
    local failed=0
    local -A queued=()
    local -A seen=()
    local -A local_unavailable=()

    : >"$TEMP_DIR/delivered-recipients"
    [[ "$basename" =~ ^[A-Za-z0-9._-]+$ ]] ||
        die 65 "outbox entry has an invalid basename: $entry"
    [[ -d "$entry" && ! -L "$entry" ]] ||
        die 65 "outbox entry path is unsafe: $entry"
    [[ -f "$message" && ! -L "$message" ]] ||
        die 65 "outbox entry message is incomplete: $entry"
    [[ -f "$queued_file" && ! -L "$queued_file" ]] ||
        die 65 "outbox entry recipients are incomplete: $entry"

    set +e
    "$LINTER" "$message"
    render_status=$?
    set -e
    ((render_status == 0)) ||
        die 65 "outbox entry message is malformed: $entry"
    extract_recipients "$message" "$all_file"
    while IFS= read -r recipient; do
        [[ "$recipient" =~ $ADDRESS_RE ]] ||
            die 65 "outbox entry has an invalid recipient: $recipient"
        [[ -z "${seen[$recipient]+present}" ]] ||
            die 65 "outbox entry repeats a recipient: $recipient"
        grep -Fqx -- "$recipient" "$all_file" ||
            die 65 "outbox entry recipient is absent from the message: $recipient"
        seen["$recipient"]=1
        queued["$recipient"]=1
    done <"$queued_file"
    # An entry can arrive here already empty: sender-owned recovery removes a
    # recipient whose seat is gone and escalates, which leaves the entry with
    # nothing deliverable. That is the same terminal condition a successful
    # flush produces, and rewrite_entry_recipients already retires it by
    # removing the directory. Refusing it instead stranded the entry forever:
    # the queued-copy count reads recipient lines, so it reported the orphan as
    # zero, while flush -- the one command the operator is told to run -- kept
    # exiting non-zero on it.
    if ((${#queued[@]} == 0)); then
        rm -r -- "$entry" ||
            die 74 "could not retire an outbox entry with no recipients: $entry"
        rmdir -- "$(dirname -- "$entry")" 2>/dev/null || true
        printf 'reach: retired an outbox entry with no deliverable recipient: %s\n' \
            "$basename" >&2
        return 0
    fi

    mkdir -- "$render_root" ||
        die 74 'could not create private rendering root'
    while IFS= read -r recipient; do
        recipient_host="${recipient##*@}"
        if [[ -n "${queued[$recipient]+present}" &&
              "$recipient_host" == "$caller_host" ]]; then
            actual_maildir="$root/$recipient"
            if [[ -d "$actual_maildir" && ! -L "$actual_maildir" &&
                  -d "$actual_maildir/tmp" && ! -L "$actual_maildir/tmp" &&
                  -d "$actual_maildir/new" && ! -L "$actual_maildir/new" &&
                  -d "$actual_maildir/cur" && ! -L "$actual_maildir/cur" ]]; then
                ln -s -- "$actual_maildir" "$render_root/$recipient" ||
                    die 74 'could not attach local recipient to canonical renderer'
            else
                mkdir -p -- "$render_root/$recipient/tmp" \
                    "$render_root/$recipient/new" "$render_root/$recipient/cur" ||
                    die 74 'could not create private recipient rendering Maildir'
                local_unavailable["$recipient"]=1
            fi
        else
            mkdir -p -- "$render_root/$recipient/tmp" \
                "$render_root/$recipient/new" "$render_root/$recipient/cur" ||
                die 74 'could not create private recipient rendering Maildir'
        fi
    done <"$all_file"

    set +e
    SNO_REACH_ROOT="$render_root" "$DELIVER" <"$message"
    render_status=$?
    set -e
    if ((render_status != 0)); then
        printf 'reach: canonical per-recipient rendering failed\n' >&2
        return 74
    fi

    : >"$remaining_file"
    while IFS= read -r recipient; do
        recipient_host="${recipient##*@}"
        if [[ "$recipient_host" == "$caller_host" ]]; then
            if [[ -n "${local_unavailable[$recipient]+present}" ]]; then
                printf '%s\n' "$recipient" >>"$remaining_file"
                failed=1
            fi
            continue
        fi
        if ! find_rendered_copy "$render_root" "$recipient" \
            "$rendered_path_file"; then
            printf '%s\n' "$recipient" >>"$remaining_file"
            failed=1
            continue
        fi
        rendered_path="$(<"$rendered_path_file")"
        if ! deliver_remote_copy "$root" "$recipient" "$basename" \
            "$rendered_path"; then
            printf '%s\n' "$recipient" >>"$remaining_file"
            failed=1
        else
            record_remote_delivery "$root" "$caller" "$recipient" \
                "$rendered_path"
        fi
    done <"$queued_file"

    while IFS= read -r recipient; do
        if ! grep -Fxq -- "$recipient" "$remaining_file"; then
            printf '%s\n' "$recipient" >>"$TEMP_DIR/delivered-recipients"
        fi
    done <"$queued_file"
    rewrite_entry_recipients "$entry" "$remaining_file"
    rm -r -- "$render_root" ||
        die 74 'could not clean private rendering root'
    ((failed == 0))
}

stage_message_in_outbox() {
    local root="$1"
    local caller="$2"
    local message="$3"
    local recipients_file="$TEMP_DIR/validated-recipients"

    extract_recipients "$message" "$recipients_file"
    stage_outbox_entry "$root" "$caller" "$message" "$recipients_file"
}

outbox_queued_copy_count() {
    local outbox="$1"
    local recipients count=0

    [[ -d "$outbox" && ! -L "$outbox" ]] || {
        printf '0\n'
        return
    }
    while IFS= read -r -d '' recipients; do
        count=$((count + $(wc -l <"$recipients")))
    done < <(find "$outbox" -mindepth 2 -maxdepth 2 -name recipients \
        -type f -print0)
    printf '%s\n' "$count"
}

outbox_entry_count() {
    local outbox="$1"

    [[ -d "$outbox" && ! -L "$outbox" ]] || {
        printf '0\n'
        return
    }
    find "$outbox" -mindepth 1 -maxdepth 1 -type d -printf '.' | wc -c
}

print_outbox_recovery() {
    local root="$1"
    local caller="$2"
    local count entries

    count="$(outbox_queued_copy_count "$root/$caller/outbox")"
    entries="$(outbox_entry_count "$root/$caller/outbox")"
    printf 'reach: queued copies remaining: %s\n' "$count" >&2
    # The count reads recipient lines, so an entry whose last recipient was
    # removed and escalated reads as zero. Saying only "0" next to a refusal
    # that reports work still queued left the operator with two numbers that
    # contradict each other and no way to act on either.
    if ((count == 0 && entries > 0)); then
        printf 'reach: %s outbox entry/entries carry no deliverable recipient; the flush below retires them.\n' \
            "$entries" >&2
    fi
    printf 'reach: flush exactly: SNO_REACH_ROOT=%q %q flush --as %q\n' \
        "$root" "$REPO_ROOT/bin/sno-reach" "$caller" >&2
}


attempt_outbox_entry() {
    local root="$1"
    local caller="$2"
    local entry="$3"

    if process_outbox_entry "$root" "$caller" "$entry"; then
        return 0
    fi
    print_outbox_recovery "$root" "$caller"
    return 74
}

queue_and_attempt_message() {
    local root="$1"
    local caller="$2"
    local message="$3"
    local entry

    entry="$(stage_message_in_outbox "$root" "$caller" "$message")"
    attempt_outbox_entry "$root" "$caller" "$entry"
}

run_flush() {
    local root
    local caller_dir
    local outbox
    local entry
    local failed=0
    local raw_entries
    local sorted_entries
    local raw_children
    local sorted_children
    local expected_children
    local entry_basename
    local -a entries=()

    parse_flush_options "$@"
    [[ -x "$LINTER" ]] || die 69 "header linter is unavailable: $LINTER"
    [[ -x "$DELIVER" ]] || die 69 "local delivery command is unavailable: $DELIVER"
    require_tools maddr
    root="$(mailbox_root)"
    caller_dir="$(require_safe_caller_dir "$root" "$CALLER")"
    outbox="$caller_dir/outbox"
    if [[ ! -e "$outbox" && ! -L "$outbox" ]]; then
        return 0
    fi
    [[ -d "$outbox" && ! -L "$outbox" ]] ||
        die 65 "caller outbox path is unsafe: $outbox"
    make_temp_dir
    raw_entries="$TEMP_DIR/outbox.entries.raw"
    sorted_entries="$TEMP_DIR/outbox.entries.sorted"
    raw_children="$TEMP_DIR/outbox.children.raw"
    sorted_children="$TEMP_DIR/outbox.children.sorted"
    expected_children="$TEMP_DIR/outbox.children.expected"
    if [[ -n "$FLUSH_ENTRY" ]]; then
        [[ "$(dirname -- "$FLUSH_ENTRY")" == "$outbox" ]] ||
            die 65 "scoped outbox entry is outside the caller outbox: $FLUSH_ENTRY"
        entries=("$FLUSH_ENTRY")
    else
        if ! find "$outbox" -mindepth 1 -maxdepth 1 -print0 >"$raw_entries"; then
            die 74 "could not enumerate caller outbox: $outbox"
        fi
        if ! sort -z "$raw_entries" >"$sorted_entries"; then
            die 74 "could not sort caller outbox entries: $outbox"
        fi
        mapfile -d '' -t entries <"$sorted_entries"
    fi
    printf 'message\0recipients\0' | sort -z >"$expected_children" ||
        die 74 'could not prepare outbox entry shape check'
    for entry in "${entries[@]}"; do
        entry_basename="${entry##*/}"
        [[ "$entry_basename" =~ ^[A-Za-z0-9._-]+$ ]] ||
            die 65 "outbox entry has an invalid basename: $entry"
        [[ -d "$entry" && ! -L "$entry" ]] ||
            die 65 "outbox entry path is unsafe: $entry"
        [[ -f "$entry/message" && ! -L "$entry/message" &&
           -f "$entry/recipients" && ! -L "$entry/recipients" ]] ||
            die 65 "outbox entry is incomplete: $entry"
        if ! find "$entry" -mindepth 1 -maxdepth 1 -printf '%f\0' \
                >"$raw_children"; then
            die 74 "could not enumerate outbox entry: $entry"
        fi
        if ! sort -z "$raw_children" >"$sorted_children"; then
            die 74 "could not sort outbox entry contents: $entry"
        fi
        cmp -s -- "$expected_children" "$sorted_children" ||
            die 65 "outbox entry has an invalid child set: $entry"
    done
    for entry in "${entries[@]}"; do
        local message="$TEMP_DIR/flush-message"
        cp -- "$entry/message" "$message" || die 74 'could not snapshot queued message'
        if ! process_outbox_entry "$root" "$CALLER" "$entry"; then
            failed=1
        fi
        ring_delivered "$root" "$CALLER" "$message" "$TEMP_DIR/delivered-recipients"
    done
    ((failed == 0))
}

scan_maildir_paths() {
    local maildir="$1"
    local output_file="$2"
    local raw_file="$TEMP_DIR/mlist.paths"
    local sorted_file="$TEMP_DIR/mlist.sorted"
    local error_file="$TEMP_DIR/mlist.stderr"
    local header_file="$TEMP_DIR/mlist.message-id"
    local status
    local path
    local message_id
    local representative
    local grouped
    local conflict=0
    local -a order=()
    local -A representatives=()
    local -A paths_by_id=()
    local -A conflicts=()

    : >"$raw_file"
    : >"$error_file"
    set +e
    mlist "$maildir" >"$raw_file" 2>"$error_file"
    status=$?
    set -e
    if ((status != 0)) || [[ -s "$error_file" ]]; then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        return 74
    fi

    if ! sort "$raw_file" >"$sorted_file"; then
        printf 'reach: could not sort mailbox scan results\n' >&2
        return 74
    fi

    while IFS= read -r path; do
        [[ -f "$path" && ! -L "$path" ]] || continue
        : >"$error_file"
        set +e
        mhdr -h message-id "$path" >"$header_file" 2>"$error_file"
        status=$?
        set -e
        if ((status != 0)) || [[ -s "$error_file" ]]; then
            [[ ! -s "$error_file" ]] || cat "$error_file" >&2
            printf 'reach: could not read Message-ID while grouping: %s\n' \
                "$path" >&2
            return 74
        fi
        message_id="$(<"$header_file")"
        [[ "$message_id" =~ $MESSAGE_ID_RE ]] || {
            printf 'reach: invalid Message-ID while grouping: %s\n' \
                "$path" >&2
            return 74
        }
        if [[ -z "${representatives[$message_id]+present}" ]]; then
            representatives["$message_id"]="$path"
            paths_by_id["$message_id"]="$path"
            order+=("$message_id")
            continue
        fi
        representative="${representatives[$message_id]}"
        if ! cmp -s -- "$representative" "$path"; then
            conflicts["$message_id"]=1
        fi
        paths_by_id["$message_id"]+=$'\n'"$path"
        if [[ "$representative" == */new/* && "$path" == */cur/* ]]; then
            representatives["$message_id"]="$path"
        fi
    done <"$sorted_file"

    : >"$output_file"
    for message_id in "${order[@]}"; do
        if [[ -n "${conflicts[$message_id]+present}" ]]; then
            printf 'reach: Message-ID has different bytes: %s\n' \
                "$message_id" >&2
            grouped="${paths_by_id[$message_id]}"
            printf '%s\n' "$grouped" >&2
            conflict=1
            continue
        fi
        printf '%s\n' "${representatives[$message_id]}" >>"$output_file" ||
            return 74
    done
    ((conflict == 0)) || return 74
    sort -o "$output_file" "$output_file" ||
        return 74
}

list_actions() {
    local maildir="$1"
    local caller="$2"
    local output_file="$3"
    local paths_file="$TEMP_DIR/action.paths"
    local candidates_file="$TEMP_DIR/action.candidates"
    local error_file="$TEMP_DIR/action.stderr"
    local status

    scan_maildir_paths "$maildir" "$paths_file" || return 74
    : >"$error_file"
    set +e
    # mpick resolves $REACH_ADDR inside its own query language.
    # shellcheck disable=SC2016
    REACH_ADDR="$caller" \
        mpick -t 'to.addr == $REACH_ADDR && !replied && !trashed' \
        <"$paths_file" >"$candidates_file" 2>"$error_file"
    status=$?
    set -e
    if ((status != 0)) || [[ -s "$error_file" ]]; then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        return 74
    fi
    filter_authorized_actions "$maildir" "$caller" "$candidates_file" \
        "$output_file" "$paths_file"
}

list_informed() {
    local maildir="$1"
    local caller="$2"
    local output_file="$3"
    local paths_file="$TEMP_DIR/informed.paths"
    local candidates_file="$TEMP_DIR/informed.candidates"
    local error_file="$TEMP_DIR/informed.stderr"
    local status
    local path

    scan_maildir_paths "$maildir" "$paths_file" || return 74
    : >"$error_file"
    set +e
    # mpick resolves $REACH_ADDR inside its own query language.
    # shellcheck disable=SC2016
    REACH_ADDR="$caller" \
        mpick -t '"cc".addr == $REACH_ADDR && to.addr != $REACH_ADDR && !trashed' \
        <"$paths_file" >"$candidates_file" 2>"$error_file"
    status=$?
    set -e
    if ((status != 0)) || [[ -s "$error_file" ]]; then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        return 74
    fi
    : >"$output_file"
    while IFS= read -r path; do
        printf 'INFORMED-NOT-WORK\t%s\n' "$path" >>"$output_file" ||
            return 74
    done <"$candidates_file"
}




progress_header() {
    local value status
    if value="$(mhdr -h "$2" "$1")"; then
        printf '%s\n' "$value"
    else
        status=$?
        ((status == 1)) || return "$status"
    fi
}

progress_load() {
    local root="$1" journey="$2" path id recipient key epoch
    local headers line header value status
    local -A values=()
    declare -gA P_PATH=() P_FROM=() P_TYPE=() P_PARENT=() P_REFS=() P_STATE=()
    declare -gA P_DATE=() P_EPOCH=() P_EXPIRY=() P_SUPER=() P_ITEMS=() P_FLAGS=()
    declare -gA P_ANOMALY=() P_HELD=()
    [[ -d "$root" && ! -L "$root" ]] || die 73 "state root is unavailable: $root"
    for path in "$root"/*/new/* "$root"/*/cur/* "$root"/*/sent/*; do
        [[ -e "$path" ]] || continue
        [[ -f "$path" && ! -L "$path" && -r "$path" ]] ||
            die 74 "state cannot read message: $path"
        if headers="$(mhdr "$path")"; then :
        else status=$?; ((status == 1)) || return "$status"; fi
        values=()
        # mhdr already unfolds headers; retain its first value for each name.
        while IFS= read -r line; do
            [[ "$line" == *:* ]] || continue
            header="${line%%:*}"; header="${header,,}"
            [[ -n "$header" && -z "${values[$header]+present}" ]] || continue
            value="${line#*:}"
            value="${value#"${value%%[!$' \t']*}"}"
            values["$header"]="$value"
        done <<<"$headers"
        [[ "${values[x-work]:-}" == "$journey" ]] || continue
        id="${values[message-id]:-}"
        [[ "$id" =~ $MESSAGE_ID_RE ]] || die 65 "state invalid Message-ID: $path"
        if [[ -z "${P_PATH[$id]:-}" ]]; then
            P_PATH["$id"]="$path"
            P_FROM["$id"]="$(maddr -a -h from: "$path")"
            P_TYPE["$id"]="${values[x-type]:-}"
            P_PARENT["$id"]="${values[in-reply-to]:-}"
            P_REFS["$id"]="${values[references]:-}"
            P_STATE["$id"]="${values[x-state]:-}"
            P_DATE["$id"]="${values[date]:-}"
            epoch="$(date -u -d "${P_DATE[$id]}" +%s)" || die 65 "state invalid Date: $path"
            P_EPOCH["$id"]="$epoch"
            P_EXPIRY["$id"]="${values[expiry-date]:-}"
            P_SUPER["$id"]="${values[supersedes]:-}"
        fi
        recipient="${values[delivered-to]:-}"
        [[ "$recipient" =~ $ADDRESS_RE && ( "${path%/*/*}" == "$root/$recipient" || "${path%/*}" == */sent ) ]] || continue
        maddr -a -h to: "$path" | grep -Fqx -- "$recipient" || continue
        P_HELD["$id|$recipient"]="$path"
        [[ -z "${P_STATE[$id]}" && "${P_TYPE[$id]}" != cancel ]] || continue
        key="$id|$recipient"
        P_ITEMS["$key"]="$path"
        P_FLAGS["$key"]=''
        [[ "$path" != *':2,'* ]] || P_FLAGS["$key"]="${path##*:2,}"
    done
}

progress_root_id() {
    local id first rest
    id="$1"
    read -r first rest <<<"${P_REFS[$id]}"
    printf '%s\n' "$first"
}

progress_is_terminal() {
    case "$1" in completed|failed|cancelled|refused) return 0 ;; esac
    return 1
}

# Check a candidate backwards. Each link must be authored by this item's holder.
progress_ancestry() {
    local item="$1" recipient="$2" cursor="$3" parent expected index
    local -A visited=()
    P_CHAIN=()
    while [[ "$cursor" != "$item" ]]; do
        [[ -n "$cursor" && -n "${P_PATH[$cursor]:-}" && -z "${visited[$cursor]:-}" ]] || return 1
        [[ "${P_FROM[$cursor]}" == "$recipient" && "$(progress_root_id "$cursor")" == "$item" ]] || return 1
        [[ -n "${P_STATE[$cursor]}" || "${P_TYPE[$cursor]}" == answer ]] || return 1
        visited["$cursor"]=1
        P_CHAIN=("$cursor" "${P_CHAIN[@]}")
        cursor="${P_PARENT[$cursor]}"
    done
    expected="$item"
    for index in "${!P_CHAIN[@]}"; do
        cursor="${P_CHAIN[$index]}"
        [[ "${P_REFS[$cursor]}" == "$expected" ]] || return 1
        if ((index < ${#P_CHAIN[@]} - 1)) && progress_is_terminal "${P_STATE[$cursor]}"; then return 1; fi
        expected+=" $cursor"
    done
}

progress_chain() {
    local item="$1" recipient="$2" flags="$3" id cursor root_id
    local -a candidates=() terminals=() children=() chain=()
    local -A included=()
    P_TAIL='' P_ACCEPTED=no P_AMBIGUOUS=no
    P_CHAIN=()
    for id in "${!P_PATH[@]}"; do
        [[ -z "${P_ANOMALY[$id]:-}" ]] || continue
        [[ -n "${P_STATE[$id]}" || ( "$flags" == *R* && "${P_TYPE[$id]}" == answer ) ]] || continue
        root_id="$(progress_root_id "$id")"
        [[ "$root_id" == "$item" && "${P_FROM[$id]}" == "$recipient" ]] || continue
        if ! progress_ancestry "$item" "$recipient" "$id"; then
            P_ANOMALY["$id"]=outside-chain
            continue
        fi
        candidates+=("$id")
        if [[ "$flags" == *R* ]] &&
           { progress_is_terminal "${P_STATE[$id]}" || [[ -z "${P_STATE[$id]}" && "${P_TYPE[$id]}" == answer ]]; }; then
            terminals+=("$id")
        fi
    done
    # R is an existing durable terminal fact. Later reports cannot reopen it.
    if [[ "$flags" == *R* && ${#terminals[@]} == 1 ]]; then
        P_TAIL="${terminals[0]}"
        progress_ancestry "$item" "$recipient" "$P_TAIL" || return 65
        chain=("${P_CHAIN[@]}")
    else
        cursor="$item"
        while :; do
            children=()
            for id in "${candidates[@]}"; do
                [[ "${P_PARENT[$id]}" != "$cursor" ]] || children+=("$id")
            done
            ((${#children[@]} > 0)) || break
            if ((${#children[@]} > 1)); then
                P_AMBIGUOUS=yes
                for id in "${children[@]}"; do P_ANOMALY["$id"]=fork; done
                break
            fi
            cursor="${children[0]}"
            chain+=("$cursor")
            P_TAIL="$cursor"
            progress_is_terminal "${P_STATE[$cursor]}" && break
        done
    fi
    P_CHAIN=("${chain[@]}")
    for id in "${chain[@]}"; do
        included["$id"]=1
        [[ "${P_STATE[$id]}" != accepted ]] || P_ACCEPTED=yes
    done
    for id in "${candidates[@]}"; do
        [[ -n "${included[$id]:-}" || -n "${P_ANOMALY[$id]:-}" ]] || P_ANOMALY["$id"]=outside-chain
    done
}

progress_validate_reports() {
    local id root_id holder
    for id in "${!P_PATH[@]}"; do
        [[ -n "${P_STATE[$id]}" ]] || continue
        root_id="$(progress_root_id "$id")"
        holder="${P_FROM[$id]}"
        if [[ -z "$root_id" || -z "${P_PARENT[$id]}" || -z "${P_ITEMS[$root_id|$holder]:-}" ]]; then
            P_ANOMALY["$id"]=unheld-item
            continue
        fi
        case "${P_STATE[$id]}" in
            accepted|running|requires-action|completed|failed|cancelled|refused) ;;
            *) P_ANOMALY["$id"]=invalid-state ;;
        esac
    done
}

progress_record() {
    local file="$1" id="$2"
    [[ -e "$file" || -L "$file" ]] || { printf '{}\n'; return; }
    [[ -f "$file" && -r "$file" && ! -L "$file" ]] || return 65
    jq -cs --arg id "$id" '
        if all(.[]; type == "object" and (.message_id | type == "string"))
        then [.[] | select(.message_id == $id)] | last // {}
        else error("invalid record") end' "$file" 2>/dev/null
}

progress_item() {
    local key="$1" root="$2" now="$3" item="${1%%|*}" recipient="${1#*|}"
    local flags="${P_FLAGS[$key]}" id record expiry replacement='' cancel='' answer
    P_VALUE=queued P_SINCE="${P_DATE[$item]}" P_BLOCKED=- P_ANSWERED=no P_REASON=-
    progress_chain "$item" "$recipient" "$flags"
    if ! record="$(progress_record "$root/$recipient/dismissals.jsonl" "$item")"; then
        P_REASON=unreadable
        return 65
    fi
    if [[ "$flags" == *T* ]]; then
        P_REASON="$(jq -r '.reason // "-"' <<<"$record")"
        P_SINCE="$(jq -r --arg date "$P_SINCE" '.dismissed_at // $date' <<<"$record")"
        case "$P_REASON" in expired) P_VALUE=expired ;; superseded:*) P_VALUE=superseded ;; *) P_VALUE=dismissed ;; esac
        for id in "${!P_PATH[@]}"; do
            [[ "$(progress_root_id "$id")" != "$item" || -z "${P_STATE[$id]}" ]] || P_ANOMALY["$id"]=closed-item
        done
        return 0
    fi
    if [[ "$flags" == *R* ]]; then
        P_VALUE=replied
        if [[ -n "$P_TAIL" ]] && progress_is_terminal "${P_STATE[$P_TAIL]}"; then P_VALUE="${P_STATE[$P_TAIL]}"; fi
    elif [[ "$P_AMBIGUOUS" == yes ]]; then
        P_VALUE=ambiguous
    else
        for id in "${!P_PATH[@]}"; do
            if [[ "${P_TYPE[$id]}" == cancel && "${P_PARENT[$id]}" == "$item" && "${P_FROM[$id]}" == "${P_FROM[$item]}" && -n "${P_HELD[$id|$recipient]:-}" ]]; then
                # The request must have a copy delivered to this item's holder.
                if progress_authority_target "$root" "${P_PATH[$id]}" "$recipient" cancel >/dev/null; then
                    [[ -n "$cancel" && "$cancel" < "$id" ]] || cancel="$id"
                fi
            fi
        done
        if [[ -n "$cancel" ]]; then P_VALUE='cancel-requested'; P_SINCE="${P_DATE[$cancel]}"
        elif [[ -n "$P_TAIL" ]]; then P_VALUE="${P_STATE[$P_TAIL]}"
        elif record="$(progress_record "$root/$recipient/seen.jsonl" "$item")"; then
            if [[ "$(jq -r '.message_id // empty' <<<"$record")" == "$item" ]]; then
                P_VALUE=seen; P_SINCE="$(jq -r '.seen_at' <<<"$record")"
            fi
        else P_REASON=unreadable; return 65
        fi
        for id in "${!P_ITEMS[@]}"; do
            [[ "${id#*|}" == "$recipient" && "${P_SUPER[${id%%|*}]}" == "$item" ]] || continue
            [[ -n "$replacement" && "$replacement" < "${id%%|*}" ]] || replacement="${id%%|*}"
        done
        expiry="${P_EXPIRY[$item]}"
        if [[ -n "$replacement" ]]; then P_VALUE=superseded; P_REASON=not-yet-peeked
        elif [[ -n "$expiry" ]]; then
            expiry="$(date -u -d "$expiry" +%s)" || { P_REASON=unreadable; return 65; }
            if ((expiry < now)); then P_VALUE=expired; P_REASON=not-yet-peeked; fi
        fi
    fi
    if [[ -n "$P_TAIL" && "$P_VALUE" == "${P_STATE[$P_TAIL]}" ]]; then P_SINCE="${P_DATE[$P_TAIL]}"; fi
    if [[ "$P_VALUE" == requires-action ]]; then
        P_BLOCKED="$P_TAIL"
        for answer in "${!P_PATH[@]}"; do
            if [[ "${P_TYPE[$answer]}" == answer && "${P_PARENT[$answer]}" == "$P_BLOCKED" ]]; then P_ANSWERED=yes; fi
        done
    fi
    if progress_is_terminal "$P_VALUE" && [[ -n "$P_TAIL" ]]; then
        P_REASON="$(awk 'body && /[^[:space:]]/ {gsub(/[\t\r]/," "); print; exit} /^\r?$/ {body=1}' "${P_PATH[$P_TAIL]}")"
        [[ -n "$P_REASON" ]] || P_REASON=-
    fi
}

prepare_reply_progress() {
    local source="$1" root="$2" journey="$3" id report
    id="$(mhdr -h message-id "$source")"
    progress_load "$root" "$journey"
    progress_validate_reports
    STATE_REPLY_PARENT="$id" STATE_REPLY_REFS="$id"
    if [[ -z "${P_ITEMS[$id|$CALLER]:-}" ]]; then
        [[ -z "$REPLY_STATE" ]] && return 0
        die 65 'reply --state requires a held To work item'
    fi
    progress_chain "$id" "$CALLER" ''
    [[ "$P_AMBIGUOUS" == no ]] || die 65 'reply refuses an ambiguous report chain'
    if [[ -n "$P_TAIL" ]] && progress_is_terminal "${P_STATE[$P_TAIL]}"; then
        die 65 'reply refuses an already terminal report chain'
    fi
    [[ "$REPLY_STATE" != accepted || "$P_ACCEPTED" != yes ]] || die 65 'work is already accepted'
    if [[ -z "$REPLY_STATE" || "$REPLY_STATE" == completed || "$REPLY_STATE" == failed ]] && [[ "$P_ACCEPTED" != yes ]]; then
        printf 'reach: acceptance required; no reply delivered. Run: printf %%s Accepted | sno reach reply --as %q --card %q --state accepted\n' "$CALLER" "$source" >&2
        exit 65
    fi
    STATE_REPLY_PARENT="${P_TAIL:-$id}"
    STATE_REPLY_REFS="$id"
    for report in "${P_CHAIN[@]}"; do STATE_REPLY_REFS+=" $report"; done
}

thread_state_reply() {
    local message="$1" output="$2"
    REACH_STATE_PARENT="$STATE_REPLY_PARENT" REACH_STATE_REFS="$STATE_REPLY_REFS" awk '
        BEGIN { headers=1; skip=0 }
        headers && /^\r?$/ { headers=0; skip=0 }
        headers && /^[ \t]/ { if (!skip) print; next }
        headers {
            skip=0
            field=tolower(substr($0,1,index($0,":")-1))
            if (field=="in-reply-to" || field=="references") {
                skip=1
                if (field=="in-reply-to") print "In-Reply-To: " ENVIRON["REACH_STATE_PARENT"]
                else print "References: " ENVIRON["REACH_STATE_REFS"]
                next
            }
        }
        { print }
    ' "$message" >"$output" || die 74 'could not thread terminal state reply'
    "$LINTER" "$output" || die 65 'terminal state reply is invalid'
    mv -- "$output" "$message" || die 74 'could not publish terminal state reply draft'
}

run_state() {
    local journey='' root key item recipient now status=0 id json=no
    while (($# > 0)); do
        case "$1" in
            --json) [[ "$json" == no ]] || die 64 'duplicate --json'; json=yes; shift ;;
            --work)
                (($# >= 2)) || die 64 '--work requires a value'
                [[ -z "$journey" ]] || die 64 '--work appears more than once'
                journey="$2"; shift 2 ;;
            *) die 64 "unknown state option: $1" ;;
        esac
    done
    [[ "$journey" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die 64 '--work must be one safe non-empty token'
    require_tools jq mhdr maddr date sort
    root="$(mailbox_root)"
    progress_load "$root" "$journey"
    progress_validate_reports
    now="$(date +%s)"
    while IFS=$'\t' read -r _ item _ recipient; do
        [[ -n "$item" ]] || continue
        key="$item|$recipient"
        progress_item "$key" "$root" "$now" || status=65
        if [[ "$json" == yes ]]; then
            jq -nc --arg message_id "$item" --arg recipient "$recipient" --arg state "$P_VALUE" --arg since "$P_SINCE" --arg blocked_on "$P_BLOCKED" --arg answered "$P_ANSWERED" --arg reason "$P_REASON" '{message_id:$message_id,recipient:$recipient,state:$state,since:$since,blocked_on:$blocked_on,answered:$answered,reason:$reason}'
        else
            printf 'message_id: %s\trecipient: %s\tstate: %s\tsince: %s\tblocked_on: %s\tanswered: %s\treason: %s\n' "$item" "$recipient" "$P_VALUE" "$P_SINCE" "$P_BLOCKED" "$P_ANSWERED" "$P_REASON"
        fi
    done < <(
        for key in "${!P_ITEMS[@]}"; do
            item="${key%%|*}"
            printf '%s\t%s\t%s\t%s\n' "${P_EPOCH[$item]}" "$item" "${P_ITEMS[$key]}" "${key#*|}"
        done | sort -t $'\t' -k1,1n -k2,2 -k3,3
    )
    for id in "${!P_ANOMALY[@]}"; do
        if [[ "$json" == yes ]]; then
            jq -nc --arg id "$id" --arg reason "${P_ANOMALY[$id]}" '{anomaly:true,message_id:$id,reason:$reason}'
        else printf 'ANOMALY\tmessage_id: %s\treason: %s\n' "$id" "${P_ANOMALY[$id]}"; fi
    done | sort
    return "$status"
}

progress_authority_target() {
    local root="$1" message="$2" caller="$3" kind="$4"
    local id sender path holder journey parent references
    sender="$(maddr -a -h from: "$message")" || return 74
    parent="$(mhdr -h in-reply-to "$message" || true)"
    [[ "$parent" =~ $MESSAGE_ID_RE ]] || return 1
    journey="$(mhdr -h x-work "$message")" || return 74
    if [[ "$kind" == cancel ]]; then
        id="$parent"
        holder="$caller"
    else
        references="$(mhdr -h references "$message" || true)"
        read -r id _ <<<"$references"
        holder="$sender"
    fi
    [[ "$id" =~ $MESSAGE_ID_RE && "$holder" =~ $ADDRESS_RE ]] || return 1
    for path in "$root/$holder/new/"* "$root/$holder/cur/"*; do
        [[ -f "$path" && ! -L "$path" ]] || continue
        [[ "$(mhdr -h message-id "$path")" == "$id" ]] || continue
        [[ "$(mhdr -h delivered-to "$path")" == "$holder" &&
           "$(mhdr -h x-work "$path")" == "$journey" ]] || continue
        [[ -z "$(mhdr -h x-state "$path" || true)" &&
           "$(mhdr -h x-type "$path")" != cancel ]] || continue
        maddr -a -h to: "$path" | grep -Fqx -- "$holder" || continue
        if [[ "$kind" == cancel ]]; then
            [[ "$(maddr -a -h from: "$path")" == "$sender" ]] || continue
        fi
        printf '%s\n' "$path"
        return 0
    done
    return 1
}


filter_authorized_actions() {
    local maildir="$1" caller="$2" input="$3" output="$4" all="$5"
    local message delivered recipients replacement id expiry now
    local -A replacements=()
    now="$(date +%s)" || return 74
    # A replacement still supersedes its original after the replacement is handled.
    while IFS= read -r message; do
        delivered="$(mhdr -h delivered-to "$message")" || return 74
        [[ "$delivered" == "$caller" ]] || continue
        recipients="$(maddr -a -h to: "$message")" || return 74
        grep -Fqx -- "$caller" <<<"$recipients" || continue
        replacement="$(progress_header "$message" supersedes)" || return 74
        [[ -n "$replacement" ]] || continue
        [[ "$replacement" =~ $MESSAGE_ID_RE ]] || return 65
        replacements["$replacement"]=1
    done <"$all"
    : >"$output"
    while IFS= read -r message; do
        delivered="$(mhdr -h delivered-to "$message")" || return 74
        [[ "$delivered" == "$caller" ]] || return 65
        id="$(mhdr -h message-id "$message")" || return 74
        [[ -z "${replacements[$id]:-}" ]] || continue
        expiry="$(progress_header "$message" expiry-date)" || return 74
        if [[ -n "$expiry" ]]; then
            expiry="$(mhdr -D -h expiry-date "$message")" || return 65
            [[ "$expiry" =~ ^-?[0-9]+$ ]] || return 65
            ((expiry >= now)) || continue
        fi
        printf '%s\n' "$message" >>"$output"
    done <"$input"
}

record_seen_actions() {
    local maildir="$1"
    local caller="$2"
    local actions_file="$3"
    local seen_file="$maildir/seen.jsonl"
    local lock_file="$maildir/.seen.lock"
    local header_file="$TEMP_DIR/seen.message-id"
    local path message_id at

    [[ ! -L "$seen_file" && ! -L "$lock_file" ]] ||
        die 65 "seen-record path is unsafe: $maildir"
    exec 7>"$lock_file" || die 74 "could not open seen-record lock: $lock_file"
    flock 7 || die 74 "could not acquire seen-record lock: $lock_file"
    touch "$seen_file" || die 74 "could not create seen record: $seen_file"
    at="$(date -u +%s)" || die 74 'could not read the seen-record time'
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        read_required_header "$path" message-id "$header_file" ||
            die 74 "could not read action Message-ID: $path"
        message_id="$(<"$header_file")"
        [[ "$message_id" =~ $MESSAGE_ID_RE ]] ||
            die 65 "action has an invalid Message-ID: $path"
        if jq -s -e --arg id "$message_id" \
            'any(.[]; .message_id == $id)' "$seen_file" >/dev/null 2>&1; then
            continue
        fi
        jq -nc --arg message_id "$message_id" --arg caller "$caller" \
            --arg path "$path" --argjson at "$at" --argjson pid "$$" \
            '{version:1, message_id:$message_id, caller:$caller,
              path:$path, seen_at:$at, pid:$pid}' >>"$seen_file" ||
            die 74 "could not append seen record: $seen_file"
    done <"$actions_file"
}

read_required_header() {
    local path="$1"
    local header="$2"
    local output_file="$3"
    local error_file="$TEMP_DIR/mhdr.stderr"
    local status

    if [[ ! -r "$path" ]]; then
        printf 'reach: cannot read mailbox message: %s\n' "$path" >&2
        return 74
    fi

    : >"$error_file"
    set +e
    mhdr -h "$header" "$path" >"$output_file" 2>"$error_file"
    status=$?
    set -e
    if [[ -s "$error_file" ]]; then
        cat "$error_file" >&2
        return 74
    fi
    if ((status == 0)); then
        return 0
    fi

    printf 'reach: could not read %s header from mailbox message: %s\n' \
        "$header" "$path" >&2
    return 74
}

find_wait_match() {
    local paths_file="$1"
    local caller="$2"
    local reply_to="$3"
    local expected_from="$4"
    local header_file="$TEMP_DIR/mhdr.value"
    local path
    local delivered_to
    local type
    local parent
    local references
    local reference
    local -a senders=()

    while IFS= read -r path; do
        [[ -f "$path" ]] || continue
        read_required_header "$path" delivered-to "$header_file" || return 74
        delivered_to="$(<"$header_file")"
        [[ "$delivered_to" == "$caller" ]] || continue
        read_required_header "$path" x-type "$header_file" || return 74
        type="$(<"$header_file")"
        [[ "$type" == answer ]] || continue
        mapfile -t senders < <(maddr -a -h from: "$path")
        ((${#senders[@]} == 1)) || return 74
        [[ -z "$expected_from" || "${senders[0]}" == "$expected_from" ]] || continue
        read_required_header "$path" in-reply-to "$header_file" || return 74
        parent="$(<"$header_file")"
        if [[ "$parent" == "$reply_to" ]]; then
            printf '%s\n' "$path"
            return 0
        fi
        read_required_header "$path" references "$header_file" || return 74
        references="$(<"$header_file")"
        for reference in $references; do
            if [[ "$reference" == "$reply_to" ]]; then
                printf '%s\n' "$path"
                return 0
            fi
        done
    done <"$paths_file"
    return 1
}


resolve_reply_recipients() {
    local source="$1" output="$2" header=from recipient
    if awk 'BEGIN {IGNORECASE=1} /^\r?$/ {exit} tolower($0) ~ /^reply-to:/ {found=1} END {exit !found}' "$source"; then header=reply-to; fi
    maddr -a -h "$header:" "$source" >"$output" || die 65 "cannot parse $header"
    [[ -s "$output" ]] || die 65 "$header is blank; no reply delivered"
    while IFS= read -r recipient; do validate_address "$recipient"; done <"$output"
}

preflight_reply_destination() {
    local message="$1" root="$2" type state refs original source destination parent
    local supplied_source="${3:-}"
    type="$(mhdr -h x-type "$message")"
    state="$(progress_header "$message" x-state)"
    [[ "$type" == answer || "$state" == accepted ]] || return 0
    refs="$(mhdr -h references "$message")" || die 65 'reply requires References'
    read -r original _ <<<"$refs"
    progress_load "$root" "$(mhdr -h x-work "$message")"
    source="${P_PATH[$original]:-}"
    parent="$(mhdr -h in-reply-to "$message")"
    # A held original may itself have older RFC References. The caller-owned
    # card is the reply authority; its oldest ancestor is not a substitute.
    if [[ -n "$supplied_source" ]]; then
        source="$supplied_source"
    elif [[ "$type" == answer && -z "$state" &&
            ( "${P_TYPE[$parent]:-}" == question || "${P_TYPE[$parent]:-}" == decision ) &&
            ( -z "${P_STATE[$parent]:-}" || "${P_STATE[$parent]:-}" == requires-action ) ]]; then
        source="${P_PATH[$parent]}"
    fi
    [[ -n "$source" ]] || die 65 "original work card unavailable: $original"
    "$LINTER" "$source"
    resolve_reply_recipients "$source" "$TEMP_DIR/resolved-reply"
    maddr -a -h to: "$message" >"$TEMP_DIR/reply-to"
    while IFS= read -r destination; do
        grep -Fxq -- "$destination" "$TEMP_DIR/reply-to" || die 65 "reply To must include original work destination: $destination"
    done <"$TEMP_DIR/resolved-reply"
}

ring_remote() {
    local root="$1" sender="$2" recipient="$3" remaining="$4" wire="$TEMP_DIR/ring-remote"
    printf 'SNO-REACH-REMOTE/1\nRING\n' >"$wire"
    append_text_frame "$wire" root "$root"
    append_text_frame "$wire" address "$recipient"
    append_text_frame "$wire" sender "$sender"
    execute_fixed_request "$wire" "$recipient" '^(rang|rang-unverified|busy)$' "$remaining"
}

ring_delivered() {
    local root="$1" sender="$2" message="$3" delivered="${4:-}"
    local recipient id rc outcome remaining automatic
    [[ "$(progress_header "$message" x-no-reply)" != true ]] || return 0
    automatic="$(progress_header "$message" auto-submitted)"
    [[ -z "$automatic" || "${automatic,,}" == no ]] || return 0
    id="$(mhdr -h message-id "$message")"
    maddr -a -h to: "$message" | sort -u >"$TEMP_DIR/ring-recipients"
    while IFS= read -r recipient; do
        [[ -z "$delivered" ]] || grep -Fxq -- "$recipient" "$delivered" || continue
        remaining=$((NOTIFICATION_DEADLINE - SECONDS))
        if ((remaining <= 0)); then
            printf 'reach: message delivered; notification deadline reached for %s. Read the mailbox; do not resend.\n' "$recipient" >&2
            continue
        fi
        if [[ "${recipient##*@}" != "${sender##*@}" ]]; then
            if outcome="$(ring_remote "$root" "$sender" "$recipient" "$remaining" </dev/null)"; then rc=0; else rc=6; fi
        else
            rc=0
            outcome="$(SNO_REACH_ROOT="$root" timeout --foreground --signal=TERM --kill-after=5 "$remaining" "$REPO_ROOT/lib/reach-ring" doorbell --to "$recipient" --from "$sender" --msg-id "$id" </dev/null)" || rc=$?
            outcome="${outcome%%$'\n'*}"
            outcome="${outcome#outcome=}"
            case "$outcome" in rang|rang-unverified|busy) ;; *) rc=6 ;; esac
        fi
        if ((rc != 0)); then
            printf 'reach: message delivered; notification failed for %s. No retry is scheduled; read the mailbox, do not resend.\n' "$recipient" >&2
        else
            printf 'reach: notification %s for %s; no retry is scheduled\n' "$outcome" "$recipient" >&2
        fi
    done <"$TEMP_DIR/ring-recipients"
    return 0
}

run_send() {
    local input_file message_type root status no_ring=no argument
    local started recipient
    local -a args=() authors=()
    for argument in "$@"; do
        if [[ "$argument" == --no-ring ]]; then [[ "$no_ring" == no ]] || die 64 'duplicate --no-ring'; no_ring=yes
        else args+=("$argument"); fi
    done
    parse_as_only "${args[@]}"
    make_temp_dir
    input_file="$TEMP_DIR/send-message"
    cat >"$input_file" || die 74 'cannot snapshot input'
    "$LINTER" "$input_file"
    mapfile -t authors < <(maddr -a -h from: "$input_file")
    [[ "${#authors[@]}" == 1 && "${authors[0]}" == "$CALLER" ]] || die 65 'From must equal --as'
    case "$(progress_header "$input_file" x-state)" in
        completed|failed|cancelled|refused) die 65 'terminal X-State requires reply --state; send delivered nothing' ;;
    esac
    message_type="$(mhdr -h x-type "$input_file")"
    preflight_send_headers "$input_file" "$message_type"
    root="$(mailbox_root)"
    require_safe_caller_dir "$root" "$CALLER" >/dev/null
    preflight_strict_recipient_registry "$input_file" "$root" "$CALLER"
    preflight_recipient_reachability "$root" "$CALLER" "$input_file" "$message_type"
    preflight_reply_destination "$input_file" "$root"
    preflight_send_rate_limit "$root" "$input_file" "$message_type"
    started="$EPOCHREALTIME"
    status=0
    queue_and_attempt_message "$root" "$CALLER" "$input_file" || status=$?
    while IFS= read -r recipient; do
        observe_message "$root" card "$CALLER" "$recipient" "$status" "$started"
    done <"$TEMP_DIR/validated-recipients"
    [[ "$no_ring" == yes ]] || ring_delivered "$root" "$CALLER" "$input_file" "$TEMP_DIR/delivered-recipients"
    ((status == 0)) || die 74 'one or more copies remain queued; do not resend'
}


run_inbox() {
    local root maildir path subject cc=no
    local -a args=()
    while (($#)); do
        if [[ "$1" == --cc ]]; then [[ "$cc" == no ]] || die 64 'duplicate --cc'; cc=yes; shift
        else args+=("$1"); shift; fi
    done
    parse_as_only "${args[@]}"
    root="$(mailbox_root)"
    require_local_reader_address "$root" "$CALLER"
    maildir="$root/$CALLER"
    make_temp_dir
    if [[ "$cc" == yes ]]; then
        list_informed "$maildir" "$CALLER" "$TEMP_DIR/informed" || die 74 'cannot inspect informed copies'
        cat "$TEMP_DIR/informed"
    else
        list_actions "$maildir" "$CALLER" "$TEMP_DIR/actions" || die 74 'cannot inspect action queue'
        record_seen_actions "$maildir" "$CALLER" "$TEMP_DIR/actions"
        while IFS= read -r path; do
            subject="$(mhdr -h subject "$path")" || die 74 'cannot read action subject'
            printf '%s\t%s\n' "$path" "$subject"
        done <"$TEMP_DIR/actions"
    fi
}


run_wait() {
    local root maildir started elapsed remaining sleep_for match rc path sender
    parse_poll_options "$@"
    root="$(mailbox_root)"
    require_local_reader_address "$root" "$CALLER"
    maildir="$root/$CALLER"
    make_temp_dir
    started=$SECONDS
    while :; do
        if [[ -n "$REPLY_TO" ]]; then
            scan_maildir_paths "$maildir" "$TEMP_DIR/wait.paths" || die 74 'cannot scan mailbox'
            if match="$(find_wait_match "$TEMP_DIR/wait.paths" "$CALLER" "$REPLY_TO" "$EXPECTED_FROM")"; then
                printf '%s\n' "$match" >"$TEMP_DIR/selected"
                record_seen_actions "$maildir" "$CALLER" "$TEMP_DIR/selected"
                printf '%s\n' "$match"; return 0
            else rc=$?; ((rc == 1)) || die "$rc" 'cannot inspect answer'; fi
        else
            list_actions "$maildir" "$CALLER" "$TEMP_DIR/wait.paths" || die 74 'cannot inspect action queue'
            while IFS= read -r path; do
                sender="$(maddr -a -h from: "$path")" || die 74 'cannot inspect sender'
                [[ -z "$EXPECTED_FROM" || "$sender" == "$EXPECTED_FROM" ]] || continue
                printf '%s\n' "$path" >"$TEMP_DIR/selected"
                record_seen_actions "$maildir" "$CALLER" "$TEMP_DIR/selected"
                printf '%s\n' "$path"; return 0
            done <"$TEMP_DIR/wait.paths"
        fi
        elapsed=$((SECONDS - started))
        ((elapsed < TIMEOUT_SECS)) || return 4
        [[ -z "$IDLE_SECS" ]] || ((elapsed < IDLE_SECS)) || return 4
        remaining=$((TIMEOUT_SECS - elapsed))
        if [[ -n "$IDLE_SECS" ]] && ((IDLE_SECS - elapsed < remaining)); then remaining=$((IDLE_SECS - elapsed)); fi
        sleep_for="$INTERVAL_SECS"
        ((sleep_for <= remaining)) || sleep_for="$remaining"
        sleep "$sleep_for"
    done
}


authorize_reply_source() {
    local maildir="$1"
    local requested_path="$2"
    local operation="${3:-reply}"
    local new_dir
    local cur_dir
    local canonical
    local parent

    [[ ! -L "$requested_path" ]] ||
        die 65 "$operation source must not be a symbolic link: $requested_path"
    canonical="$(realpath -e -- "$requested_path")" ||
        die 66 "$operation source does not exist: $requested_path"
    [[ -f "$canonical" && ! -L "$canonical" ]] ||
        die 66 "$operation source is not a regular file: $requested_path"

    new_dir="$(realpath -e -- "$maildir/new")" ||
        die 73 "caller new directory is unavailable: $maildir/new"
    cur_dir="$(realpath -e -- "$maildir/cur")" ||
        die 73 "caller cur directory is unavailable: $maildir/cur"
    parent="$(dirname -- "$canonical")"
    if [[ "$parent" != "$new_dir" && "$parent" != "$cur_dir" ]]; then
        die 65 "$operation source is outside the caller-owned Maildir: $requested_path"
    fi

    printf '%s\n' "$canonical"
}

move_reply_source_to_cur() {
    local source="$1"
    local new_dir="$2"
    local cur_dir="$3"
    local parent
    local base
    local destination
    local attempt=0

    parent="$(dirname -- "$source")"
    if [[ "$parent" == "$cur_dir" ]]; then
        base="$(basename -- "$source")"
        [[ "$base" == *':2,'* ]] ||
            die 65 "caller cur source lacks a Maildir flag suffix: $source"
        [[ "${base##*:2,}" != *R* ]] ||
            die 65 "caller source is already marked replied: $source"
        printf '%s\n' "$source"
        return 0
    fi
    [[ "$parent" == "$new_dir" ]] ||
        die 65 "reply source is outside the caller Maildir: $source"

    base="$(basename -- "$source")"
    while true; do
        if ((attempt == 0)); then
            destination="$cur_dir/$base:2,"
        else
            destination="$cur_dir/$base.$attempt:2,"
        fi
        if [[ -e "$destination" || -L "$destination" ]]; then
            ((attempt += 1))
            continue
        fi
        if ! mv -n -- "$source" "$destination"; then
            die 74 "could not move reply source to caller cur: $source"
        fi
        if [[ ! -e "$source" && -f "$destination" ]]; then
            printf '%s\n' "$destination"
            return 0
        fi
        [[ -e "$source" ]] ||
            die 74 "reply source move produced an unverifiable state: $source"
        ((attempt += 1))
    done
}

normalize_reply_source() {
    local source="$1"
    local output_file="$2"
    local header_file="$TEMP_DIR/mhdr.value"
    local subject
    local normalized

    read_required_header "$source" subject "$header_file" ||
        die 74 "could not read reply source subject: $source"
    subject="$(<"$header_file")"
    if [[ "$subject" =~ ^(Re:\ )?\[(QUESTION|DECISION|ANSWER|FYI|STATUS|DONE)\](.*)$ ]]; then
        normalized="[ANSWER]${BASH_REMATCH[3]}"
    else
        die 65 "reply source has a non-canonical subject: $source"
    fi

    if ! REACH_REPLY_SUBJECT="$normalized" awk '
        BEGIN { in_headers = 1 }
        {
            line = $0
            sub(/\r$/, "", line)
            colon = index(line, ":")
            if (in_headers && !changed && colon > 0 &&
                tolower(substr(line, 1, colon - 1)) == "subject") {
                print "Subject: " ENVIRON["REACH_REPLY_SUBJECT"]
                changed = 1
                next
            }
            print
            if (line == "")
                in_headers = 0
        }
        END { if (!changed) exit 1 }
    ' "$source" >"$output_file"; then
        die 74 "could not create reply source snapshot: $source"
    fi
}

write_reply_support_files() {
    local profile_dir="$1"
    local helper="$2"
    local caller="$3"
    local name="$4"
    local journey="$5"

    mkdir -p -- "$profile_dir" "$TEMP_DIR/home" "$TEMP_DIR/work" \
        "$TEMP_DIR/mrep-tmp" ||
        die 74 'could not create private reply support directories'
    printf 'Local-Mailbox: %s <%s>\nReply-From: %s <%s>\nSendmail: %s\nSendmail-Args: -t\n' \
        "$name" "$caller" "$name" "$caller" "$helper" \
        >"$profile_dir/profile" ||
        die 74 'could not write private mblaze profile'
    local type=answer
    [[ "$REPLY_STATE" != accepted ]] || type=status
    printf 'X-Work: %s\nX-Type: %s\nX-Name: %s\n' \
        "$journey" "$type" "$name" >"$profile_dir/headers" ||
        die 74 'could not write private reply headers'
    if [[ -n "$REPLY_STATE" ]]; then
        printf 'X-State: %s\n' "$REPLY_STATE" >>"$profile_dir/headers" ||
            die 74 'could not write reply state header'
    fi
    : >"$profile_dir/sequence"
    : >"$profile_dir/current"

    # These are literal lines of the generated sender, not this shell's values.
    # shellcheck disable=SC2016
    printf '%s\n' \
        '#!/usr/bin/env bash' \
        'set -Eeuo pipefail' \
        'if (($# != 1)) || [[ "$1" != -t ]]; then' \
        '    printf "%s\n" "reach reply sender: expected only -t" >&2' \
        '    exit 64' \
        'fi' \
        ': "${REACH_REPLY_INPUT:?missing reply input path}"' \
        ': "${REACH_MSED:?missing msed path}"' \
        ': "${REACH_LINTER:?missing linter path}"' \
        '"$REACH_MSED" "/bcc/d" - |' \
        '    sed "/^[Cc][Cc]:[[:space:]]*$/d" >"$REACH_REPLY_INPUT"' \
        '"$REACH_LINTER" "$REACH_REPLY_INPUT"' \
        >"$helper" ||
        die 74 'could not write private reply sender'
    chmod 700 "$helper" ||
        die 74 'could not make private reply sender executable'
}

mark_reply_source() {
    local source="$1"
    local cur_dir="$2"
    local output_file="$TEMP_DIR/mflag.output"
    local error_file="$TEMP_DIR/mflag.stderr"
    local status
    local flagged
    local prefix="${source%%:2,*}:2,"
    local flags
    local canonical_source
    local canonical_cur
    local -a outputs=()

    [[ -f "$source" && ! -L "$source" ]] ||
        die 65 "reply flag source is not a regular caller file: $source"
    canonical_source="$(realpath -e -- "$source")" ||
        die 65 "reply flag source cannot be resolved: $source"
    canonical_cur="$(realpath -e -- "$cur_dir")" ||
        die 65 "caller cur cannot be resolved: $cur_dir"
    [[ "$(dirname -- "$canonical_source")" == "$canonical_cur" ]] ||
        die 65 "reply flag source is outside caller cur: $source"
    [[ "$(basename -- "$source")" == *':2,'* ]] ||
        die 65 "reply flag source lacks a Maildir flag suffix: $source"

    set +e
    MAILSEQ=/dev/null MAILCUR=/dev/null \
        mflag -R -- "$source" >"$output_file" 2>"$error_file"
    status=$?
    set -e
    if ((status != 0)) || [[ -s "$error_file" ]]; then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        die 74 "could not mark caller reply source: $source"
    fi
    mapfile -t outputs <"$output_file"
    ((${#outputs[@]} == 1)) ||
        die 74 "reply flag operation did not rename caller source: $source"
    flagged="${outputs[0]}"
    flags="${flagged##*:2,}"
    [[ "$flagged" == "$prefix"* && "$flags" == *R* &&
       ! -e "$source" && -f "$flagged" ]] ||
        die 74 "reply flag transition could not be verified: $source"
}

mark_dismissed_source() {
    local source="$1"
    local cur_dir="$2"
    local output_file="$TEMP_DIR/mflag.output"
    local error_file="$TEMP_DIR/mflag.stderr"
    local status
    local flagged
    local prefix="${source%%:2,*}:2,"
    local flags
    local canonical_source
    local canonical_cur
    local -a outputs=()

    [[ -f "$source" && ! -L "$source" ]] ||
        die 65 "dismiss source is not a regular caller file: $source"
    canonical_source="$(realpath -e -- "$source")" ||
        die 65 "dismiss source cannot be resolved: $source"
    canonical_cur="$(realpath -e -- "$cur_dir")" ||
        die 65 "caller cur cannot be resolved: $cur_dir"
    [[ "$(dirname -- "$canonical_source")" == "$canonical_cur" ]] ||
        die 65 "dismiss source is outside caller cur: $source"

    set +e
    MAILSEQ=/dev/null MAILCUR=/dev/null \
        mflag -T -- "$source" >"$output_file" 2>"$error_file"
    status=$?
    set -e
    if ((status != 0)) || [[ -s "$error_file" ]]; then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        die 74 "could not mark caller source dismissed: $source"
    fi
    mapfile -t outputs <"$output_file"
    ((${#outputs[@]} == 1)) ||
        die 74 "dismiss flag operation did not rename caller source: $source"
    flagged="${outputs[0]}"
    flags="${flagged##*:2,}"
    [[ "$flagged" == "$prefix"* && "$flags" == *T* &&
       "$flags" != *R* && ! -e "$source" && -f "$flagged" ]] ||
        die 74 "dismiss flag transition could not be verified: $source"
    printf '%s\n' "$flagged"
}

append_dismissal_record() {
    local maildir="$1"
    local message_id="$2"
    local source="$3"
    local dismissed_at="$4"
    local audit_file="$maildir/dismissals.jsonl"
    local lock_file="$maildir/.dismissals.lock"

    [[ ! -L "$audit_file" && ! -L "$lock_file" ]] ||
        die 65 'dismissal audit paths must not be symbolic links'
    exec 9>"$lock_file" ||
        die 74 'could not open caller dismissal audit lock'
    flock 9 ||
        die 74 'could not acquire caller dismissal audit lock'
    printf '{"message_id":"%s","path":"%s","caller":"%s","name":"%s","dismissed_at":"%s","reason":"%s"}\n' \
        "$(json_escape "$message_id")" "$(json_escape "$source")" \
        "$(json_escape "$CALLER")" "$(json_escape "$NAME")" \
        "$dismissed_at" "$(json_escape "$REASON")" >>"$audit_file" ||
        die 74 'could not append caller dismissal audit record'
    flock -u 9 ||
        die 74 'could not release caller dismissal audit lock'
    exec 9>&-
}

run_dismiss() {
    local started recipient
    local root
    local maildir
    local source
    local new_dir
    local cur_dir
    local delivered_to
    local message_id
    local header_file
    local flags
    local dismissed_at
    local status

    parse_dismiss_options "$@"
    [[ -x "$LINTER" ]] || die 69 "header linter is unavailable: $LINTER"
    require_tools flock maddr mflag mhdr realpath

    root="$(mailbox_root)"
    require_local_reader_address "$root" "$CALLER"
    maildir="$root/$CALLER"
    require_maildir "$maildir"
    NAME="$(jq -r .name "$maildir/seat.json")"
    source="$(authorize_reply_source "$maildir" "$MESSAGE" dismiss)"

    set +e
    "$LINTER" "$source"
    status=$?
    set -e
    ((status == 0)) || exit "$status"

    make_temp_dir
    header_file="$TEMP_DIR/mhdr.value"
    read_required_header "$source" delivered-to "$header_file" ||
        die 74 "could not read dismiss source recipient: $source"
    delivered_to="$(<"$header_file")"
    [[ "$delivered_to" == "$CALLER" ]] ||
        die 65 "dismiss source Delivered-To does not equal --as caller: $CALLER"

    read_required_header "$source" message-id "$header_file" ||
        die 74 "could not read dismiss source Message-ID: $source"
    message_id="$(<"$header_file")"
    [[ "$message_id" =~ $MESSAGE_ID_RE ]] ||
        die 65 "dismiss source has an invalid Message-ID: $source"

    if [[ "$(basename -- "$source")" == *':2,'* ]]; then
        flags="${source##*:2,}"
        [[ "$flags" != *R* ]] ||
            die 65 "caller source is already marked replied: $source"
        [[ "$flags" != *T* ]] ||
            die 65 "caller source is already marked dismissed: $source"
    fi

    local type
    type="$(mhdr -h x-type "$source")"
    if maddr -a -h to: "$source" | grep -Fxq -- "$CALLER"; then
        case "$type" in status|answer) ;; *) die 65 'actionable work requires reply; dismiss only acknowledges reports or informed copies' ;; esac
    fi
    new_dir="$(realpath -e -- "$maildir/new")" ||
        die 73 "caller new directory is unavailable: $maildir/new"
    cur_dir="$(realpath -e -- "$maildir/cur")" ||
        die 73 "caller cur directory is unavailable: $maildir/cur"
    recipient="$(maddr -a -h from: "$source")"
    started="$EPOCHREALTIME"
    source="$(move_reply_source_to_cur "$source" "$new_dir" "$cur_dir")"
    status=0
    source="$(mark_dismissed_source "$source" "$cur_dir")" || status=$?
    observe_message "$root" dismiss "$CALLER" "$recipient" "$status" "$started"
    ((status == 0)) || return "$status"
    dismissed_at="$(utc_now)"
    append_dismissal_record \
        "$maildir" "$message_id" "$source" "$dismissed_at"
    printf '%s\n' "$source"
}

run_reply() {
    local started recipient
    local root
    local maildir
    local source
    local new_dir
    local cur_dir
    local delivered_to
    local journey
    local header_file
    local address_file
    local error_file
    local body_file
    local source_snapshot
    local profile_dir
    local helper
    local reply_input
    local entry
    local status

    parse_reply_options "$@"
    [[ -x "$LINTER" ]] || die 69 "header linter is unavailable: $LINTER"
    [[ -x "$DELIVER" ]] || die 69 "local delivery command is unavailable: $DELIVER"
    require_tools maddr mflag mhdr mrep msed realpath

    root="$(mailbox_root)"
    require_local_reader_address "$root" "$CALLER"
    maildir="$root/$CALLER"
    require_maildir "$maildir"
    NAME="$(jq -r .name "$maildir/seat.json")"
    source="$(authorize_reply_source "$maildir" "$MESSAGE")"

    if [[ "$source" == *':2,'* ]]; then
        [[ "${source##*:2,}" != *R* ]] || die 65 "reply source carries flag R, already replied: $source"
        [[ "${source##*:2,}" != *T* ]] || die 65 "reply source carries flag T, already dismissed: $source"
    fi

    set +e
    "$LINTER" "$source"
    status=$?
    set -e
    ((status == 0)) || exit "$status"

    make_temp_dir
    header_file="$TEMP_DIR/mhdr.value"
    read_required_header "$source" delivered-to "$header_file" ||
        die 74 "could not read reply source recipient: $source"
    delivered_to="$(<"$header_file")"
    [[ "$delivered_to" == "$CALLER" ]] ||
        die 65 "reply source Delivered-To does not equal --as caller: $CALLER"

    address_file="$TEMP_DIR/cc.addresses"
    error_file="$TEMP_DIR/maddr.stderr"
    : >"$error_file"
    set +e
    maddr -a -h cc: "$source" >"$address_file" 2>"$error_file"
    status=$?
    set -e
    if ((status != 0)) || [[ -s "$error_file" ]]; then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        die 74 "could not read reply source Cc addresses: $source"
    fi
    if grep -Fqx -- "$CALLER" "$address_file" && ! maddr -a -h to: "$source" | grep -Fqx -- "$CALLER"; then
        die 65 "reply source is an informed Cc copy and is not actionable: $CALLER"
    fi

    read_required_header "$source" x-work "$header_file" ||
        die 74 "could not read reply source journey: $source"
    journey="$(<"$header_file")"
    [[ "$journey" =~ $TOKEN_RE ]] ||
        die 65 "reply source has an invalid X-Work: $source"

    prepare_reply_progress "$source" "$root" "$journey"

    local reply_fd
    exec {reply_fd}<"$source" || die 66 'reply source disappeared'
    flock -x -w 5 "$reply_fd" || die 75 'another reply is in progress'
    prepare_reply_progress "$source" "$root" "$journey"

    body_file="$TEMP_DIR/reply-body"
    cat >"$body_file" ||
        die 74 'could not snapshot the reply body'
    grep -q '[^[:space:]]' "$body_file" ||
        die 65 'reply body is empty; reach reply reads the body from stdin, so pipe or redirect the text to send'

    new_dir="$(realpath -e -- "$maildir/new")" ||
        die 73 "caller new directory is unavailable: $maildir/new"
    cur_dir="$(realpath -e -- "$maildir/cur")" ||
        die 73 "caller cur directory is unavailable: $maildir/cur"
    [[ -w "$cur_dir" && -x "$cur_dir" ]] ||
        die 74 "reply source cannot move into caller cur: $source"

    source_snapshot="$TEMP_DIR/reply-source"
    normalize_reply_source "$source" "$source_snapshot"
    resolve_reply_recipients "$source" "$TEMP_DIR/reply-destinations"
    if [[ "$REPLY_STATE" == accepted ]]; then
        sed -i 's/^\(Subject: \)\[ANSWER\]/\1[STATUS]/' "$source_snapshot"
    fi
    profile_dir="$TEMP_DIR/mblaze"
    helper="$TEMP_DIR/sendmail"
    reply_input="$TEMP_DIR/reply-message"
    write_reply_support_files \
        "$profile_dir" "$helper" "$CALLER" "$NAME" "$journey"

    set +e
    (
        cd "$TEMP_DIR/work" || exit 74
        HOME="$TEMP_DIR/home" \
        TMPDIR="$TEMP_DIR/mrep-tmp" \
        MBLAZE="$profile_dir" \
        MAILSEQ="$profile_dir/sequence" \
        MAILCUR="$profile_dir/current" \
        SIGNATURE='' \
        SNO_REACH_ROOT="$root" \
        REACH_REPLY_INPUT="$reply_input" \
        REACH_MSED="$REPO_ROOT/vendor/bin/msed" \
        REACH_LINTER="$LINTER" \
            mrep -send -body "$body_file" -- "$source_snapshot"
    )
    status=$?
    set -e
    ((status == 0)) ||
        die 74 "reply delivery failed; caller source remains unreplied: $source"

    # mrep supplies quoting and headers. The original card alone supplies recipients.
    REACH_REPLY_DESTINATIONS="$(paste -sd, "$TEMP_DIR/reply-destinations")" awk '
        BEGIN {headers=1; skip=0}
        headers && /^\r?$/ {headers=0; skip=0}
        headers && /^[ \t]/ {if (!skip) print; next}
        headers {
            skip=0
            field=tolower(substr($0,1,index($0,":")-1))
            if (field=="to" || field=="cc" || field=="bcc") {
                skip=1
                if (field=="to") print "To: " ENVIRON["REACH_REPLY_DESTINATIONS"]
                next
            }
        }
        {print}
    ' "$reply_input" >"$TEMP_DIR/routed-reply"
    mv -- "$TEMP_DIR/routed-reply" "$reply_input"
    if [[ -n "$REPLY_STATE" ]]; then
        thread_state_reply "$reply_input" "$TEMP_DIR/state-reply"
    fi

    set +e
    preflight_strict_recipient_registry "$reply_input" "$root" "$CALLER"
    status=$?
    set -e
    ((status == 0)) || return "$status"

    preflight_recipient_reachability "$root" "$CALLER" "$reply_input" "$(mhdr -h x-type "$reply_input")"
    preflight_reply_destination "$reply_input" "$root" "$source"
    if [[ "$REPLY_STATE" != accepted ]]; then
        source="$(move_reply_source_to_cur "$source" "$new_dir" "$cur_dir")"
    fi
    entry="$(stage_message_in_outbox "$root" "$CALLER" "$reply_input")"
    set +e
    if [[ "$REPLY_STATE" != accepted ]]; then (mark_reply_source "$source" "$cur_dir"); fi
    status=$?
    set -e
    if ((status != 0)); then
        die 74 "reply is queued but source flag could not be verified: $entry"
    fi
    started="$EPOCHREALTIME"
    status=0
    attempt_outbox_entry "$root" "$CALLER" "$entry" || status=$?
    flock -u "$reply_fd"
    exec {reply_fd}<&-
    while IFS= read -r recipient; do
        observe_message "$root" reply "$CALLER" "$recipient" "$status" "$started"
    done <"$TEMP_DIR/validated-recipients"
    if ((status == 0)) && [[ "${SNO_REACH_REPLY_RECEIPT:-0}" == 1 ]]; then
        read_required_header "$reply_input" message-id "$header_file" ||
            die 74 'could not read the delivered reply Message-ID'
        printf '%s\n' "$(<"$header_file")"
    fi
    ring_delivered "$root" "$CALLER" "$reply_input" "$TEMP_DIR/delivered-recipients"
    if ((status != 0)); then
        die 74 "reply delivery failed; queued for explicit flush: $entry"
    fi
}

collect_export_paths() {
    local root="$1"
    local paths="$2"
    local mailboxes_raw="$TEMP_DIR/export-mailboxes.raw"
    local mailboxes="$TEMP_DIR/export-mailboxes"
    local paths_raw="$TEMP_DIR/export-paths.raw"
    local component_paths="$TEMP_DIR/export-component.paths"
    local mailbox
    local component

    if ! find "$root" -mindepth 1 -maxdepth 1 -print0 >"$mailboxes_raw"; then
        die 74 'could not enumerate direct mailboxes for export'
    fi
    sort -z "$mailboxes_raw" >"$mailboxes" ||
        die 74 'could not sort direct mailboxes for export'
    : >"$paths_raw"
    while IFS= read -r -d '' mailbox; do
        [[ "${mailbox##*/}" =~ $ADDRESS_RE ]] || continue
        [[ -d "$mailbox" && ! -L "$mailbox" ]] ||
            die 65 "direct mailbox is unsafe: $mailbox"
        for component in tmp new cur; do
            [[ -d "$mailbox/$component" && ! -L "$mailbox/$component" ]] ||
                die 65 "Maildir component is unsafe: $mailbox/$component"
        done
        for component in new cur; do
            if ! find "$mailbox/$component" -mindepth 1 -maxdepth 1 \
                    -print0 >"$component_paths"; then
                die 74 "could not enumerate Maildir component: $mailbox/$component"
            fi
            cat "$component_paths" >>"$paths_raw" ||
                die 74 'could not collect export source paths'
        done
    done <"$mailboxes"
    sort -z "$paths_raw" >"$paths" ||
        die 74 'could not sort export source paths'

}

run_export() {
    local journey=''
    local output=''
    local root
    local canonical_output
    local output_parent
    local candidate
    local staged
    local metadata
    local sorted_metadata
    local path
    local normalized
    local header_file
    local error_file
    local journey_value
    local message_id
    local date_value
    local epoch
    local separator_date
    local status
    local count=0
    local selected_before
    local selected_after
    local paths_before
    local identity
    local digest
    local before_identity
    local before_digest
    local snapshot_attempt

    while (($# > 0)); do
        case "$1" in
            --work)
                (($# >= 2)) || usage
                [[ -z "$journey" ]] ||
                    die 64 '--work appears more than once'
                journey="$2"
                shift 2
                ;;
            --output)
                (($# >= 2)) || usage
                [[ -z "$output" ]] ||
                    die 64 '--output appears more than once'
                output="$2"
                shift 2
                ;;
            *)
                die 64 "unknown option: $1"
                ;;
        esac
    done
    [[ "$journey" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] ||
        die 64 '--work must be one safe non-empty token'
    [[ -n "$output" ]] || die 64 '--output is required'
    [[ "$output" != *$'\n'* && "$output" != *$'\r'* &&
       "$output" != *$'\t'* ]] ||
        die 64 '--output contains a control character'

    require_tools awk cmp date find mhdr realpath sed sha256sum sort stat sync
    [[ -x "$LINTER" ]] ||
        die 69 "header linter is unavailable: $LINTER"
    root="$(mailbox_root)"
    root="$(realpath -e -- "$root")" ||
        die 73 'mailbox root is unavailable'
    [[ -d "$root" ]] || die 73 "mailbox root is not a directory: $root"
    canonical_output="$(realpath -m -- "$output")" ||
        die 73 'could not canonicalize export output'
    case "$canonical_output" in
        "$root"|"$root"/*)
            die 65 'export output must be outside the mailbox root'
            ;;
    esac
    output_parent="$(dirname -- "$output")"
    [[ -d "$output_parent" && ! -L "$output_parent" ]] ||
        die 73 "export parent is unavailable or unsafe: $output_parent"
    if [[ -e "$output" || -L "$output" ]]; then
        [[ -f "$output" && ! -L "$output" ]] ||
            die 65 "export path is unsafe: $output"
    fi

    make_temp_dir
    mkdir -- "$TEMP_DIR/messages" ||
        die 74 'could not initialize export snapshots'
    metadata="$TEMP_DIR/export.metadata"
    sorted_metadata="$TEMP_DIR/export.sorted"
    candidate="$TEMP_DIR/export.reach"
    header_file="$TEMP_DIR/header.value"
    error_file="$TEMP_DIR/header.stderr"
    selected_before="$TEMP_DIR/export-selected-before.tsv"
    selected_after="$TEMP_DIR/export-selected-after.tsv"
    paths_before="$TEMP_DIR/export-paths-before"
    for snapshot_attempt in 1 2; do
        count=0
        : >"$metadata"
        : >"$selected_before"
        find "$TEMP_DIR/messages" -mindepth 1 -maxdepth 1 -type f -delete ||
            die 74 'could not reset export message snapshots'
        collect_export_paths "$root" "$paths_before"

        while IFS= read -r -d '' path; do
                if [[ ! -e "$path" && ! -L "$path" ]]; then
                    ((snapshot_attempt == 1)) && continue 2
                    die 65 'mailbox changed twice during export; retry after mailbox activity stops'
                fi
                [[ -f "$path" && ! -L "$path" ]] ||
                    die 65 "Maildir message path is unsafe: $path"
                [[ "$path" != *$'\t'* && "$path" != *$'\n'* &&
                   "$path" != *$'\r'* ]] ||
                    die 65 "Maildir message path contains a control: $path"
                : >"$error_file"
                set +e
                mhdr -h x-work "$path" >"$header_file" 2>"$error_file"
                status=$?
                set -e
                if ((status != 0)); then
                    if [[ ! -e "$path" && ! -L "$path" ]]; then
                        ((snapshot_attempt == 1)) && continue 2
                        die 65 'mailbox changed twice during export; retry after mailbox activity stops'
                    fi
                    continue
                fi
                [[ ! -s "$error_file" ]] || {
                    cat "$error_file" >&2
                    die 65 "could not inspect journey header: $path"
                }
                journey_value="$(<"$header_file")"
                [[ "$journey_value" == "$journey" ]] || continue

                identity="$(stat -c '%d:%i:%s:%Y:%Z' "$path")" ||
                    die 74 "could not inspect selected export message: $path"
                digest="$(sha256sum "$path" | cut -d ' ' -f 1)" ||
                    die 74 "could not hash selected export message: $path"
                printf '%s\t%s\t%s\n' "$path" "$identity" "$digest" >>"$selected_before" ||
                    die 74 'could not record selected export messages'

                if ! awk '
                    {
                        line = $0
                        sub(/\r$/, "", line)
                        if (index(line, "\r"))
                            exit 1
                    }
                ' "$path"; then
                    die 65 "selected export message contains bare CR: $path"
                fi
                if [[ -s "$path" &&
                      "$(tail -c 1 "$path" | od -An -tu1 | tr -d ' ')" == 13 ]]; then
                    die 65 "selected export message ends with bare CR: $path"
                fi

                count=$((count + 1))
                normalized="$TEMP_DIR/messages/$count"
                sed 's/\r$//' "$path" >"$normalized" ||
                    die 74 "could not normalize selected message: $path"
                set +e
                "$LINTER" "$normalized" >"$TEMP_DIR/lint.out" 2>"$TEMP_DIR/lint.err"
                status=$?
                set -e
                if ((status != 0)); then
                    [[ ! -s "$TEMP_DIR/lint.err" ]] ||
                        cat "$TEMP_DIR/lint.err" >&2
                    die 65 "selected export message is invalid: $path"
                fi

                read_required_header "$normalized" message-id "$header_file" ||
                    die 65 "selected export Message-ID is unavailable: $path"
                message_id="$(<"$header_file")"
                read_required_header "$normalized" date "$header_file" ||
                    die 65 "selected export Date is unavailable: $path"
                date_value="$(<"$header_file")"
                set +e
                epoch="$(date -u -d "$date_value" +%s 2>"$error_file")"
                status=$?
                set -e
                if ((status != 0)) || [[ -s "$error_file" ]] ||
                   [[ ! "$epoch" =~ ^-?[0-9]+$ ]]; then
                    [[ ! -s "$error_file" ]] || cat "$error_file" >&2
                    die 65 "selected export Date is invalid: $path"
                fi
                printf '%s\t%s\t%s\t%s\n' \
                    "$epoch" "$message_id" "$path" "$normalized" >>"$metadata" ||
                    die 74 'could not write export sort metadata'
        done <"$paths_before"

        sort -t $'\t' -k1,1n -k2,2 -k3,3 "$metadata" >"$sorted_metadata" ||
            die 74 'could not sort selected export messages'
        : >"$candidate"
        while IFS=$'\t' read -r epoch message_id path normalized; do
        [[ -n "$normalized" ]] || continue
        separator_date="$(date -u -d "@$epoch" '+%a %b %e %H:%M:%S %Y')" ||
            die 74 "could not format selected export Date: $path"
        {
            printf 'From MAILER-DAEMON %s\n' "$separator_date"
            awk '
                BEGIN { body = 0 }
                {
                    if (body && $0 ~ /^>*From /)
                        print ">" $0
                    else
                        print
                    if (!body && $0 == "")
                        body = 1
                }
                END {
                    if (!body)
                        exit 1
                    print ""
                }
            ' "$normalized"
        } >>"$candidate" ||
            die 65 "could not render selected export message: $path"
        done <"$sorted_metadata"

        : >"$selected_after"
        while IFS=$'\t' read -r path before_identity before_digest; do
        if [[ ! -e "$path" && ! -L "$path" ]]; then
            ((snapshot_attempt == 1)) && continue 2
            die 65 'mailbox changed twice during export; retry after mailbox activity stops'
        fi
        [[ -f "$path" && ! -L "$path" ]] ||
            die 65 "selected export message path became unsafe: $path"
        identity="$(stat -c '%d:%i:%s:%Y:%Z' "$path")" ||
            die 74 "could not recheck selected export message: $path"
        digest="$(sha256sum "$path" | cut -d ' ' -f 1)" ||
            die 74 "could not rehash selected export message: $path"
        printf '%s\t%s\t%s\n' "$path" "$identity" "$digest" >>"$selected_after" ||
            die 74 'could not recheck selected export messages'
        done <"$selected_before"
        cmp -s -- "$selected_before" "$selected_after" ||
            die 65 'selected export message changed; retry export after mailbox activity stops'
        break
    done

    if [[ -e "$output" || -L "$output" ]]; then
        [[ -f "$output" && ! -L "$output" ]] ||
            die 65 "export path became unsafe: $output"
        cmp -s -- "$candidate" "$output" ||
            die 65 "export path already contains different bytes: $output"
        return
    fi

    staged="$(mktemp "$output_parent/.reach-export.XXXXXXXXXX")" ||
        die 74 'could not create private export publication file'
    cp -- "$candidate" "$staged" ||
        die 74 'could not stage export transcript'
    sync -f "$staged" ||
        die 74 'could not fsync staged export transcript'
    if ln -- "$staged" "$output" 2>/dev/null; then
        sync -f "$output" ||
            die 74 'could not fsync published export transcript'
        rm -- "$staged" ||
            die 74 'could not remove private export publication file'
        return
    fi
    if [[ -f "$output" && ! -L "$output" ]] &&
       cmp -s -- "$candidate" "$output"; then
        rm -- "$staged" ||
            die 74 'could not remove raced export publication file'
        return
    fi
    rm -- "$staged" ||
        die 74 'could not remove failed export publication file'
    die 65 "export publication collided with different bytes: $output"
}

run_log() {
    local caller=''
    local journey=''
    local root
    local maildir
    local paths_file
    local output_file
    local error_file
    local status

    while (($# > 0)); do
        case "$1" in
            --as)
                (($# >= 2)) || usage
                [[ -z "$caller" ]] || die 64 '--as appears more than once'
                [[ -n "$2" ]] || die 64 '--as must not be blank'; caller="$2"
                shift 2
                ;;
            --work)
                (($# >= 2)) || usage
                [[ -z "$journey" ]] ||
                    die 64 '--work appears more than once'
                journey="$2"
                shift 2
                ;;
            *)
                die 64 "unknown option: $1"
                ;;
        esac
    done
    [[ -n "$caller" ]] || caller="${SNO_REACH_ADDR:-}"
    [[ -n "$caller" ]] || die 64 '--as is required'
    validate_address "$caller"
    [[ -z "$journey" || "$journey" =~ $TOKEN_RE ]] ||
        die 64 '--work must be one non-empty bare token'
    require_tools cmp mhdr mlist mpick msort mscan

    root="$(mailbox_root)"
    require_local_reader_address "$root" "$caller"
    maildir="$root/$caller"
    require_maildir "$maildir"
    make_temp_dir
    paths_file="$TEMP_DIR/log.paths"
    output_file="$TEMP_DIR/log.output"
    error_file="$TEMP_DIR/log.stderr"
    if ! scan_maildir_paths "$maildir" "$paths_file"; then
        die 74 'could not inspect caller mailbox log'
    fi

    : >"$error_file"
    set +e
    if [[ -n "$journey" ]]; then
        # mpick resolves $REACH_JOURNEY inside its own query language.
        # shellcheck disable=SC2016
        {
            REACH_JOURNEY="$journey" \
                mpick -t '"x-work" == $REACH_JOURNEY' \
                <"$paths_file" |
            msort -d |
            MAILSEQ=/dev/null \
                mscan -I -f '%R\t%I\t%19D\t%100f\t%200s'
        } >"$output_file" 2>"$error_file"
    else
        {
            msort -d <"$paths_file" |
            MAILSEQ=/dev/null \
                mscan -I -f '%R\t%I\t%19D\t%100f\t%200s'
        } >"$output_file" 2>"$error_file"
    fi
    status=$?
    set -e
    if ((status != 0)) || [[ -s "$error_file" ]]; then
        [[ ! -s "$error_file" ]] || cat "$error_file" >&2
        die 74 'could not format caller mailbox log'
    fi
    cat "$output_file"
}

run_spawn() {
    (($# >= 1)) || usage
    local kind="$1" cwd="$PWD" window=no adapter root
    local started rc=0
    CALLER=''
    shift
    [[ "$kind" =~ ^[a-z][a-z0-9-]*$ ]] || die 64 'spawn requires one agent kind'
    while (($#)); do
        case "$1" in
            --as) (($# >= 2)) || usage; [[ -z "$CALLER" ]] || die 64 'duplicate --as'; [[ -n "$2" ]] || die 64 '--as must not be blank'; CALLER="$2"; shift 2 ;;
            --cwd) (($# >= 2)) || usage; cwd="$2"; shift 2 ;;
            --window) [[ "$window" == no ]] || die 64 'duplicate --window'; window=yes; shift ;;
            *) die 64 "unknown spawn option: $1" ;;
        esac
    done
    [[ -n "$CALLER" ]] || CALLER="${SNO_REACH_ADDR:-}"
    validate_address "$CALLER"
    adapter="$("$REPO_ROOT/lib/reach-transport" for-kind "$kind")"
    root="$(mailbox_root)"
    [[ -f "$root/$CALLER/seat.json" ]] || die 65 "initialize first: sno reach init --as $CALLER --name <display>"
    require_safe_caller_dir "$root" "$CALLER" >/dev/null
    [[ ! -e "$root/$CALLER/reachable.json" && ! -L "$root/$CALLER/reachable.json" ]] || die 65 "seat already registered: $CALLER"
    cwd="$(realpath -e -- "$cwd")" || die 65 '--cwd must exist'
    [[ -d "$cwd" && "$cwd" != *:* && "$cwd" != *[$'\r\n']* ]] || die 65 'invalid spawn directory'
    if [[ "$window" == no && -n "$adapter" ]]; then
        require_tools acpx timeout flock
    else require_tools tmux "$kind"; fi
    started="$EPOCHREALTIME"
    "$REPO_ROOT/lib/reach-spawn" "$kind" "$CALLER" "$cwd" "$window" "$adapter" || rc=$?
    observe_message "$root" spawn "${SNO_REACH_ADDR:-}" "$CALLER" "$rc" "$started"
    return "$rc"
}

validate_live_record() {
    local address="$1" record="$2" channel pane session server expected
    [[ -f "$record" && ! -L "$record" ]] || die 5 "seat is not registered: $address"
    channel="$(jq -er --arg address "$address" 'select(.address == $address) | .channel' "$record")" || die 5 "invalid seat record: $address"
    if [[ "$channel" == tmux ]]; then
        pane="$(jq -er 'select(.identity.kind == "tmux-pane") | .identity.value' "$record")" || die 5 'missing tmux pane identity'
        session="$(timeout --foreground 5 tmux display-message -pt "$pane" '#S')" || die 5 'cannot read registered pane'
        server="$(printf '%s\t%s\n' "$(tmux display-message -pt "$pane" '#{socket_path}')" "$(tmux display-message -pt "$pane" '#{pid}')" | sha256sum | cut -d ' ' -f1)"
        expected="tmux-$server:$session"
        [[ "$(jq -r .handle "$record")" == "$expected" ]] || die 5 'tmux server identity mismatch'
    fi
    printf '%s\n' "$channel"
}

run_call() {
    (($# >= 2)) || usage
    local address="$1" text="$2" limit=180 every=2 expect='' root channel output rc=0
    local started receipt=''
    shift 2
    validate_address "$address"
    [[ "$text" =~ [^[:space:]] ]] || die 64 'call text is blank'
    while (($#)); do
        (($# >= 2)) || usage
        case "$1" in
            --timeout) limit="$2" ;;
            --every) every="$2" ;;
            --expect) expect="$2"; [[ -n "$expect" ]] || die 64 '--expect is blank' ;;
            *) die 64 "unknown call option: $1" ;;
        esac
        shift 2
    done
    [[ "$limit" =~ ^[0-9]{1,8}$ && "$every" =~ ^[1-9][0-9]{0,7}$ ]] || die 64 'call times must be integer seconds'
    ((10#$limit <= 280)) || die 64 '--timeout must not exceed 280 seconds'
    root="$(mailbox_root)"
    channel="$(validate_live_record "$address" "$root/$address/reachable.json")"
    [[ "$channel" != orca ]] || die 3 'channel orca does not support call'
    local -a args=(--terminal "$address" --text "$text" --timeout "$limit" --every "$every")
    [[ -z "$expect" ]] || args+=(--expect "$expect")
    started="$EPOCHREALTIME"
    output="$("$REPO_ROOT/lib/reach-call" "${args[@]}")" || rc=$?
    if ((rc == 0)); then
        case "$expect" in
            *HANDOFF_SNAPSHOT_UNCHANGED*) receipt=handoff_snapshot ;;
            *HANDOFF_RELEASED*) receipt=handoff_released ;;
            *HANDOFF_PAUSED*) receipt=handoff_paused ;;
        esac
    fi
    observe_message "$root" call "${SNO_REACH_ADDR:-}" "$address" "$rc" "$started" '' "$receipt"
    if [[ -n "$output" ]]; then
        jq -e 'has("output") and (.output | type == "string")' <<<"$output" >/dev/null || die 5 'call output could not be read'
        jq -r .output <<<"$output"
    fi
    return "$rc"
}

run_watch() {
    (($# >= 1)) || usage
    local address="$1" limit=280 idle='' root channel
    shift
    validate_address "$address"
    while (($#)); do
        (($# >= 2)) || usage
        case "$1" in --timeout) limit="$2" ;; --idle) [[ -n "$2" ]] || die 64 '--idle must not be blank'; idle="$2" ;; *) die 64 "unknown watch option: $1" ;; esac
        shift 2
    done
    [[ "$limit" =~ ^[0-9]{1,8}$ && ( -z "$idle" || "$idle" =~ ^[0-9]{1,8}$ ) ]] || die 64 'watch times must be integer seconds'
    ((10#$limit <= 280)) || die 64 '--timeout must not exceed 280 seconds'
    [[ -z "$idle" ]] || ((10#$idle <= 280)) || die 64 '--idle must not exceed 280 seconds'
    root="$(mailbox_root)"
    channel="$(validate_live_record "$address" "$root/$address/reachable.json")"
    "$REPO_ROOT/lib/reach-watch" "$root/$address/reachable.json" "$channel" "$limit" "$idle"
}

run_seats() {
    local root record address state json=no
    if (($#)); then [[ "$#" == 1 && "$1" == --json ]] || usage; json=yes; fi
    root="$(mailbox_root)"
    [[ -d "$root" && ! -L "$root" && -r "$root" && -x "$root" ]] || die 73 "state root unavailable: $root"
    for record in "$root"/*/reachable.json; do
        [[ -e "$record" || -L "$record" ]] || continue
        address="${record%/reachable.json}"; address="${address##*/}"
        state="$("$REACHABILITY" status --root "$root" --as "$address")"
        case "$state" in present$'\t'*) state=live ;; stale$'\t'*) state=stale ;; *) die 65 "invalid registration: $record" ;; esac
        if [[ "$json" == yes ]]; then
            jq -c --arg state "$state" '{address,channel,handle,state:$state}' "$record"
        else
            jq -r --arg state "$state" '[.address,.channel,.handle,$state] | @tsv' "$record"
        fi
    done
}

run_ring() {
    [[ "$#" == 1 ]] || usage
    local recipient="$1" root output outcome rc=0 sender
    local started status
    validate_address "$recipient"
    root="$(mailbox_root)"
    [[ -f "$root/$recipient/reachable.json" && ! -L "$root/$recipient/reachable.json" ]] || { printf 'unregistered\n'; return 1; }
    sender="${SNO_REACH_ADDR:-$recipient}"
    validate_address "$sender"
    started="$EPOCHREALTIME"
    output="$("$REPO_ROOT/lib/reach-ring" doorbell --to "$recipient" --from "$sender" --msg-id "<ring-$$-$RANDOM@localhost>")" || rc=$?
    outcome="${output%%$'\n'*}"; outcome="${outcome#outcome=}"
    case "$rc" in
        124|137) status=timeout ;;
        *) case "$outcome" in rang) status=ok ;; rang-unverified) status=unacked ;; *) status=refused ;; esac ;;
    esac
    ((rc == 0)) || outcome=failed
    observe_message "$root" ring "${SNO_REACH_ADDR:-}" "$recipient" "$rc" "$started" "$status"
    case "$outcome" in rang|rang-unverified|busy) printf '%s\n' "$outcome" ;; unregistered) printf 'unregistered\n'; return 1 ;; *) printf 'failed\n'; return 1 ;; esac
}

run_remind() {
    parse_as_only "$@"
    require_local_reader_address "$(mailbox_root)" "$CALLER"
    local rc=0 remaining started
    remaining="$(awk -v start="$REACH_STARTED" -v now="$EPOCHREALTIME" 'BEGIN {left=4.9-(now-start); if(left<=0) exit 1; printf "%.3f",left}')" || die 75 'remind whole-command deadline exceeded before read'
    started="$EPOCHREALTIME"
    timeout --foreground --signal=KILL "$remaining" "$REPO_ROOT/lib/reach-remind" "$CALLER" || rc=$?
    observe_message "$(mailbox_root)" remind "$CALLER" "$CALLER" "$rc" "$started"
    if ((rc)); then printf 'reach: remind could not read work state (exit %s)\n' "$rc" >&2; return "$rc"; fi
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

(($# > 0)) || usage
verb="$1"
shift
case "$verb" in
    --help) usage 0 ;;
    --version)
        (($# == 0)) || usage
        [[ -r "$REPO_ROOT/VERSION" ]] || die 66 "VERSION is unavailable: $REPO_ROOT/VERSION"
        cat "$REPO_ROOT/VERSION"; exit 0 ;;
esac
for option in "$@"; do
    case "$option" in
        --journey) die 64 'use --work instead of --journey' ;;
        --callsign) die 64 'set the display name with init --name instead of --callsign' ;;
        --message) die 64 'use --card instead of --message' ;;
        --interval-secs) die 64 'use --every instead of --interval-secs' ;;
        --timeout-secs) die 64 'use --timeout instead of --timeout-secs' ;;
        --idle-secs) die 64 'use --idle instead of --idle-secs' ;;
    esac
done
case "$verb" in
    send) run_send "$@" ;;
    inbox) run_inbox "$@" ;;
    wait) run_wait "$@" ;;
    reply) run_reply "$@" ;;
    dismiss) run_dismiss "$@" ;;
    log) run_log "$@" ;;
    flush) run_flush "$@" ;;
    init) run_init "$@" ;;
    rebind) run_rebind "$@" ;;
    register) run_register "$@" ;;
    unregister) run_unregister "$@" ;;
    doctor) run_doctor "$@" ;;
    export) run_export "$@" ;;
    state) run_state "$@" ;;
    lint) "$LINTER" "$@" ;;
    spawn|seats|call|watch|ring|remind) run_"$verb" "$@" ;;
    *) usage ;;
esac
