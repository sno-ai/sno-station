#!/usr/bin/env bash
# Runs inside the newly created pane, after its parent publishes registration.
set -Eeuo pipefail
kind="${1:?agent kind required}"
context="${2:?startup context required}"
model="${3-}" provider="${4-}"
model_args=() provider_args=()
[[ -z "$provider" ]] || provider_args=(--provider "$provider")
record="$SNO_REACH_ROOT/$SNO_REACH_ADDR/reachable.json"
deadline=$((SECONDS + 10))
while [[ ! -f "$record" ]]; do
    ((SECONDS < deadline)) || { printf 'reach: spawn registration never arrived\n' >&2; exit 75; }
    sleep 0.1
done
case "$kind" in
    codex)
        [[ -z "$model" ]] || model_args=(-m "$model")
        exec codex --dangerously-bypass-approvals-and-sandbox "${model_args[@]}" "$context" ;;
    # A prompt suggestion sits in the composer and reads as unsubmitted text to call.
    claude)
        [[ -z "$model" ]] || model_args=(--model "$model")
        CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=0 exec claude --dangerously-skip-permissions --session-id "$SNO_REACH_SESSION_ID" "${model_args[@]}" "$context" ;;
    hermes)
        [[ -z "$model" ]] || model_args=(-m "$model")
        exec hermes chat --yolo "${model_args[@]}" "${provider_args[@]}" --query "$context" ;;
    openclaw) exec openclaw tui --session "$SNO_REACH_SESSION_ID" ;;
    # --trust keeps a new checkout's workspace-trust question from holding the seat.
    cursor)
        [[ -z "$model" ]] || model_args=(--model "$model")
        exec cursor-agent --force --trust "${model_args[@]}" "$context" ;;
    *) exec "$kind" "$context" ;;
esac
