#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
readonly REACH="$SCRIPT_DIR/../bin/sno-reach"
readonly ADDRESS_RE='^[a-z][a-z0-9-]{0,31}\.[a-z0-9][a-z0-9-]{0,63}@[a-z0-9][a-z0-9.-]{0,252}$'
readonly MESSAGE_ID_RE='^<[^<>[:space:]]+>$'
readonly WAKE_DEFAULT_ATTEMPTS=45
readonly WAKE_DEFAULT_SPACING_SECONDS=120
readonly WAKE_BOUND_SECONDS=5400
readonly OUTBOX_DEFAULT_ATTEMPTS=6
readonly OUTBOX_DEFAULT_SPACING_SECONDS=60
readonly OUTBOX_BOUND_SECONDS=360
readonly WAKE_LOG_LOCK_TIMEOUT_SECONDS=1

VENDOR_BIN="$(cd -- "$SCRIPT_DIR/../vendor/bin" && pwd)"
readonly VENDOR_BIN
export PATH="$VENDOR_BIN:$PATH"

die() {
    local code="$1"
    shift
    printf 'reach-wake: %s\n' "$*" >&2
    exit "$code"
}

require_setsid() {
    if ! command -v setsid >/dev/null 2>&1; then
        printf 'sno-reach: needs setsid — detach delivery recovery; install it and run again.\n' >&2
        exit 69
    fi
}

# Above the doorbell's own longest legitimate wait (its tmux acknowledgement
# window is 90s), so a bounded ring is never cut short, and below anything a
# sender would call a hang.
MECHANISM_TIMEOUT_SECONDS="${SNO_REACH_WAKE_MECHANISM_TIMEOUT_SECONDS:-150}"
[[ "$MECHANISM_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] ||
    die 64 'SNO_REACH_WAKE_MECHANISM_TIMEOUT_SECONDS must be a positive integer'
readonly MECHANISM_TIMEOUT_SECONDS

now_epoch() {
    local value

    if [[ -n "${SNO_REACH_NOW_COMMAND:-}" ]]; then
        [[ -x "$SNO_REACH_NOW_COMMAND" ]] ||
            die 64 'SNO_REACH_NOW_COMMAND is not executable'
        value="$("$SNO_REACH_NOW_COMMAND")" ||
            die 74 'injectable clock command failed'
    elif [[ -n "${SNO_REACH_NOW:-}" ]]; then
        value="$SNO_REACH_NOW"
    else
        value="$(date -u +%s)" || die 74 'could not read the current time'
    fi
    [[ "$value" =~ ^[0-9]+$ ]] ||
        die 64 'the wake clock must return a non-negative integer'
    printf '%s\n' "$((10#$value))"
}

sleep_interval() {
    local seconds="$1"

    if [[ -n "${SNO_REACH_SLEEP_COMMAND:-}" ]]; then
        [[ -x "$SNO_REACH_SLEEP_COMMAND" ]] ||
            die 64 'SNO_REACH_SLEEP_COMMAND is not executable'
        "$SNO_REACH_SLEEP_COMMAND" "$seconds"
    else
        sleep "$seconds"
    fi
}

validate_root() {
    [[ "$1" == /* && "$1" != *'/../'* && "$1" != *'/./'* &&
       "$1" != *'//' ]] || die 65 "unsafe mailbox root: $1"
}

validate_address() {
    [[ "$1" =~ $ADDRESS_RE ]] || die 64 "invalid address: $1"
}

validate_message_id() {
    [[ "$1" =~ $MESSAGE_ID_RE ]] || die 64 "invalid Message-ID: $1"
}

json_field() {
    jq -r "$2" "$1"
}

process_start_ticks() {
    local pid="$1" process_stat remainder
    local -a fields

    [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
    if [[ ! -d /proc ]]; then
        process_stat="$(ps -o stat= -p "$pid" 2>/dev/null)" || return 1
        [[ -n "$process_stat" && "$process_stat" != *Z* ]] || return 1
        process_stat="$(ps -o lstart= -p "$pid" 2>/dev/null)" || return 1
        [[ -n "$process_stat" ]] || return 1
        printf '%s\n' "$process_stat"
        return 0
    fi
    [[ -r "/proc/$pid/stat" ]] || return 1
    process_stat="$(<"/proc/$pid/stat")" || return 1
    remainder="${process_stat##*) }"
    read -r -a fields <<<"$remainder"
    ((${#fields[@]} >= 20)) || return 1
    [[ "${fields[0]}" != Z && "${fields[19]}" =~ ^[0-9]+$ ]] || return 1
    printf '%s\n' "${fields[19]}"
}

process_owns_attempt() {
    local pid="$1" expected_start="$2" actual_start

    if [[ -d /proc ]]; then
        [[ "$expected_start" =~ ^[1-9][0-9]*$ ]] || return 1
    else
        [[ -n "$expected_start" && "$expected_start" != 0 ]] || return 1
    fi
    actual_start="$(process_start_ticks "$pid")" || return 1
    [[ "$actual_start" == "$expected_start" ]]
}

resolve_supervisor() {
    local root="$1"
    local recipient="$2"
    local card="$root/$recipient/seat.json"
    local supervisor

    [[ -f "$card" && ! -L "$card" ]] || return 1
    supervisor="$(jq -er '.supervisor | strings | select(length > 0)' \
        "$card" 2>/dev/null)" || return 1
    [[ "$supervisor" =~ $ADDRESS_RE ]] || return 1
    printf '%s\n' "$supervisor"
}

state_lock() {
    local state_file="$1"

    exec 9>"$state_file.lock" || die 74 "could not open attempt lock: $state_file.lock"
    flock 9 || die 74 "could not acquire attempt lock: $state_file.lock"
}

state_unlock() {
    flock -u 9 || true
    exec 9>&-
}

append_log() {
    local state_file="$1"
    local event="$2"
    local outcome="${3:-}"
    local at="$4"
    local snapshot log_dir log_file log_lock

    snapshot="$(<"$state_file")"
    log_dir="$(jq -r '[.root, (.state_owner // .recipient)] | map(tostring) | join("/")' <<<"$snapshot")"
    log_file="$log_dir/wake.log"
    log_lock="$log_dir/.wake-log.lock"
    exec 8>"$log_lock" || die 74 "could not open wake log lock: $log_lock"
    flock -w "$WAKE_LOG_LOCK_TIMEOUT_SECONDS" 8 ||
        die 75 "wake log lock timed out after ${WAKE_LOG_LOCK_TIMEOUT_SECONDS}s: $log_lock"
    jq -c \
        --arg event "$event" \
        --arg outcome "$outcome" \
        --argjson at "$at" \
        --argjson pid "$$" \
        '{version:1, attempt_id:(.attempt_id | tostring), message_id:(.message_id | tostring),
          sender:(.sender | tostring), recipient:(.recipient | tostring), supervisor:(.supervisor | tostring),
          attempt:(.attempt | tostring | fromjson), at:$at, pid:$pid, event:$event} +
          (if $outcome == "" then {} else {outcome:$outcome} end)' \
        <<<"$snapshot" \
        >>"$log_file" || {
            flock -u 8 || true
            exec 8>&-
            die 74 "could not append wake log: $log_file"
        }
    flock -u 8 || true
    exec 8>&-
}

replace_state() {
    local state_file="$1"
    local filter="$2"
    shift 2
    local temporary

    temporary="$(mktemp "$(dirname -- "$state_file")/.wake-state.XXXXXXXXXX")" ||
        die 74 'could not create a private wake state'
    jq "$@" "$filter" "$state_file" >"$temporary" ||
        die 74 'could not render wake state update'
    chmod 0600 "$temporary" || die 74 'could not protect wake state'
    mv -- "$temporary" "$state_file" ||
        die 74 'could not publish wake state atomically'
}

message_effect() {
    local state_file="$1"
    local root recipient message_id path basename mode outbox_entry
    local seen

    root="$(json_field "$state_file" '.root')"
    recipient="$(json_field "$state_file" '.recipient')"
    message_id="$(json_field "$state_file" '.message_id')"
    mode="$(json_field "$state_file" '.mode // "wake"')"
    if [[ "$mode" == outbox ]]; then
        outbox_entry="$(json_field "$state_file" '.outbox_entry')"
        [[ -d "$outbox_entry" && ! -L "$outbox_entry" ]] || return 0
        [[ -f "$outbox_entry/recipients" && ! -L "$outbox_entry/recipients" ]] ||
            return 1
        [[ ! -s "$outbox_entry/recipients" ]] && return 0
        while IFS= read -r recipient; do
            [[ "$recipient" =~ $ADDRESS_RE ]] || return 1
        done <"$outbox_entry/recipients"
        return 1
    fi
    seen="$root/$recipient/seen.jsonl"
    if [[ -f "$seen" && ! -L "$seen" ]] &&
       jq -s -e --arg id "$message_id" \
           'any(.[]; .message_id == $id)' "$seen" >/dev/null 2>&1; then
        return 0
    fi
    while IFS= read -r -d '' path; do
        grep -Eiq "^Message-I[Dd]:[[:space:]]*$(printf '%s' "$message_id" | sed 's/[][\\.^$*+?{}|()]/\\&/g')[[:space:]]*\r?$" \
            "$path" || continue
        basename="${path##*/}"
        [[ "$basename" == *':2,'*R* || "$basename" == *':2,'*T* ]] &&
            return 0
    done < <(find "$root/$recipient/new" "$root/$recipient/cur" \
        -maxdepth 1 -type f -print0 2>/dev/null)
    return 1
}

mailbox_has_message() {
    local root="$1" address="$2" message_id="$3"
    local path

    while IFS= read -r -d '' path; do
        [[ "$(mhdr -h message-id "$path" 2>/dev/null || true)" == "$message_id" ]] &&
            return 0
    done < <(find "$root/$address/new" "$root/$address/cur" \
        -maxdepth 1 -type f -print0 2>/dev/null)
    return 1
}

delivery_receipt_exists() {
    local root="$1" sender="$2" recipient="$3" message_id="$4"
    local key receipt

    key="$(printf '%s\n%s\n' "$message_id" "$recipient" | sha256sum | cut -c1-64)"
    receipt="$root/$sender/delivery-receipts/$key.json"
    [[ -f "$receipt" && ! -L "$receipt" ]] || return 1
    jq -e --arg recipient "$recipient" --arg message_id "$message_id" '
        .version == 1 and .recipient == $recipient and
        .message_id == $message_id and
        (.sha256 | strings | test("^[0-9a-f]{64}$")) and
        (.transport == "local" or .transport == "remote")
    ' "$receipt" >/dev/null 2>&1
}

run_with_absolute_deadline() {
    local remaining="$1"
    shift

    if [[ "${SNO_REACH_WAKE_PLANT_FOREGROUND_TIMEOUT:-0}" == 1 ]]; then
        timeout --foreground --signal=TERM "$remaining" "$@"
    elif ((remaining <= 1)); then
        timeout --signal=KILL "$remaining" "$@"
    else
        timeout --signal=TERM --kill-after=1 "$((remaining - 1))" "$@"
    fi
}

outbox_has_removed_local_recipient() {
    local state_file="$1" root sender recipient

    root="$(json_field "$state_file" '.root')"
    sender="$(json_field "$state_file" '.sender')"
    while IFS= read -r recipient; do
        if [[ "${recipient##*@}" == "${sender##*@}" &&
              ( ! -d "$root/$recipient" || -L "$root/$recipient" ) ]]; then
            return 0
        fi
    done < <(jq -r '.outbox_recipients[]' "$state_file")
    return 1
}

separate_removed_outbox_recipients() {
    local state_file="$1" root sender entry recipient temporary
    local removed_json remaining_json
    local -a removed=() remaining=()

    root="$(json_field "$state_file" '.root')"
    sender="$(json_field "$state_file" '.sender')"
    entry="$(json_field "$state_file" '.outbox_entry')"
    while IFS= read -r recipient; do
        if [[ "${recipient##*@}" == "${sender##*@}" &&
              ( ! -d "$root/$recipient" || -L "$root/$recipient" ) ]]; then
            removed+=("$recipient")
        else
            remaining+=("$recipient")
        fi
    done < <(jq -r '.outbox_recipients[]' "$state_file")
    ((${#removed[@]} > 0)) || return 1

    if [[ "${SNO_REACH_WAKE_PLANT_GLOBAL_REMOVED_ABORT:-0}" == 1 ]]; then
        state_lock "$state_file"
        replace_state "$state_file" \
            '.phase="escalation" | .last_outcome="recipient-removed"'
        state_unlock
        deliver_escalation "$state_file"
        return 2
    fi

    removed_json="$(printf '%s\n' "${removed[@]}" | jq -Rsc \
        'split("\n") | map(select(length > 0))')"
    remaining_json="$(printf '%s\n' "${remaining[@]}" | jq -Rsc \
        'split("\n") | map(select(length > 0))')"
    if [[ -d "$entry" && ! -L "$entry" && -f "$entry/recipients" &&
          ! -L "$entry/recipients" ]]; then
        temporary="$(mktemp "$entry/.recipients.XXXXXXXXXX")" ||
            die 74 'could not stage active outbox recipients'
        : >"$temporary"
        ((${#remaining[@]} == 0)) || printf '%s\n' "${remaining[@]}" >"$temporary"
        mv -- "$temporary" "$entry/recipients" ||
            die 74 'could not publish active outbox recipients'
    fi
    state_lock "$state_file"
    replace_state "$state_file" \
        '.removed_recipients = (((.removed_recipients // []) + $removed) | unique) |
         .outbox_recipients=$remaining | .last_outcome="recipient-removed"' \
        --argjson removed "$removed_json" --argjson remaining "$remaining_json"
    if ((${#remaining[@]} == 0)); then
        replace_state "$state_file" '.phase="escalation"'
    fi
    state_unlock
    deliver_escalation "$state_file" || true
    ((${#remaining[@]} > 0)) || return 2
    return 0
}

queued_entry_for_message() {
    local root="$1" sender="$2" message_id="$3"
    local message

    while IFS= read -r -d '' message; do
        [[ "$(mhdr -h message-id "$message" 2>/dev/null || true)" == "$message_id" ]] ||
            continue
        dirname -- "$message"
        return 0
    done < <(find "$root/$sender/outbox" -mindepth 2 -maxdepth 2 \
        -type f -name message -print0 2>/dev/null)
    return 1
}

normalise_outcome() {
    case "$1" in
        rang|rang-unverified|busy|stale|unregistered|no-channel|no-wake-channel|failed)
            printf '%s\n' "$1"
            ;;
        *)
            printf 'unknown\n'
            ;;
    esac
}

invoke_mechanism() {
    local state_file="$1"
    local mechanism standin outcome_hint recipient sender message_id
    local output rc=0 token

    mechanism="$(json_field "$state_file" '.mechanism')"
    standin="$(json_field "$state_file" '.standin')"
    outcome_hint="$(json_field "$state_file" '.outcome_hint')"
    recipient="$(json_field "$state_file" '.recipient')"
    sender="$(json_field "$state_file" '.sender')"
    message_id="$(json_field "$state_file" '.message_id')"
    if [[ -n "$standin" ]]; then
        if [[ ! -x "$standin" ]]; then
            printf 'no-channel\n'
            return
        fi
        set +e
        output="$("$standin" --outcome "$outcome_hint" --to "$recipient" \
            --message-id "$message_id" --log "$(dirname -- "$state_file")/standin.log" 2>&1)"
        rc=$?
        set -e
        ((rc == 0)) || { printf 'failed\n'; return; }
        token="${output##*outcome=}"
    else
        if [[ -z "$mechanism" || ! -x "$mechanism" ]]; then
            printf 'no-channel\n'
            return
        fi
        # The doorbell is an external program on the caller's send path. Without
        # a deadline a hang inside it blocks the sender forever, and a hang in
        # the detached worker ends the bounded retry and its escalation with no
        # signal at all. A timeout is one failed attempt, which the retry
        # schedule already knows how to carry.
        set +e
        output="$(SNO_REACH_ROOT="$(json_field "$state_file" '.root')" \
            timeout --signal=TERM --kill-after=5 "$MECHANISM_TIMEOUT_SECONDS" \
            "$mechanism" doorbell --to "$recipient" --from "$sender" \
            --msg-id "$message_id" 2>&1)"
        rc=$?
        set -e
        ((rc == 0)) || { printf 'failed\n'; return; }
        case "$output" in
            outcome=*)
                token="${output%%$'\n'*}"
                token="${token#outcome=}"
                ;;
            'mailbox doorbell: '*)
                token="${output#mailbox doorbell: }"
                token="${token%% *}"
                ;;
            *) token="$output" ;;
        esac
    fi
    if [[ "$token" == unresolved ]]; then
        printf 'registered-but-unresolvable\n'
    else
        normalise_outcome "$token"
    fi
}

mark_terminal() {
    local state_file="$1"
    local terminal_state="$2"
    local outcome="$3"
    local at="$4"

    state_lock "$state_file"
    replace_state "$state_file" \
        '.state=$state | .last_outcome=$outcome | .terminal_at=$at |
         .child_pid=0 | .child_start_ticks=0' \
        --arg state "$terminal_state" --arg outcome "$outcome" --argjson at "$at"
    state_unlock
    append_log "$state_file" "$terminal_state" "$outcome" "$at"
}

deliver_escalation() {
    local state_file="$1"
    local root sender recipient supervisor message_id journey outcome started now mode
    local card targets unresolved_targets escalation_id status recipient_hash
    local outbox_entry unresolved_json target target_hash delivery_key queued_entry
    local bound_seconds escalation_subject escalation_disposition
    local target_count=0 delivered_count=0 unresolved=0

    state_lock "$state_file"
    if [[ "$(json_field "$state_file" '.escalation_sent')" != false ]]; then
        state_unlock
        return 0
    fi
    root="$(json_field "$state_file" '.root')"
    sender="$(json_field "$state_file" '.sender')"
    recipient="$(json_field "$state_file" '.recipient')"
    supervisor="$(json_field "$state_file" '.supervisor')"
    message_id="$(json_field "$state_file" '.message_id')"
    journey="$(json_field "$state_file" '.journey')"
    outcome="$(json_field "$state_file" '.last_outcome')"
    started="$(json_field "$state_file" '.started_at')"
    mode="$(json_field "$state_file" '.mode // "wake"')"
    bound_seconds="$(json_field "$state_file" '.bound_seconds')"
    now="$(now_epoch)"
    targets="$(mktemp "${TMPDIR:-/tmp}/wake-escalation-targets.XXXXXXXXXX")" ||
        die 74 'could not create escalation targets'
    unresolved_targets="$(mktemp "${TMPDIR:-/tmp}/wake-escalation-unresolved.XXXXXXXXXX")" || {
        rm -f -- "$targets"
        die 74 'could not create unresolved escalation targets'
    }
    card="$(mktemp "${TMPDIR:-/tmp}/wake-escalation.XXXXXXXXXX")" || {
        rm -f -- "$targets" "$unresolved_targets"
        die 74 'could not create escalation card'
    }
    trap 'rm -f -- "${card:-}" "${targets:-}" "${unresolved_targets:-}"' RETURN
    if [[ "$mode" == outbox ]]; then
        supervisor="$(json_field "$state_file" '.supervisor')"
        while IFS= read -r recipient; do
            [[ "$recipient" =~ $ADDRESS_RE ]] || { unresolved=1; break; }
            printf '%s\t%s\n' "$recipient" "$sender" >>"$targets"
            target_count=$((target_count + 1))
            if [[ "$supervisor" =~ $ADDRESS_RE ]]; then
                printf '%s\t%s\n' "$recipient" "$supervisor" >>"$targets"
                target_count=$((target_count + 1))
            else
                printf '%s\n' "$recipient" >>"$unresolved_targets"
            fi
        done < <(jq -r '
            if .phase == "escalation" then
                ((.outbox_recipients // []) + (.removed_recipients // [])) | unique[]
            else
                (.removed_recipients // [])[]
            end
        ' "$state_file")
    elif [[ "$recipient" =~ $ADDRESS_RE && "$supervisor" =~ $ADDRESS_RE ]]; then
        printf '%s\t%s\n' "$recipient" "$sender" >"$targets"
        printf '%s\t%s\n' "$recipient" "$supervisor" >>"$targets"
        target_count=2
    else
        unresolved=1
    fi
    if ((unresolved != 0 || target_count == 0)); then
        replace_state "$state_file" \
            '.state="supervisor-unresolved" | .child_pid=0 |
             .child_start_ticks=0 | .terminal_at=$at' \
            --argjson at "$now"
        state_unlock
        append_log "$state_file" supervisor-unresolved "$outcome" "$now"
        return 1
    fi
    while IFS=$'\t' read -r recipient target; do
        recipient_hash="$(printf '%s' "$recipient" | sha256sum | cut -c1-8)"
        target_hash="$(printf '%s' "$target" | sha256sum | cut -c1-8)"
        delivery_key="$recipient|$target"
        # What happened to the card is read from what was recorded, never from
        # what the filesystem looks like now. A Maildir that exists at escalation
        # time does not mean the card arrived, and one that is gone does not mean
        # it did not: the recipient can read and exit before its seat is torn
        # down, and a seat can be recreated after a copy was already retired.
        # Both inversions produce a confident sentence that is simply false, and
        # the sender then re-dispatches finished work or abandons work that never
        # landed. `mode` is stamped at start (outbox = a queued copy that was
        # never delivered, wake = a card already delivered that needs its
        # recipient woken) and removal is appended when it happens, so these are
        # receipts. When neither answers, the card says so rather than guessing.
        if [[ "$mode" != outbox ]]; then
            escalation_subject='Wake bound reached; delivery is confirmed, pickup is not'
            escalation_disposition='Disposition: the card was delivered to the recipient mailbox before this wake began. This wake did not observe the message-specific confirmation effect, so it cannot tell whether the recipient read or started the work. Wake attempts stopped at the bound; do not dispatch duplicate work from this status alone. Check the recipient state before deciding whether to re-dispatch.'
        elif jq -e --arg r "$recipient" \
                '((.removed_recipients // []) | index($r)) != null' \
                "$state_file" >/dev/null; then
            escalation_subject='Recipient seat is gone; the queued copy was dropped'
            escalation_disposition='Disposition: the recipient mailbox was recorded as removed while this copy was still queued, so the copy had nowhere to be placed and was retired. This is a seat that ended, not a transport fault. Re-send to a live seat if the work still matters.'
        elif jq -e --arg r "$recipient" \
                '((.outbox_recipients // []) | index($r)) != null' \
                "$state_file" >/dev/null; then
            escalation_subject='Recipient never became reachable; the copy is still queued'
            escalation_disposition='Disposition: the copy never reached the recipient and is still in the sender outbox. It was not dropped. Flush it once the recipient is reachable, or retire it deliberately; it will not deliver itself.'
        else
            escalation_subject='Wake bound reached; delivery state unknown'
            escalation_disposition='Disposition: this attempt holds no record of the copy being delivered, removed, or still queued for this recipient, so its state is not known from here. Do not assume either outcome. Read the sender outbox and the recipient mailbox before re-sending.'
        fi
        if jq -e --arg key "$delivery_key" \
                '(.escalation_delivered // []) | index($key) != null' \
                "$state_file" >/dev/null; then
            delivered_count=$((delivered_count + 1))
            continue
        fi
        escalation_id="<wake-$(json_field "$state_file" '.attempt_id')-${recipient_hash}-${target_hash}@${sender##*@}>"
        {
            printf 'From: Wake recovery <%s>\n' "$sender"
            printf 'To: %s\n' "$target"
            printf 'Subject: [STATUS] %s\n' "$escalation_subject"
            date -R -d "@$started" | sed 's/^/Date: /'
            printf 'Message-ID: %s\n' "$escalation_id"
            printf 'X-Work: %s\n' "$journey"
            printf 'X-Type: status\n'
            printf 'Auto-Submitted: auto-generated\n'
            printf '\nOriginal-Message-ID: %s\n' "$message_id"
            printf 'Recipient: %s\n' "$recipient"
            printf 'Elapsed-Bound-Seconds: %s\n' "$bound_seconds"
            printf 'Last-Outcome: %s\n' "$outcome"
            printf 'Attempt-Started-At: %s\n' "$started"
            printf '%s\n' "$escalation_disposition"
        } >"$card"
        if ! mailbox_has_message "$root" "$target" "$escalation_id" &&
           ! delivery_receipt_exists "$root" "$sender" "$target" "$escalation_id"; then
            queued_entry="$(queued_entry_for_message "$root" "$sender" \
                "$escalation_id" || true)"
            if [[ -n "$queued_entry" ]]; then
                set +e
                timeout --signal=TERM --kill-after=1 "$(json_field "$state_file" '.spacing_seconds')" \
                    env SNO_REACH_SKIP_WAKE_ADOPTION=1 \
                    SNO_REACH_SKIP_OUTBOX_RETRY=1 SNO_REACH_ROOT="$root" SNO_REACH_OUTBOX_ENTRY="$queued_entry" \
                    "$REACH" flush --as "$sender" \
                    >/dev/null 2>&1
                status=$?
                set -e
            else
                set +e
                timeout --signal=TERM --kill-after=1 "$(json_field "$state_file" '.spacing_seconds')" \
                    env SNO_REACH_SKIP_WAKE_ADOPTION=1 \
                    SNO_REACH_SKIP_OUTBOX_RETRY=1 SNO_REACH_ROOT="$root" \
                    "$REACH" send --as "$sender" <"$card"
                status=$?
                set -e
            fi
        fi
        if mailbox_has_message "$root" "$target" "$escalation_id" ||
           delivery_receipt_exists "$root" "$sender" "$target" "$escalation_id"; then
            replace_state "$state_file" \
                '.escalation_delivered = (((.escalation_delivered // []) + [$key]) | unique)' \
                --arg key "$delivery_key"
            delivered_count=$((delivered_count + 1))
        fi
    done <"$targets"
    unresolved_json="$(jq -Rsc 'split("\n") | map(select(length > 0))' \
        "$unresolved_targets")"
    if ((delivered_count != target_count)); then
        replace_state "$state_file" \
            '.state="pending" | .phase="escalation" |
             .last_outcome="escalation-pending" |
             .unresolved_supervisors=$unresolved' \
            --argjson unresolved "$unresolved_json"
        state_unlock
        append_log "$state_file" escalation-pending "$outcome" "$now"
        return 4
    fi
    if [[ "$mode" == outbox && "$(json_field "$state_file" '.phase')" != escalation ]]; then
        replace_state "$state_file" '.removed_recipients=[]'
        state_unlock
        trap - RETURN
        rm -f -- "$card" "$targets" "$unresolved_targets"
        return 0
    fi
    replace_state "$state_file" \
        '.state="escalated" | .escalation_sent=true | .child_pid=0 |
         .child_start_ticks=0 |
         .terminal_at=$at | .unresolved_supervisors=$unresolved' \
        --argjson at "$now" --argjson unresolved "$unresolved_json"
    state_unlock
    append_log "$state_file" escalated "$outcome" "$now"
    trap - RETURN
    rm -f -- "$card" "$targets" "$unresolved_targets"
}

run_retry() {
    local state_file="$1"
    local spacing state worker_start

    [[ -f "$state_file" && ! -L "$state_file" ]] ||
        die 66 "attempt state is unavailable: $state_file"
    if [[ -n "${SNO_REACH_WAKE_CHILD_BARRIER:-}" ]]; then
        [[ -x "$SNO_REACH_WAKE_CHILD_BARRIER" ]] ||
            die 66 "wake child barrier is not executable: $SNO_REACH_WAKE_CHILD_BARRIER"
        "$SNO_REACH_WAKE_CHILD_BARRIER"
    fi
    worker_start="$(process_start_ticks "$$")" ||
        die 74 'could not identify the retry worker process'
    state_lock "$state_file"
    replace_state "$state_file" \
        '.child_pid=$pid | .child_start_ticks=($start | tonumber? // .)' \
        --argjson pid "$$" --arg start "$worker_start"
    state_unlock
    spacing="$(json_field "$state_file" '.spacing_seconds')"
    while [[ "$(json_field "$state_file" '.state')" == pending ]]; do
        sleep_interval "$spacing"
        retry_once "$state_file" || true
    done
    state="$(json_field "$state_file" '.state')"
    [[ "$state" == confirmed || "$state" == escalated ||
       "$state" == not-applicable ]]
}

retry_once() {
    local state_file="$1"
    local attempt max_attempts now started outcome mechanism_outcome
    local reachability_state=registered
    local mode outbox_entry flush_status remaining bound_seconds phase recipients_json
    local removed_status plant_prebound

    [[ -f "$state_file" && ! -L "$state_file" ]] ||
        die 66 "attempt state is unavailable: $state_file"
    [[ "$(json_field "$state_file" '.state')" == pending ]] || return 0
    now="$(now_epoch)"
    started="$(json_field "$state_file" '.started_at')"
    mode="$(json_field "$state_file" '.mode // "wake"')"
    phase="$(json_field "$state_file" '.phase // "retry"')"
    bound_seconds="$(json_field "$state_file" '.bound_seconds')"
    plant_prebound="${SNO_REACH_WAKE_PLANT_PREBOUND_ESCALATION:-0}"
    if [[ "$phase" == escalation ]]; then
        deliver_escalation "$state_file"
        return
    fi
    if message_effect "$state_file"; then
        mark_terminal "$state_file" confirmed effect "$now"
        return 0
    fi
    attempt="$(json_field "$state_file" '.attempt')"
    max_attempts="$(json_field "$state_file" '.max_attempts')"
    if [[ "$mode" == outbox ]]; then
        if separate_removed_outbox_recipients "$state_file"; then
            removed_status=0
        else
            removed_status=$?
        fi
        ((removed_status != 2)) || return 0
    fi
    if ((attempt >= max_attempts ||
         (plant_prebound == 1 && now - started >= bound_seconds) ||
         (plant_prebound != 1 && now - started > bound_seconds))); then
        state_lock "$state_file"
        replace_state "$state_file" '.phase="escalation"'
        state_unlock
        deliver_escalation "$state_file"
        return
    fi
    attempt=$((attempt + 1))
    if [[ "$mode" == outbox ]]; then
        outbox_entry="$(json_field "$state_file" '.outbox_entry')"
        remaining=$((bound_seconds - (now - started)))
        set +e
        run_with_absolute_deadline "$remaining" \
            env SNO_REACH_SKIP_WAKE_ADOPTION=1 SNO_REACH_SKIP_OUTBOX_RETRY=1 \
            SNO_REACH_ROOT="$(json_field "$state_file" '.root')" SNO_REACH_OUTBOX_ENTRY="$outbox_entry" \
            "$REACH" flush --as "$(json_field "$state_file" '.sender')" \
            >/dev/null 2>&1
        flush_status=$?
        set -e
        now="$(now_epoch)"
        if [[ -d "$outbox_entry" && ! -L "$outbox_entry" &&
              -f "$outbox_entry/recipients" && ! -L "$outbox_entry/recipients" ]]; then
            recipients_json="$(jq -Rsc 'split("\n") | map(select(length > 0))' \
                "$outbox_entry/recipients")"
            state_lock "$state_file"
            replace_state "$state_file" '.outbox_recipients=$recipients' \
                --argjson recipients "$recipients_json"
            state_unlock
        fi
        if ((flush_status == 0)) || message_effect "$state_file"; then
            mark_terminal "$state_file" confirmed delivered "$now"
            return 0
        fi
        state_lock "$state_file"
        replace_state "$state_file" \
            '.attempt=$attempt | .last_outcome="delivery-failed" | .last_at=$at' \
            --argjson attempt "$attempt" --argjson at "$now"
        state_unlock
        append_log "$state_file" attempt delivery-failed "$now"
        if ((attempt >= max_attempts || now - started >= bound_seconds)); then
            state_lock "$state_file"
            replace_state "$state_file" '.phase="escalation"'
            state_unlock
            deliver_escalation "$state_file"
            return
        fi
        return 4
    fi
    mechanism_outcome="$(invoke_mechanism "$state_file")"
    outcome="$mechanism_outcome"
    if [[ "$mechanism_outcome" == registered-but-unresolvable ]]; then
        outcome=unknown
        reachability_state=registered-but-unresolvable
    fi
    state_lock "$state_file"
    replace_state "$state_file" \
        '.attempt=$attempt | .last_outcome=$outcome | .last_at=$at |
         .reachability_state=$reachability_state' \
        --argjson attempt "$attempt" --arg outcome "$outcome" \
        --arg reachability_state "$reachability_state" --argjson at "$now"
    state_unlock
    append_log "$state_file" attempt "$outcome" "$now"
    if [[ "$outcome" == no-wake-channel ]]; then
        mark_terminal "$state_file" not-applicable "$outcome" "$now"
        return 0
    fi
    if [[ "$outcome" == rang ]] && message_effect "$state_file"; then
        mark_terminal "$state_file" confirmed rang "$now"
        return 0
    fi
    if ((attempt >= max_attempts || now - started >= bound_seconds)); then
        state_lock "$state_file"
        replace_state "$state_file" '.phase="escalation"'
        state_unlock
        deliver_escalation "$state_file"
        return
    fi
    return 4
}

parse_start() {
    ROOT=''
    SENDER=''
    RECIPIENT=''
    MESSAGE_ID=''
    JOURNEY=''
    MECHANISM=''
    OUTBOX_ENTRY=''
    ONCE=no
    while (($# > 0)); do
        case "$1" in
            --root) ROOT="${2:-}"; shift 2 ;;
            --sender) SENDER="${2:-}"; shift 2 ;;
            --recipient) RECIPIENT="${2:-}"; shift 2 ;;
            --message-id) MESSAGE_ID="${2:-}"; shift 2 ;;
            --work) JOURNEY="${2:-}"; shift 2 ;;
            --mechanism) MECHANISM="${2:-}"; shift 2 ;;
            --outbox-entry) OUTBOX_ENTRY="${2:-}"; shift 2 ;;
            --once) ONCE=yes; shift ;;
            *) die 64 "unsupported start option: $1" ;;
        esac
    done
    validate_root "$ROOT"
    validate_address "$SENDER"
    validate_address "$RECIPIENT"
    validate_message_id "$MESSAGE_ID"
    [[ "$JOURNEY" =~ ^[^[:space:][:cntrl:]]+$ ]] ||
        die 64 'journey must be one non-empty bare token'
    if [[ -n "$OUTBOX_ENTRY" ]]; then
        [[ "$OUTBOX_ENTRY" == "$ROOT/$SENDER/outbox/"* &&
           -d "$OUTBOX_ENTRY" && ! -L "$OUTBOX_ENTRY" &&
           -f "$OUTBOX_ENTRY/message" && ! -L "$OUTBOX_ENTRY/message" &&
           -f "$OUTBOX_ENTRY/recipients" && ! -L "$OUTBOX_ENTRY/recipients" ]] ||
            die 65 'outbox entry is unsafe or incomplete'
    fi
}

run_start() {
    local now attempts spacing bound_seconds attempt_id state_dir state_file supervisor outcome child
    local mechanism_outcome reachability_state=registered diagnostic_outcome mode=wake
    local parent_start child_start
    local standin="${SNO_REACH_WAKE_STANDIN:-}"
    local outcome_hint="${SNO_REACH_WAKE_OUTCOME:-}"

    parse_start "$@"
    [[ "${SNO_REACH_WAKE_NO_DETACH:-0}" == 1 ]] || require_setsid
    if [[ -n "$OUTBOX_ENTRY" ]]; then
        attempts="${SNO_REACH_WAKE_ATTEMPTS:-$OUTBOX_DEFAULT_ATTEMPTS}"
        spacing="${SNO_REACH_WAKE_SPACING_SECONDS:-$OUTBOX_DEFAULT_SPACING_SECONDS}"
        bound_seconds="$OUTBOX_BOUND_SECONDS"
    else
        attempts="${SNO_REACH_WAKE_ATTEMPTS:-$WAKE_DEFAULT_ATTEMPTS}"
        spacing="${SNO_REACH_WAKE_SPACING_SECONDS:-$WAKE_DEFAULT_SPACING_SECONDS}"
        bound_seconds="$WAKE_BOUND_SECONDS"
    fi
    [[ "$attempts" =~ ^[1-9][0-9]*$ && "$spacing" =~ ^[1-9][0-9]*$ ]] ||
        die 64 'wake attempts and spacing must be positive integers'
    [[ -z "$standin" || -x "$standin" ]] || die 64 'wake stand-in is not executable'
    [[ -z "$standin" || -n "$outcome_hint" ]] ||
        die 64 'SNO_REACH_WAKE_OUTCOME is required with a stand-in'
    if [[ -n "$OUTBOX_ENTRY" ]]; then
        [[ -d "$ROOT/$SENDER" && ! -L "$ROOT/$SENDER" ]] ||
            die 73 "sender seat is unavailable: $ROOT/$SENDER"
        state_dir="$ROOT/$SENDER/wake-attempts"
    else
        [[ -d "$ROOT/$RECIPIENT" && ! -L "$ROOT/$RECIPIENT" ]] ||
            die 73 "recipient seat is unavailable: $ROOT/$RECIPIENT"
        state_dir="$ROOT/$RECIPIENT/wake-attempts"
    fi
    mkdir -p -- "$state_dir" || die 74 'could not create wake attempt directory'
    [[ -d "$state_dir" && ! -L "$state_dir" ]] ||
        die 65 "wake attempt directory is unsafe: $state_dir"
    now="$(now_epoch)"
    [[ -z "$OUTBOX_ENTRY" ]] || mode=outbox
    attempt_id="$(printf '%s' "$MESSAGE_ID:$SENDER:$RECIPIENT:$now:$$:$RANDOM" | sha256sum | cut -c1-32)"
    state_file="$state_dir/$attempt_id.json"
    if [[ "$mode" == outbox ]]; then
        supervisor="$(resolve_supervisor "$ROOT" "$SENDER" || true)"
    else
        supervisor="$(resolve_supervisor "$ROOT" "$RECIPIENT" || true)"
    fi
    parent_start="$(process_start_ticks "$$")" ||
        die 74 'could not identify the wake starter process'
    jq -n \
        --arg attempt_id "$attempt_id" --arg root "$ROOT" \
        --arg sender "$SENDER" --arg recipient "$RECIPIENT" \
        --arg supervisor "$supervisor" --arg message_id "$MESSAGE_ID" \
        --arg journey "$JOURNEY" --arg mechanism "$MECHANISM" \
        --arg mode "$mode" --arg outbox_entry "$OUTBOX_ENTRY" \
        --arg state_owner "$([[ "$mode" == outbox ]] && printf '%s' "$SENDER" || printf '%s' "$RECIPIENT")" \
        --arg standin "$standin" --arg outcome_hint "$outcome_hint" \
        --argjson started_at "$now" --argjson attempts "$attempts" \
        --argjson spacing "$spacing" --argjson bound_seconds "$bound_seconds" \
        --argjson pid "$$" --arg child_start "$parent_start" \
        '{version:1, attempt_id:$attempt_id, root:$root, sender:$sender,
          recipient:$recipient, supervisor:$supervisor, message_id:$message_id,
          journey:$journey, mechanism:$mechanism, mode:$mode,
          state_owner:$state_owner,
          outbox_entry:$outbox_entry, standin:$standin,
          outcome_hint:$outcome_hint, started_at:$started_at, last_at:$started_at,
          attempt:0, max_attempts:$attempts, spacing_seconds:$spacing,
          bound_seconds:$bound_seconds, child_pid:$pid,
          child_start_ticks:($child_start | tonumber? // .), state:"pending",
          phase:"retry", last_outcome:"none",
          reachability_state:"registered", escalation_sent:false,
          escalation_delivered:[], outbox_recipients:[], removed_recipients:[]}' >"$state_file" ||
        die 74 'could not create wake attempt state'
    chmod 0600 "$state_file"
    if [[ "$mode" == outbox ]]; then
        replace_state "$state_file" \
            '.last_outcome="delivery-failed" | .outbox_recipients=$recipients' \
            --argjson recipients "$(jq -Rsc 'split("\n") | map(select(length > 0))' "$OUTBOX_ENTRY/recipients")"
        append_log "$state_file" attempt delivery-failed "$now"
        if separate_removed_outbox_recipients "$state_file"; then
            removed_status=0
        else
            removed_status=$?
        fi
        ((removed_status != 2)) || return 0
        if [[ "${SNO_REACH_WAKE_NO_DETACH:-0}" != 1 ]]; then
            setsid "$0" run --state "$state_file" 8>&- 9>&- >/dev/null 2>&1 &
            child=$!
            child_start="$(process_start_ticks "$child")" ||
                die 74 'could not identify the outbox retry worker process'
            replace_state "$state_file" \
                '.child_pid=$pid | .child_start_ticks=($start | tonumber? // .)' \
                --argjson pid "$child" --arg start "$child_start"
        fi
        printf 'reach: outbox recovery for %s is pending; do not resend.\n' \
            "$RECIPIENT" >&2
        return 5
    fi
    mechanism_outcome="$(invoke_mechanism "$state_file")"
    outcome="$mechanism_outcome"
    if [[ "$mechanism_outcome" == registered-but-unresolvable ]]; then
        outcome=unknown
        reachability_state=registered-but-unresolvable
    fi
    replace_state "$state_file" \
        '.last_outcome=$outcome | .reachability_state=$reachability_state' \
        --arg outcome "$outcome" --arg reachability_state "$reachability_state"
    append_log "$state_file" attempt "$outcome" "$now"
    if [[ "$outcome" == no-wake-channel ]]; then
        mark_terminal "$state_file" not-applicable "$outcome" "$now"
        printf 'reach: delivery succeeded; %s has no wake channel by design. Mailbox pickup occurs at turn boundaries.\n' \
            "$RECIPIENT" >&2
        return 0
    fi
    if [[ "$ONCE" == yes ]]; then
        mark_terminal "$state_file" not-applicable "$outcome" "$now"
        case "$outcome" in
            rang | rang-unverified | busy)
                printf 'reach: delivery succeeded; wake %s reached %s once. Do not resend.\n' \
                    "$outcome" "$RECIPIENT" >&2
                return 0
                ;;
        esac
        printf 'reach: delivery succeeded; wake %s for %s failed; no retry is scheduled. Do not resend.\n' \
            "$outcome" "$RECIPIENT" >&2
        return 6
    fi
    if [[ "$outcome" == rang ]] && message_effect "$state_file"; then
        mark_terminal "$state_file" confirmed rang "$now"
        printf 'wake confirmed recipient=%s message=%s\n' "$RECIPIENT" "$MESSAGE_ID" >&2
        return 0
    fi
    if [[ "${SNO_REACH_WAKE_NO_DETACH:-0}" != 1 ]]; then
        setsid "$0" run --state "$state_file" 8>&- 9>&- >/dev/null 2>&1 &
        child=$!
        child_start="$(process_start_ticks "$child")" ||
            die 74 'could not identify the wake retry worker process'
        replace_state "$state_file" \
            '.child_pid=$pid | .child_start_ticks=($start | tonumber? // .)' \
            --argjson pid "$child" --arg start "$child_start"
    fi
    # The doorbell reached a live channel: rang and rang-unverified put the
    # keystroke into the recipient's window, and busy is a recipient proven
    # awake mid-turn, so it is not a failure class. None of the three is
    # confirmed yet -- the effect
    # at the destination is only observable once the recipient acts, which the
    # detached retry above watches for -- so the attempt stays pending and is
    # never marked terminal here.  Reporting these as a failed wake made the
    # alarm fire on every send and therefore carry no information.
    case "$outcome" in
        rang | rang-unverified | busy)
            printf 'reach: delivery succeeded; wake %s reached %s. Confirmation continues in the background. Do not resend.\n' \
                "$outcome" "$RECIPIENT" >&2
            return 0
            ;;
    esac
    diagnostic_outcome="$outcome"
    [[ "$reachability_state" != registered-but-unresolvable ]] ||
        diagnostic_outcome="$reachability_state"
    printf 'reach: delivery succeeded; wake %s for %s has not reached a live channel; a retry is running. Do not resend.\n' \
        "$diagnostic_outcome" "$RECIPIENT" >&2
    return 5
}

run_adopt() {
    local root="$1"
    local state_file state pid start now started child self_start child_start

    require_setsid
    self_start="$(process_start_ticks "$$")" ||
        die 74 'could not identify the wake adopter process'

    validate_root "$root"
    [[ -d "$root" && ! -L "$root" ]] || return 0
    while IFS= read -r -d '' state_file; do
        state="$(json_field "$state_file" '.state' 2>/dev/null || printf invalid)"
        [[ "$state" == pending ]] || continue
        pid="$(json_field "$state_file" '.child_pid' 2>/dev/null || printf 0)"
        start="$(json_field "$state_file" '.child_start_ticks' 2>/dev/null || printf 0)"
        if process_owns_attempt "$pid" "$start"; then
            continue
        fi
        state_lock "$state_file"
        if [[ "$(json_field "$state_file" '.state')" != pending ]]; then
            state_unlock
            continue
        fi
        pid="$(json_field "$state_file" '.child_pid')"
        start="$(json_field "$state_file" '.child_start_ticks' 2>/dev/null || printf 0)"
        if process_owns_attempt "$pid" "$start"; then
            state_unlock
            continue
        fi
        now="$(now_epoch)"
        started="$(json_field "$state_file" '.started_at')"
        if ((now - started > $(json_field "$state_file" '.bound_seconds'))); then
            replace_state "$state_file" \
                '.child_pid=$pid | .child_start_ticks=($start | tonumber? // .)' \
                --argjson pid "$$" --arg start "$self_start"
            state_unlock
            append_log "$state_file" adopted '' "$now"
            state_lock "$state_file"
            replace_state "$state_file" '.phase="escalation"'
            state_unlock
            deliver_escalation "$state_file" || true
        else
            replace_state "$state_file" \
                '.child_pid=$pid | .child_start_ticks=($start | tonumber? // .)' \
                --argjson pid "$$" --arg start "$self_start"
            state_unlock
            append_log "$state_file" adopted '' "$now"
            state_lock "$state_file"
            if [[ "$(json_field "$state_file" '.state')" != pending ||
                  "$(json_field "$state_file" '.child_pid')" != "$$" ||
                  "$(json_field "$state_file" '.child_start_ticks')" != "$self_start" ]]; then
                state_unlock
                continue
            fi
            setsid "$0" run --state "$state_file" 8>&- 9>&- >/dev/null 2>&1 &
            child=$!
            child_start="$(process_start_ticks "$child")" ||
                die 74 'could not identify the adopted retry worker process'
            replace_state "$state_file" \
                '.child_pid=$pid | .child_start_ticks=($start | tonumber? // .)' \
                --argjson pid "$child" --arg start "$child_start"
            state_unlock
        fi
    done < <(
        # Pass paths as batched arguments: Bash's NUL-delimited pipe reads cost
        # one syscall per byte. Keep reader errors visible, unlike find errors.
        # shellcheck disable=SC2016
        find "$root" -mindepth 3 -maxdepth 3 -path '*/wake-attempts/*.json' -type f \
            -exec bash -c '
                exec 2>&3 3>&-
                for candidate; do
                    printf "%s\0%s\0" "$candidate" "$(<"$candidate")"
                done
            ' bash {} + 3>&2 2>/dev/null |
        jq -Rjs '
            split("\u0000") | range(0; length - 1; 2) as $i |
            select(.[$i + 1] | fromjson? | .state? == "pending") |
            .[$i] + "\u0000"
        ')
}

(($# > 0)) || die 64 'usage: reach-wake <start|run|step|adopt> [options]'
operation="$1"
shift
case "$operation" in
    start) run_start "$@" ;;
    run)
        [[ "${1:-}" == --state && -n "${2:-}" && $# == 2 ]] ||
            die 64 'run needs --state PATH'
        run_retry "$2"
        ;;
    step)
        [[ "${1:-}" == --state && -n "${2:-}" && $# == 2 ]] ||
            die 64 'step needs --state PATH'
        retry_once "$2"
        ;;
    adopt)
        [[ "${1:-}" == --root && -n "${2:-}" && $# == 2 ]] ||
            die 64 'adopt needs --root PATH'
        run_adopt "$2"
        ;;
    *) die 64 "unsupported operation: $operation" ;;
esac
