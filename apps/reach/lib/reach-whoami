#!/usr/bin/env bash
set -Eeuo pipefail

root="${SNO_REACH_ROOT:-$HOME/.local/state/sno-reach}"
if [[ "${1-}" == --help && $# == 1 ]]; then
    printf 'usage: sno reach whoami\n'
    exit 0
fi
if (($#)); then
    printf 'reach whoami %s: expected no arguments\n' "$root" >&2
    { printf 'reach whoami %s: expected no arguments\n' "$root" >>"$root/reach.log"; } 2>/dev/null || true
    exit 64
fi
# True only when the nearest agent above this process is a Claude Code background session (a fork,
# --bg or a reused spare). CLAUDE_PID is inherited by everything a conversation starts, so an agent
# such as Codex started from a fork is its own agent, not the fork.
claude_background_session() {
    local pid=$$ comm
    [[ -n "${CLAUDE_PID:-}" ]] || return 1
    while [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)); do
        if [[ "$pid" == "$CLAUDE_PID" ]]; then
            [[ "$(jq -r '.kind // empty' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions/$pid.json" 2>/dev/null)" == bg ]]
            return
        fi
        comm="$(ps -o comm= -p "$pid" 2>/dev/null)"
        case "${comm##*/}" in codex | codex-* | cursor-agent | hermes | openclaw) return 1 ;; esac
        pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    done
    return 1
}
# A background session inherits the seat address and window variables of the conversation it came
# from, so neither identifies it.
! claude_background_session || exit 1
if [[ -n "${SNO_REACH_ADDR:-}" ]]; then
    printf '%s\n' "$SNO_REACH_ADDR"
    exit 0
fi
orca="${ORCA_TAB_ID:-}" pane="${TMUX_PANE:-}"
[[ -n "$orca$pane" ]] || exit 1
shopt -s nullglob
records=("$root"/*/reachable.json)
(("${#records[@]}")) || exit 1

handle=''
if [[ -n "$pane" ]]; then
    terminal="$(tmux display-message -pt "$pane" $'#{socket_path}\t#{pid}\t#{session_name}' 2>/dev/null)" || exit 1
    server="$(printf '%s\n' "${terminal%$'\t'*}" | sha256sum)"
    handle="tmux-${server%% *}:${terminal##*$'\t'}"
fi
if matches="$(jq -r --arg orca "$orca" --arg pane "$pane" --arg handle "$handle" '
    select(($pane == "" and $orca != "" and .channel == "orca" and
            (.identity.value == $orca or .handle == $orca)) or
           ($pane != "" and .channel == "tmux" and .identity.value == $pane and .handle == $handle)) |
    .address | strings | select(length > 0)
' "${records[@]}" 2>&1)"; then
    [[ -n "$matches" ]] || exit 1
    printf '%s\n' "${matches%%$'\n'*}"
else
    printf 'reach whoami %s: read seat registrations: %s\n' "$root" "$matches" >&2
    { printf 'reach whoami %s: read seat registrations: %s\n' "$root" "$matches" >>"$root/reach.log"; } 2>/dev/null || true
    exit 74
fi
