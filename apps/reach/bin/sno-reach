#!/usr/bin/env bash
# Keep terminal signals in the caller while timeout owns one private invocation.
set -Eeuo pipefail
release="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)"
# A Cursor stop hook waits up to an hour for a card, past the 290 s deadline below; Cursor's own
# hook timeout bounds it instead.
[[ "${1-}" != cursor-hook ]] || exec "$release/lib/reach-cursor-hook" "${@:2}"
invocation=''
finish() {
    local status=$?
    trap - EXIT HUP INT TERM
    invocation="${invocation:-${!:-}}"
    if [[ -n "$invocation" ]]; then
        kill -TERM -- "-$invocation" 2>/dev/null || kill -TERM "$invocation" 2>/dev/null || true
        wait "$invocation" 2>/dev/null || true
        kill -KILL -- "-$invocation" 2>/dev/null || true
    fi
    case "$status" in
        124|137) printf 'reach: command deadline exceeded; inspect mailbox/outbox before any explicit retry.\n' >&2 ;;
    esac
    exit "$status"
}
trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
perl -MPOSIX -e '$SIG{INT}=$SIG{QUIT}="DEFAULT"; POSIX::setsid() >= 0 or die "reach: setsid failed: $!\n"; exec @ARGV or die "reach: exec failed: $!\n"' \
    timeout --verbose --signal=TERM --kill-after=5 290 "$release/lib/reach-main" "$@" <&0 &
invocation=$!
wait "$invocation"
