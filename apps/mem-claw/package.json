{
  "name": "@snoai/mem-claw",
  "version": "1.0.0-rc.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sno-ai/sno-station.git",
    "directory": "apps/mem-claw"
  },
  "type": "module",
  "description": "Sno Memory for OpenClaw: local-first long-term memory for OpenClaw agents.",
  "main": "./dist/self-upgrade/entry-shim.js",
  "types": "./dist/self-upgrade/entry-shim.d.ts",
  "exports": {
    ".": {
      "types": "./dist/self-upgrade/entry-shim.d.ts",
      "import": "./dist/self-upgrade/entry-shim.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json"
  },
  "bin": {
    "mem-claw": "./bin/mem-claw-install.js",
    "mem-claw-install": "./bin/mem-claw-install.js",
    "sno-memdump": "./bin/sno-memdump.js"
  },
  "files": [
    "bin",
    "dist",
    "openclaw.plugin.json",
    "package.json",
    "LICENSE",
    "README.md",
    "scripts/observe-postinstall.mjs"
  ],
  "scripts": {
    "dev": "tsx watch src/install/openclaw-plugin-runtime.ts",
    "build": "tsdown",
    "prepack": "npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "sqlite-vec:build": "npm run sqlite-vec:build --workspace @snoai/sno-station-mem",
    "sqlite-vec:check": "npm run sqlite-vec:check --workspace @snoai/sno-station-mem",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "query-manifest:capture": "npm run query-manifest:capture --workspace @snoai/sno-station-mem",
    "maintenance:group-crud": "npm run maintenance:group-crud --workspace @snoai/sno-station-mem",
    "store:clean": "npm run store:clean --workspace @snoai/sno-station-mem",
    "rem:guard-census": "npm run rem:guard-census --workspace @snoai/sno-station-mem",
    "llmix:check-registry": "npm run llmix:check-registry --workspace @snoai/sno-station-mem",
    "db:generate": "npm run db:generate --workspace @snoai/sno-station-mem",
    "db:migrate": "npm run db:migrate --workspace @snoai/sno-station-mem",
    "db:studio": "npm run db:studio --workspace @snoai/sno-station-mem",
    "postinstall": "node scripts/observe-postinstall.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@napi-rs/keyring": "^2.0.0",
    "@sinclair/typebox": "^0.34.49",
    "@snoai/chunking": "1.0.1",
    "@snoai/common-core": "^0.1.0",
    "@snoai/content-sanitizer": "^0.99.3",
    "@snoai/embedder": "^0.8.0",
    "@snoai/llmix": "2.2.0",
    "@snoai/mda-config": "^1.1.2",
    "@snoai/sno-observe": "^0.1.0",
    "@snoai/sno-station-core-crypto": "^0.2.0",
    "@snoai/utils": "^0.8.0",
    "argon2": "^0.45.1",
    "async-mutex": "^0.5.0",
    "chrono-node": "2.10.1",
    "commander": "^14.0.1",
    "drizzle-orm": "^0.45.2",
    "eld": "^2.0.3",
    "js-tiktoken": "^1.0.21",
    "lru-cache": "^11.3.5",
    "onnxruntime-node": "1.21.1",
    "openclaw": "2026.9.2",
    "semver": "^7.6.3",
    "sqlite-vec": "^0.1.6",
    "tar": "^7.4.3",
    "uuid": "^14.0.0",
    "zod": "^4.5.4",
    "@snoai/sno-station-mem": "1.0.0-rc.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@hono/node-server": "^2.0.6",
    "@types/node": "^22.15.0",
    "@types/semver": "^7.5.8",
    "american-british-english-translator": "^0.2.1",
    "pluralize": "^8.0.0",
    "tsdown": "0.22.5",
    "tsx": "^4.20.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/self-upgrade/entry-shim.js"
    ]
  }
}
