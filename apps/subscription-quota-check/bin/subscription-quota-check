#!/usr/bin/env bash
if [ "${BASH_VERSINFO[0]}" -lt 5 ]; then
	printf 'subscription-quota-check: needs Bash 5 or newer on PATH as bash (this one is %s); install it and run again.\n' "$BASH_VERSION" >&2
	exit 2
fi
# subscription-quota-check : read subscription quota state for Codex and/or Claude Code.
#
# Never calls a model. Never spends anything. Never prints credentials.
#
# Answers "can work start now", not "how much money is left". These are the plan's 5-hour
# and weekly windows, not API-key billing.
#
# Exit codes (stable; callers branch on these):
#   0  every requested vendor is usable now
#   1  at least one requested vendor is blocked (quota reached), none unreadable
#   2  usage or argument error
#   3  at least one requested vendor could not be read (unknown state)
#   4  at least one requested vendor needs credentials refreshed / is not logged in

set -Eeuo pipefail

readonly PROG="${0##*/}"
readonly CODEX_RPC_TIMEOUT_SEC=25
readonly CLAUDE_TIMEOUT_SEC=30
# ~/.claude.json cachedUsageUtilization is treated by its own writer as valid for one hour.
# Past that horizon the numbers must be reported as unknown, never as a reading.
readonly CACHE_INVALID_SEC=3600

# Headroom on the tightest window below which the verdict is short_only instead of go.
#
# PICKED, NOT MEASURED. One reading says how much is used; it never says how fast it burns,
# so no reading can prove a long job will fit. Owning one number here beats every caller
# inventing its own: change this line and the whole company changes with it.
readonly SHORT_ONLY_REMAINING_PCT=20

usage() {
	cat <<'EOF'
sno subscription-quota-check — read Codex / Claude Code subscription quota without
spending anything. Reports whether work can start now.

Usage:
  sno subscription-quota-check [--vendor codex|claude|both] [--json|--human] [--quiet]
  sno subscription-quota-check --agent <id> [--seat <address>] [--model <model>]
  sno subscription-quota-check --pick handoff|review --from <id> [--seat <address>] [--model <model>] --json
  sno subscription-quota-check --vendor cursor [--seat <address>] [--json|--human]

Options:
  --vendor <v>   Which vendor to read. Default: both. cursor is read only when named.
  --agent <id>   Read claude-code, codex, cursor, hermes, or openclaw; always JSON.
  --seat <addr>  Reach seat whose current session supplies the model and provider;
                 with --vendor cursor, its surface also supplies the login.
  --model <m>    Model to read when no seat is given; locked agents keep their vendor.
  --pick <p>     List different-vendor handoff or review candidates; always JSON.
  --from <id>    Sender for --pick. With no seat, Hermes/OpenClaw/Cursor need --model.
  --json         One JSON object on stdout (default when stdout is not a terminal).
  --human        One line per vendor on stdout (default when stdout is a terminal).
  --quiet        Suppress the stderr progress note.
  -h, --help     This text.

Exit codes:
  0  all requested vendors usable now
  1  at least one blocked by quota
  2  usage or argument error
  3  at least one unreadable (state unknown)
  4  at least one needs credentials refreshed

Verdict, per vendor and overall:
  go          the tightest window still has headroom
  short_only  usable, but the tightest window has less than the configured headroom left
  wait        blocked now; seconds_to_reset says for how long
  owner_action blocked by a workspace limit; contact the workspace owner
  unknown     could not be read, or the numbers could not be shown to be current
  needs_auth  credentials need refreshing
  n/a         not a subscription-limited session (API key / Bedrock / Vertex)
  unread      provider has no account usage; available for picking, not an error

Notes:
  Reads only. This never invokes a model and never redeems a rate-limit reset credit.
  Run it when a decision needs it, or after something was actually blocked. It is not
  built to be polled: the Claude usage endpoint is itself rate limited.
  To wait for a reset, arm the `heartbeat` skill using seconds_to_reset of the BLOCKING
  window and re-run this probe in the hook — the reset instant is the server's to move,
  so only a fresh read proves a block is gone.
  This reads the credentials the two CLIs own. It does not measure accounts behind
  OPENAI_BASE_URL or on another machine.
  Picker order: [models] handoff_order in ${XDG_CONFIG_HOME:-~/.config}/sno/models.toml,
  default "claude-code,codex,cursor,hermes,openclaw".
EOF
	if [[ -n "${OPENAI_BASE_URL:-}" ]]; then
		printf '%s\n' '  OPENAI_BASE_URL is configured; its account quota is not measured here.'
	else
		printf '%s\n' "  using the harness's own endpoint; quota describes only the CLIs."
	fi
}

note() { [[ "${QUIET}" == "1" ]] || printf '%s: %s\n' "$PROG" "$*" >&2; }
die() {
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit "${2:-2}"
}

require() {
	local missing=0 cmd use available version
	for cmd in "$@"; do
		available=yes
		case "$cmd" in
			jq) use='read quota JSON' ;;
			timeout) use='bound quota requests' ;;
			date) use='read reset times' ;;
			mkfifo) use='communicate with the quota service' ;;
		esac
		if ! command -v "$cmd" >/dev/null 2>&1; then
			available=no
		elif [[ "$cmd" == timeout ]]; then
			version="$(timeout --version 2>/dev/null)" || available=no
			[[ "${version%%$'\n'*}" == *'GNU coreutils'* ]] || available=no
		fi
		if [[ "$available" == no ]]; then
			printf '%s: needs %s — %s; install it and run again.\n' "$PROG" "$cmd" "$use" >&2
			missing=$((missing + 1))
		fi
	done
	((missing == 0)) || exit 2
}
require jq timeout date mkfifo

now_epoch() { date -u +%s; }

# ---------------------------------------------------------------- Codex ------

# Emits the raw JSON-RPC result line for account/rateLimits/read, or nothing.
#
# app-server exits the moment stdin closes, so stdin has to be held open until the answer
# arrives. The hold also has to be CLOSABLE. Holding it with `tail -f /dev/null` is not:
# nothing can close that pipe, so the pipeline only unwinds when the timeout expires and
# every probe costs the full CODEX_RPC_TIMEOUT_SEC whether it succeeded or not. Measured
# on codex-cli 0.147.0: 26 s per probe for an answer that lands in under 1 s. A FIFO whose
# write end is a shell descriptor is closable, so the probe ends when the answer does.
codex_rpc_read() {
	local dir pid raw="" ticks=0
	local -i max_ticks=$((CODEX_RPC_TIMEOUT_SEC * 10))

	dir="$(mktemp -d "${SCRATCH}/codex-rpc.XXXXXX")" || return 0
	mkfifo "$dir/in" || { rm -rf -- "$dir"; return 0; }

	timeout "$CODEX_RPC_TIMEOUT_SEC" codex -s read-only app-server \
		<"$dir/in" >"$dir/out" 2>/dev/null &
	pid=$!

	exec 9>"$dir/in"
	printf '%s\n' \
		'{"id":1,"method":"initialize","params":{"clientInfo":{"name":"quota-check","version":"1"}}}' \
		'{"method":"initialized"}' \
		'{"id":2,"method":"account/rateLimits/read"}' >&9

	# Poll the capture file instead of reading the pipe: the server answers and then keeps
	# serving, so a reader that waits for EOF would wait for the timeout again. Give up as
	# soon as the server is gone — a fast failure must stay fast, because the caller retries.
	while ((ticks < max_ticks)); do
		raw="$(grep -m1 '"id":2' "$dir/out" 2>/dev/null || true)"
		[[ -n "$raw" ]] && break
		kill -0 "$pid" 2>/dev/null || break
		sleep 0.1
		ticks=$((ticks + 1))
	done

	exec 9>&-
	kill "$pid" 2>/dev/null || true
	wait "$pid" 2>/dev/null || true
	rm -rf -- "$dir"
	printf '%s' "$raw"
}

# True only when the CLI reports a logged-in ChatGPT account.
#
# Anchored on purpose. A bare search for "logged in" also matches "Not logged in", which
# turns a logged-out account into "quota unknown" — the exact conflation this branch exists
# to prevent. VERIFIED wording on codex-cli 0.147.0: `Logged in using ChatGPT`.
codex_logged_in() {
	local out
	out="$(timeout 20 codex login status 2>&1)" || true
	printf '%s' "$out" | grep -qiE '^[[:space:]]*Logged in'
}

# Builds the codex vendor object on stdout.
codex_probe() {
	local raw attempt=0

	if ! command -v codex >/dev/null 2>&1; then
		jq -n '{vendor:"codex",state:"unreadable",verdict:"unknown",
		        reason:"codex command not found on PATH"}'
		return
	fi

	while ((attempt < 2)); do
		raw="$(codex_rpc_read)"
		[[ -n "$raw" ]] && break
		attempt=$((attempt + 1))
		note "codex: empty response from app-server (attempt ${attempt}/2)"
	done

	if [[ -z "$raw" ]]; then
		# Distinguish "not logged in" from "out of quota" — the research doc is explicit
		# that conflating them is the common wrong report.
		if codex_logged_in; then
			jq -n '{vendor:"codex",state:"unreadable",verdict:"unknown",
			        reason:"app-server returned no response after 2 attempts"}'
		else
			jq -n '{vendor:"codex",state:"needs_auth",verdict:"needs_auth",
			        reason:"codex login status does not report a logged-in ChatGPT account"}'
		fi
		return
	fi

	if ! printf '%s' "$raw" | jq -e '.result.rateLimits' >/dev/null 2>&1; then
		jq -n --arg r "$(printf '%s' "$raw" | head -c 200)" \
			'{vendor:"codex",state:"unreadable",verdict:"unknown",
			 reason:("unexpected payload: " + $r)}'
		return
	fi

	printf '%s' "$raw" | jq -c \
		--argjson now "$(now_epoch)" \
		--argjson short "$SHORT_ONLY_REMAINING_PCT" \
		--arg cli_version "$(codex --version 2>/dev/null | head -1)" '
		def window($w):
			if $w == null then null
			else {
				used_pct: $w.usedPercent,
				window_minutes: $w.windowDurationMins,
				resets_at_epoch: $w.resetsAt,
				# A null reset time is reported as unknown. Never synthesised from the
				# window length: the blocking bucket here was a 7-day window 37 minutes
				# from reset, so window length is not a wait.
				seconds_to_reset: (if $w.resetsAt == null then null else ($w.resetsAt - $now) end)
			} end;
		def bucket($b):
			{
				limit_id: $b.limitId,
				limit_name: $b.limitName,
				plan_type: $b.planType,
				# Trust the reached flag over the percentage: blocked can precede 100%.
				blocked: ($b.rateLimitReachedType != null),
				owner_action: (($b.rateLimitReachedType // "")
					| test("^workspace_(.*_)?(credits_depleted|usage_limit_reached)$")),
				reached_type: $b.rateLimitReachedType,
				spend_control_reached: $b.spendControlReached,
				individual_limit: $b.individualLimit,
				credits: {has: $b.credits.hasCredits, balance: $b.credits.balance,
				          unlimited: $b.credits.unlimited},
				primary: window($b.primary),
				secondary: window($b.secondary)
			};
		.result as $r
		| ($r.rateLimitsByLimitId // {}) as $all
		| [ $all | to_entries[] | bucket(.value) ] as $buckets
		| ($buckets | map(select(.blocked))) as $blocked
		| ($blocked | map(select(.owner_action))) as $owner_action
		# The tightest window across every bucket and both slots: the one that stops work
		# first. Named in the output, so "short_only" is never a mystery verdict.
		| ([ $all | to_entries[] | .key as $k
		     | (.value.primary, .value.secondary) | select(. != null)
		     | {limit_id: $k, used_pct: .usedPercent,
		        window_minutes: .windowDurationMins,
		        resets_at_epoch: .resetsAt,
		        seconds_to_reset: (if .resetsAt == null then null else (.resetsAt - $now) end)} ]
		   | sort_by(-.used_pct) | .[0]) as $tightest
		| {
			vendor: "codex",
			cli_version: $cli_version,
			state: (if ($owner_action | length) > 0 then "owner_action"
			        elif ($blocked | length) > 0 then "blocked" else "ok" end),
			verdict: (if ($owner_action | length) > 0 then "owner_action"
			          elif ($blocked | length) > 0 then "wait"
			          elif ($tightest != null and (100 - $tightest.used_pct) < $short)
			          then "short_only"
			          else "go" end),
			tightest_window: $tightest,
			buckets: $buckets,
			# The headline: which bucket blocks, and when it frees up.
			blocking: (if ($owner_action | length) > 0 then
			             ($owner_action[0] | {limit_id, limit_name, reached_type,
			              used_pct: .primary.used_pct, resets_at_epoch: null,
			              seconds_to_reset: null,
			              required_action: "contact_workspace_owner"})
			           elif ($blocked | length) == 0 then null
			           else ([ $blocked[]
			                 | ([.primary, .secondary] | map(select(. != null and .used_pct >= 100))) as $full
			                 | (if ($full | length) > 0 then $full[] else .primary end) as $w
			                 | {limit_id, limit_name, reached_type,
			                    used_pct: $w.used_pct,
			                    resets_at_epoch: $w.resets_at_epoch,
			                    seconds_to_reset: $w.seconds_to_reset} ]
			                 | max_by(.seconds_to_reset // 1e18)) end)
		  }'
}

# --------------------------------------------------------------- Claude ------

claude_cache_age_sec() {
	local f="$HOME/.claude.json" fetched
	[[ -r "$f" ]] || return 1
	fetched="$(jq -r '.cachedUsageUtilization.fetchedAtMs // empty' <"$f" 2>/dev/null)" || return 1
	[[ -n "$fetched" ]] || return 1
	printf '%s' $(((($(now_epoch) * 1000) - fetched) / 1000))
}

# The structured path drops the ok/seeded flag, so it cannot report its own staleness.
# Only the text path says so, in these two literal strings.
# Returns 0 for stale, 1 for fresh, and 2 when the text check is unavailable.
claude_text_is_stale() {
	local out
	out="$(timeout "$CLAUDE_TIMEOUT_SEC" claude --safe-mode --no-session-persistence \
		-p "/usage" 2>/dev/null)" || return 2
	[[ -n "$out" ]] || return 2
	printf '%s' "$out" | grep -qiE 'Showing last-known usage|Could not refresh usage data'
}

claude_probe() {
	local json age freshness="unknown"

	if ! command -v claude >/dev/null 2>&1; then
		jq -n '{vendor:"claude",state:"unreadable",verdict:"unknown",
		        reason:"claude command not found on PATH"}'
		return
	fi

	json="$(printf '%s\n' \
		'{"type":"control_request","request_id":"q","request":{"subtype":"get_usage"}}' |
		timeout "$CLAUDE_TIMEOUT_SEC" claude --safe-mode --no-session-persistence \
			-p --input-format stream-json --output-format stream-json --verbose 2>/dev/null |
		jq -c 'select(.type=="control_response") | .response.response' 2>/dev/null |
		head -1)" || true

	if [[ -z "$json" || "$json" == null ]]; then
		jq -n '{vendor:"claude",state:"unreadable",verdict:"unknown",
		        reason:"get_usage control request returned no result"}'
		return
	fi

	if ! printf '%s' "$json" | jq -e '.rate_limits_available | type == "boolean"' >/dev/null 2>&1; then
		jq -n '{vendor:"claude",state:"unreadable",verdict:"unknown",
		        reason:"rate_limits_available is absent or not a boolean"}'
		return
	fi

	# rate_limits_available:false means API key / Bedrock / Vertex — plan limits do not
	# apply at all. Reporting 0% there would be a lie in the usable direction.
	if printf '%s' "$json" | jq -e '.rate_limits_available == false' >/dev/null; then
		jq -n '{vendor:"claude",state:"not_applicable",verdict:"n/a",
		        reason:"rate_limits_available is false: not a subscription-limited session"}'
		return
	fi

	age="$(claude_cache_age_sec)" || age=""

	# The text path decides freshness, and it always runs. fetchedAtMs cannot decide it:
	# the writer refuses to rewrite an entry younger than five minutes, so a young
	# timestamp is compatible with both a live fetch and a suppressed one. Only the text
	# path says out loud that it served last-known data. It costs ~7 s of the ~8 s a claude
	# probe takes, and this probe runs on demand, not on a timer.
	if claude_text_is_stale; then
		freshness="stale"
	elif [[ $? != 1 ]]; then
		freshness="unknown"
	elif [[ -n "$age" ]] && ((age > CACHE_INVALID_SEC)); then
		# Nothing complained, yet the cache is past the horizon its own writer honours.
		freshness="unknown"
	else
		freshness="fresh"
	fi

	# Numbers that cannot be shown to be current do not answer "can work start now".
	# Reporting them anyway is how a stale reading becomes a green light.
	if [[ "$freshness" != "fresh" ]]; then
		jq -n --arg f "$freshness" --arg a "${age:-unknown}" \
			'{vendor:"claude",state:"unreadable",verdict:"unknown",freshness:$f,
			  reason:("usage data is " + $f + " (cache age " + $a
			          + "s); refusing to answer from numbers that may not be current")}'
		return
	fi

	printf '%s' "$json" | jq -c \
		--argjson now "$(now_epoch)" \
		--argjson short "$SHORT_ONLY_REMAINING_PCT" \
		--arg freshness "$freshness" \
		--arg age "${age:-}" \
		--arg cli_version "$(claude --version 2>/dev/null | head -1)" '
		def iso2epoch($t):
			if $t == null then null
			else ($t | sub("\\.[0-9]+";"")
			         | sub("(?<s>[+-][0-9]{2}):(?<m>[0-9]{2})$";"Z")
			         | sub("Z$";"Z")
			         | fromdateiso8601)
			end;
		def win($w):
			if $w == null then null
			else {
				used_pct: $w.utilization,
				remaining_pct: (100 - $w.utilization),
				resets_at: $w.resets_at,
				seconds_to_reset: (if $w.resets_at == null then null
				                   else (iso2epoch($w.resets_at) - $now) end)
			} end;
		.rate_limits as $rl
		| ($rl.limits // []) as $limits
		| ($limits | map(select(.is_active)) | .[0]) as $binding
		# is_active names the window that stops you first. When the server names none,
		# fall back to whichever present window is fullest — never to just the 5-hour one,
		# which reads "87% left" on a machine that is 73% through its week.
		| (if $binding != null then $binding.percent
		   else ([$rl.five_hour.utilization, $rl.seven_day.utilization]
		         | map(select(. != null)) | max) end) as $tight_pct
		| ($binding // (if $tight_pct >= 100 then
		     if $rl.five_hour.utilization == $tight_pct then
		       {kind: "session", percent: $tight_pct, resets_at: $rl.five_hour.resets_at}
		     else {kind: "weekly_all", percent: $tight_pct, resets_at: $rl.seven_day.resets_at}
		     end else null end)) as $binding
		| {
			vendor: "claude",
			cli_version: $cli_version,
			# Blocked at a full active window or, when none is active, a full fallback window.
			state: (if $tight_pct >= 100 then "blocked" else "ok" end),
			verdict: (if $tight_pct >= 100 then "wait"
			          elif ($tight_pct != null and (100 - $tight_pct) < $short)
			          then "short_only"
			          else "go" end),
			tightest_window: {limit_id: ($binding.kind // "widest_present"),
			                  used_pct: $tight_pct,
			                  resets_at: ($binding.resets_at // null),
			                  seconds_to_reset: (if $binding.resets_at == null then null
			                                     else (iso2epoch($binding.resets_at) - $now) end)},
			freshness: $freshness,
			cache_age_sec: (if $age == "" then null else ($age | tonumber) end),
			subscription_type: .subscription_type,
			five_hour: win($rl.five_hour),
			seven_day: win($rl.seven_day),
			model_scoped: [ $limits[] | select(.kind == "weekly_scoped")
			                | {model: (.scope.model.display_name // "unknown"),
			                   used_pct: .percent, resets_at: .resets_at} ],
			binding_window: ($binding.kind // null),
			overage: {enabled: $rl.extra_usage.is_enabled,
			          used_pct: $rl.extra_usage.utilization,
			          disabled_reason: $rl.extra_usage.disabled_reason},
			blocking: (if $tight_pct >= 100
			           then {limit_id: $binding.kind, used_pct: $binding.percent,
			                 resets_at: $binding.resets_at,
			                 seconds_to_reset: (iso2epoch($binding.resets_at) - $now)}
			           else null end)
		  }'
}

# --------------------------------------------------------------- Cursor ------

# Vendor of a Cursor model id (build contract, sibling PRD DEC-3). Named apart from any
# general model-vendor helper so the two never shadow each other.
cursor_model_vendor() {
	local model="${1#cursor-}"
	case "$model" in
	claude*) printf 'anthropic' ;;
	gpt* | o[0-9]* | *codex*) printf 'openai' ;;
	gemini*) printf 'google' ;;
	grok*) printf 'xai' ;;
	composer* | default | auto) printf 'cursor' ;;
	*) printf '%s' "$model" ;;
	esac
}

# The conversation record the Sno Cursor hooks keep for a seat, on stdout.
# IDE seat: the conversation id is the seat's registered identity. CLI seat: the record whose
# reach_addr is the seat, newest event first.
cursor_seat_record() {
	local seat="$1" reach="${SNO_REACH_ROOT:-$HOME/.local/state/sno-reach}/$1/reachable.json"
	local conversations="${SNO_PROFILE_DIR:-$HOME/.sno}/cursor/conversations" id
	[[ -f "$reach" ]] || return 1
	if [[ "$(jq -r '.channel' "$reach")" == cursor-ide ]]; then
		id="$(jq -r '.identity.value' "$reach")"
		[[ -f "$conversations/$id.json" ]] && cat -- "$conversations/$id.json"
		return
	fi
	shopt -s nullglob
	local records=("$conversations"/*.json)
	shopt -u nullglob
	((${#records[@]})) || return 1
	jq -se --arg seat "$seat" 'map(select(.reach_addr == $seat)) | sort_by(.last_event) | last // empty' \
		"${records[@]}"
}

# Reads the access token of one login into $SCRATCH/cursor-token; never prints it.
# Sets CURSOR_LOGIN_REASON on failure. Returns 1 when the login is absent, 2 when unreadable.
cursor_read_token() {
	local login="$1" out="$SCRATCH/cursor-token" rc=0
	case "$login" in
	cli-file)
		[[ -f "$HOME/.config/cursor/auth.json" ]] || return 1
		jq -er '.accessToken | strings | select(length > 0)' "$HOME/.config/cursor/auth.json" >"$out" 2>/dev/null ||
			{ CURSOR_LOGIN_REASON="Cursor CLI login unreadable: no accessToken in ~/.config/cursor/auth.json"; return 2; }
		;;
	cli-keychain)
		command -v security >/dev/null 2>&1 || return 1
		security find-generic-password -s cursor-access-token -w >"$out" 2>"$SCRATCH/cursor-token.err" || rc=$?
		# 44 is errSecItemNotFound: no CLI login on this Mac.
		((rc != 44)) || return 1
		if ((rc != 0)); then
			if grep -qiE 'locked|interaction is not allowed' "$SCRATCH/cursor-token.err"; then
				CURSOR_LOGIN_REASON="Cursor CLI login unreadable (keychain locked)"
			else
				CURSOR_LOGIN_REASON="Cursor CLI login unreadable: security exit $rc: $(head -c 200 "$SCRATCH/cursor-token.err")"
			fi
			return 2
		fi
		;;
	ide-store)
		local db="$HOME/Library/Application Support/Cursor/User/globalStorage/state.vscdb"
		[[ -f "$db" ]] || return 1
		command -v sqlite3 >/dev/null 2>&1 ||
			{ CURSOR_LOGIN_REASON="Cursor IDE login unreadable: sqlite3 not on PATH"; return 2; }
		sqlite3 -readonly "$db" "SELECT value FROM ItemTable WHERE key = 'cursorAuth/accessToken'" >"$out" 2>"$SCRATCH/cursor-token.err" ||
			{ CURSOR_LOGIN_REASON="Cursor IDE login unreadable: $(head -c 200 "$SCRATCH/cursor-token.err")"; return 2; }
		;;
	esac
	local token
	token="$(<"$out")" token="${token#\"}" token="${token%\"}"
	printf '%s\n' "$token" >"$out"
	[[ -n "$token" ]] || { CURSOR_LOGIN_REASON="Cursor $login login is empty"; return 2; }
}

# Builds the cursor vendor object on stdout for the account behind the watched seat's login.
cursor_probe() {
	local seat="$1" record='' surface='' model="${2:-default}" login='' cli_login=cli-file rc=0 http body
	CURSOR_LOGIN_REASON=''
	cursor_unavailable() {
		jq -nc --arg r "$1" --arg seat "$seat" --arg login "$login" \
			'{vendor:"cursor",agent:"cursor",state:"unreadable",verdict:"unknown",reason:$r}
			 + (if $seat == "" then {} else {seat:$seat} end)
			 + (if $login == "" then {} else {login:$login} end)'
	}
	[[ "$(uname -s)" != Darwin ]] || cli_login='cli-keychain'
	if [[ -n "$seat" ]]; then
		[[ -f "${SNO_REACH_ROOT:-$HOME/.local/state/sno-reach}/$seat/reachable.json" ]] ||
			{ cursor_unavailable "seat unknown: $seat is not a registered Reach seat"; return; }
		record="$(cursor_seat_record "$seat")" || record=''
		[[ -n "$record" ]] ||
			{ cursor_unavailable "seat model unknown: no Cursor conversation record for seat $seat"; return; }
		surface="$(jq -r '.surface // empty' <<<"$record")"
		model="$(jq -r '.model // empty' <<<"$record")"
		[[ -n "$model" ]] || { cursor_unavailable "seat model unknown: the record for seat $seat names no model"; return; }
		if [[ "$surface" == ide ]]; then login=ide-store; else login="$cli_login"; fi
		cursor_read_token "$login" || rc=$?
	else
		# No seat: the CLI login when present, else the IDE store; default model unless supplied.
		login="$cli_login"
		cursor_read_token "$login" || rc=$?
		if ((rc == 1)); then
			login=ide-store rc=0
			cursor_read_token "$login" || rc=$?
		fi
	fi
	((rc != 1)) || { cursor_unavailable "Cursor $login login not found"; return; }
	((rc == 0)) || { cursor_unavailable "$CURSOR_LOGIN_REASON"; return; }
	command -v curl >/dev/null 2>&1 || { cursor_unavailable "curl not on PATH: the Cursor usage endpoint cannot be read"; return; }

	# The token travels in a header file, never in argv where ps would show it.
	printf 'Authorization: Bearer %s\n' "$(<"$SCRATCH/cursor-token")" >"$SCRATCH/cursor-auth"
	rm -f -- "$SCRATCH/cursor-token"
	http="$(curl -sS --max-time 20 -o "$SCRATCH/cursor-usage.json" -w '%{http_code}' -X POST \
		-H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -H "@$SCRATCH/cursor-auth" \
		-d '{}' https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage 2>"$SCRATCH/cursor-usage.err")" || http=''
	if [[ "$http" != 200 ]]; then
		body="$(head -c 200 "$SCRATCH/cursor-usage.json" 2>/dev/null || true)"
		[[ -n "$body" ]] || body="$(head -c 200 "$SCRATCH/cursor-usage.err")"
		# A refused login is a login to renew, not an unknown reading.
		if [[ "$http" == 401 || "$http" == 403 ]]; then
			jq -nc --arg r "Cursor usage endpoint refused the $login login (HTTP $http): $body" --arg login "$login" \
				'{vendor:"cursor",agent:"cursor",state:"needs_auth",verdict:"needs_auth",login:$login,reason:$r}'
		else
			cursor_unavailable "Cursor usage endpoint failed (HTTP ${http:-none}): $body"
		fi
		return
	fi
	jq -c --arg model "$model" --arg model_vendor "$(cursor_model_vendor "$model")" --arg login "$login" \
		--arg seat "$seat" --argjson now "$(now_epoch)" --argjson short "$SHORT_ONLY_REMAINING_PCT" '
		def pool_verdict($p): if $p >= 100 then "wait" elif (100 - $p) < $short then "short_only" else "go" end;
		(.billingCycleEnd | tonumber / 1000 | floor) as $reset
		| {auto: {used_percent: .planUsage.autoPercentUsed}, named: {used_percent: .planUsage.apiPercentUsed}}
		| if any(.[]; .used_percent | type != "number") then error("planUsage percentages missing") else . end
		| map_values(.verdict = pool_verdict(.used_percent)) as $pools
		# Cursor-served models and Auto draw on the auto pool; every other named model on the named pool.
		| (if ($model | test("^(default|auto|cursor-|composer|grok)")) then "auto" else "named" end) as $pool
		| $pools[$pool] as $p
		| {vendor: "cursor", agent: "cursor", model: $model, model_vendor: $model_vendor, login: $login,
		   pools: $pools, pool: $pool,
		   state: (if $p.used_percent >= 100 then "blocked" else "ok" end),
		   verdict: $p.verdict,
		   tightest_window: {limit_id: $pool, used_pct: $p.used_percent, resets_at_epoch: $reset,
		                     seconds_to_reset: ($reset - $now)},
		   blocking: (if $p.used_percent >= 100
		              then {limit_id: $pool, used_pct: $p.used_percent, resets_at_epoch: $reset,
		                    seconds_to_reset: ($reset - $now)}
		              else null end)}
		  + (if $seat == "" then {} else {seat: $seat} end)' "$SCRATCH/cursor-usage.json" 2>"$SCRATCH/cursor-usage.err" ||
		cursor_unavailable "Cursor usage response unreadable: $(head -c 200 "$SCRATCH/cursor-usage.err")"
}

# --------------------------------------------------------------- output ------

# One line per vendor: name, verdict, then the evidence the verdict came from.
human_line() {
	local obj="$1"
	printf '%s' "$obj" | jq -r --argjson short "$SHORT_ONLY_REMAINING_PCT" '
		def hhmm($s): if $s == null then "?"
		              else ((($s/3600)|floor|tostring) + "h" + ((($s%3600)/60)|floor|tostring) + "m") end;
		def pad($w): (. + (" " * ($w - length)));
		(.vendor | pad(8)) as $v
		| ((.verdict // "unknown") | ascii_upcase | pad(11)) as $verdict
		| $v + " " + $verdict + (
			if .state == "owner_action" then
				"workspace limit " + .blocking.reached_type + "; contact workspace owner"
			elif .state == "blocked" then
				"\(.blocking.limit_id) at \(.blocking.used_pct)%, frees in "
				+ hhmm(.blocking.seconds_to_reset)
			elif .state == "ok" and .vendor == "cursor" then
				"pool \(.pool) \(.tightest_window.used_pct)% used · auto:\(.pools.auto.used_percent)%"
				+ " named:\(.pools.named.used_percent)% model:\(.model) login:\(.login)"
			elif .state == "ok" and .vendor == "codex" then
				"tightest \(.tightest_window.limit_id) \(.tightest_window.used_pct)% used"
				+ " · " + ([.buckets[] | "\(.limit_id):\(.primary.used_pct // "?")%"] | join(" "))
			elif .state == "ok" then
				"tightest \(.tightest_window.limit_id) \(.tightest_window.used_pct)% used"
				+ " · 5h:\(.five_hour.used_pct)% 7d:\(.seven_day.used_pct)%"
				+ " freshness:\(.freshness)"
			else
				.reason
			end)'
}

# ----------------------------------------------------------- agent routing ---

model_vendor() {
	local provider="$1" model="$2"
	case "$provider" in
	openai | openai-codex | codex | chatgpt) printf 'openai'; return ;;
	anthropic | claude) printf 'anthropic'; return ;;
	custom* | local*) printf 'local:%s' "$provider"; return ;;
	esac
	if [[ "$model" == */* ]]; then
		model_vendor "${model%%/*}" "${model#*/}"
	elif [[ -z "$provider" ]]; then
		model="${model#cursor-}"
		case "$model" in
		claude*) printf 'anthropic' ;;
		gpt* | o[0-9]* | *codex*) printf 'openai' ;;
		gemini*) printf 'google' ;;
		grok*) printf 'xai' ;;
		composer* | default | auto) printf 'cursor' ;;
		esac
	else
		printf '%s' "$provider"
	fi
}

model_record() {
	local model="$1" provider="${2:-}"
	if [[ -z "$provider" ]]; then
		if [[ "$model" == */* ]]; then
			provider="${model%%/*}"; model="${model#*/}"
		else
			provider="$(model_vendor '' "$model")"
		fi
	fi
	jq -cn --arg model "$model" --arg provider "$provider" \
		'{model:(if $model=="" then null else $model end),provider:$provider}'
}

declare -A QUOTA_CACHE=()
OPENCLAW_USAGE='' OPENCLAW_USAGE_FAILED=0
agent_command() {
	local agent="$1" key out no_usage rc=0 seconds=30; shift
	[[ "$agent" != openclaw ]] || seconds=90
	printf -v key '%q ' "$@"
	out="$(timeout -k 2 "$seconds" "$@" 2>"$SCRATCH/command.err")" || rc=$?
	if ((rc != 0)); then
		if [[ "$agent" == hermes && "${2:-}" == usage ]]; then
			no_usage="No account usage available for provider '${4:-}': no credential is configured for it, the provider has no usage endpoint, or the fetch failed."
			if [[ "$out" == "$no_usage" || "$(cat "$SCRATCH/command.err")" == "$no_usage" ]]; then
				printf '%s' "$no_usage"
				return 0
			fi
		fi
		printf '%s: agent %s command %sfailed (exit %s): %s\n' \
			"$PROG" "$agent" "$key" "$rc" "$(cat "$SCRATCH/command.err")" >&2
		return 1
	fi
	printf '%s' "$out"
}

hermes_session() {
	local record="$1" session cwd since listed exported candidate
	session="$(jq -r '.session_id // empty' "$record")" || return 1
	if [[ -n "$session" ]]; then printf '%s' "$session"; return; fi
	cwd="$(jq -r '.cwd // empty' "$record")" || return 1
	since="$(jq -r '.spawned_at // 0' "$record")" || return 1
	listed="$(agent_command hermes hermes sessions list --workspace "$(basename -- "$cwd")" --limit 30)" || return 1
	while IFS= read -r candidate; do
		[[ -n "$candidate" ]] || continue
		exported="$(agent_command hermes hermes sessions export - --format jsonl --session-id "$candidate")" || continue
		session="$(jq -rse --arg id "$candidate" --arg seat "$SEAT" --argjson earliest "$((since - 60))" '
			[.[] | select(.id==$id and .started_at >= $earliest and
				([.messages[]? | select(.role=="user")][0].content // "" | contains($seat)))]
			| if length==1 then .[0].id else empty end' <<<"$exported" 2>/dev/null)" || continue
		printf '%s' "$session"; return
	done < <(awk '$NF ~ /^[0-9]{8}_[0-9]{6}_[0-9a-f]{6}$/ {print $NF}' <<<"$listed")
	return 1
}

current_model() {
	local agent="$1" record session raw home="${HERMES_HOME:-$HOME/.hermes}" files=()
	case "$agent" in
	claude-code) model_record "$MODEL" anthropic; return ;;
	codex) model_record "$MODEL" openai; return ;;
	cursor)
		if [[ -n "$SEAT" ]]; then
			record="$(cursor_seat_record "$SEAT")" || return 1
			raw="$(jq -er '.model | strings | select(length > 0)' <<<"$record")" || return 1
		else
			[[ -n "$MODEL" ]] || return 1
			raw="$MODEL"
		fi
		model_record "$raw"; return ;;
	esac
	if [[ -z "$SEAT" ]]; then
		[[ -n "$MODEL" ]] || return 1
		model_record "$MODEL" | jq -c --arg model "$MODEL" '.model=$model'; return
	fi
	record="${SNO_REACH_STATE_ROOT:-$HOME/.local/state/sno-reach}/$SEAT/transcript.json"
	[[ -r "$record" ]] || return 1
	if [[ "$agent" == openclaw ]]; then
		session="$(jq -er '.session_key' "$record")" || return 1
		raw="$(agent_command openclaw openclaw sessions list --json)" || return 1
		jq -ce --arg key "$session" '.sessions[] | select(.key==$key)
			| select(.model != null and .modelProvider != null)
			| {model,provider:.modelProvider}' <<<"$raw"
		return
	fi
	session="$(hermes_session "$record")" || return 1
	[[ ! -r "$home/logs/agent.log.1" ]] || files+=("$home/logs/agent.log.1")
	[[ ! -r "$home/logs/agent.log" ]] || files+=("$home/logs/agent.log")
	if ((${#files[@]})); then
		raw="$(awk -v id="[$session]" 'index($0,id) && /agent.conversation_loop: API call #[0-9]+:/ {
			if ($0 >= latest) { latest=$0; model=""; provider="";
				for (i=1;i<=NF;i++) {if ($i ~ /^model=/) model=substr($i,7); if ($i ~ /^provider=/) provider=substr($i,10)}
			}
		} END {if (model!="" && provider!="") print model "\t" provider}' "${files[@]}")"
		if [[ -n "$raw" ]]; then
			model_record "${raw%%$'\t'*}" "${raw#*$'\t'}"; return
		fi
	fi
	# Only before a first successful request is the session row authoritative.
	timeout -k 2 10 python3 - "$home/state.db" "$session" <<'PY'
import json, pathlib, sqlite3, sys
try:
    with sqlite3.connect(pathlib.Path(sys.argv[1]).as_uri() + '?mode=ro', uri=True) as db:
        row = db.execute('SELECT model, billing_provider FROM sessions WHERE id = ?', (sys.argv[2],)).fetchone()
    if not row or not row[0] or not row[1]:
        sys.exit(1)
    print(json.dumps({'model': row[0], 'provider': row[1]}))
except (sqlite3.Error, OSError) as error:
    print('hermes session model read failed: ' + str(error), file=sys.stderr)
    sys.exit(1)
PY
}

usage_windows() {
	local agent="$1" provider="$2"
	jq -ce --arg agent "$agent" --arg provider "$provider" --argjson now "$(now_epoch)" --argjson short "$SHORT_ONLY_REMAINING_PCT" '
		if $agent=="hermes" then
			.windows | if type!="array" then error("expected windows") else
				map({limit_id:.label,used_pct:.used_percent,resets_at}) end
		else
			.usage.providers | if type!="array" then error("expected providers") else
				[.[] | select(.provider==$provider) | .windows[] | {limit_id:.label,used_pct:.usedPercent,
					resets_at:(if .resetAt==null then null else (.resetAt/1000 | floor | todateiso8601) end)}] end
		end
		| map(if (.used_pct | type)=="number" then . else error("expected numeric usage percent") end)
		| max_by(.used_pct) as $w
		| {vendor:$provider,state:(if $w.used_pct >= 100 then "blocked" else "ok" end),
			verdict:(if $w==null then "unread" elif $w.used_pct>=100 then "wait"
				elif (100-$w.used_pct)<=$short then "short_only" else "go" end),
			tightest_window:(if $w==null then null else
				$w | .used_pct |= round | .seconds_to_reset=(if .resets_at==null then null else
					((.resets_at | sub("\\.[0-9]+";"") | sub("\\+00:00$";"Z") | fromdateiso8601)-$now) end) end)}' 2>"$SCRATCH/command.err" || {
		printf '%s: agent %s command %s failed parsing usage: %s\n' "$PROG" "$agent" \
			"$([[ "$agent" == hermes ]] && printf 'hermes usage --provider %s --json' "$provider" || printf 'openclaw status --usage --json')" \
			"$(cat "$SCRATCH/command.err")" >&2
		return 1
	}
}

# Writes QUOTA, rather than returning it in a subshell, so provider caches survive.
agent_quota() {
	local agent="$1" provider="$2" model="${3:-}" seat="${4:-}" key raw
	key="$agent:$provider"
	[[ "$agent" != cursor ]] || key="$agent:$seat:$model"
	if [[ -n "${QUOTA_CACHE[$key]+yes}" ]]; then QUOTA="${QUOTA_CACHE[$key]}"; return; fi
	QUOTA_CACHE[$key]='{"state":"unreadable","verdict":"unknown","reason":"quota read failed"}'
	case "$agent" in
	codex) QUOTA="$(codex_probe)" ;;
	claude-code) QUOTA="$(claude_probe)" ;;
	cursor) QUOTA="$(cursor_probe "$seat" "$model")" ;;
	hermes)
		raw="$(agent_command hermes hermes usage --provider "$provider" --json)" || return 1
		[[ "$raw" != 'No account usage available'* ]] || raw='{"windows":[]}'
		QUOTA="$(usage_windows "$agent" "$provider" <<<"$raw")" || return 1
		;;
	openclaw)
		# One status command supplies every provider, including other-model candidates.
		if [[ -n "$OPENCLAW_USAGE" ]]; then raw="$OPENCLAW_USAGE"
		elif ((OPENCLAW_USAGE_FAILED)); then return 1
		else
			raw="$(agent_command openclaw openclaw status --usage --json)" || { OPENCLAW_USAGE_FAILED=1; return 1; }
			OPENCLAW_USAGE="$raw"
		fi
		QUOTA="$(usage_windows "$agent" "$provider" <<<"$raw")" || return 1
		;;
	esac
	if [[ "$(jq -r '.state' <<<"$QUOTA")" == unreadable || "$(jq -r '.state' <<<"$QUOTA")" == needs_auth ]]; then
		printf '%s: agent %s command %s failed: %s\n' "$PROG" "$agent" \
			"$(case "$agent" in codex) printf 'codex app-server account/rateLimits/read' ;; cursor) printf 'Cursor GetCurrentPeriodUsage' ;; *) printf 'claude get_usage' ;; esac)" \
			"$(jq -r '.reason' <<<"$QUOTA")" >&2
	fi
	QUOTA_CACHE[$key]="$QUOTA"
}

agent_read() {
	local agent="$1" current provider vendor code=0 reason='current-model-unknown'
	if ! current="$(current_model "$agent")"; then
		jq -n --arg agent "$agent" --arg reason "$reason" \
			'{ok:false,operation:"agent-read",agent:$agent,reason:$reason}'
		return 3
	fi
	provider="$(jq -r '.provider' <<<"$current")"
	vendor="$(model_vendor "$provider" "$(jq -r '.model // ""' <<<"$current")")"
	if ! agent_quota "$agent" "$provider" "$(jq -r '.model // ""' <<<"$current")" "$SEAT"; then
		QUOTA='{"state":"unreadable","verdict":"unknown","reason":"quota read failed"}'
	fi
	case "$(jq -r '.state' <<<"$QUOTA")" in
	blocked | owner_action) code=1 ;; unreadable) code=3 ;; needs_auth) code=4 ;;
	esac
	jq -n --arg agent "$agent" --arg vendor "$vendor" --argjson current "$current" \
		--argjson quota "$QUOTA" --argjson code "$code" --arg host "$(uname -n)" \
		--arg captured "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '
		{ok:($code==0),operation:"agent-read",captured_at:$captured,host:$host,agent:$agent,
		model:$current.model,provider:$current.provider,model_vendor:$vendor,
		vendor:($quota | if .tightest_window!=null then .tightest_window.used_pct |= round
			| .tightest_window.resets_at //= (if .tightest_window.resets_at_epoch==null then null else
				(.tightest_window.resets_at_epoch | todateiso8601) end) else . end)}'
	return "$code"
}

agent_models() {
	local agent="$1" raw status fallbacks models record seat='' seats=()
	case "$agent" in
	claude-code) model_record '' anthropic ;;
	codex) model_record '' openai ;;
	cursor)
		if [[ "$FROM" == cursor ]]; then
			seat="$SEAT"
		else
			for record in "${SNO_REACH_ROOT:-$HOME/.local/state/sno-reach}"/*/reachable.json; do
				[[ -f "$record" ]] || continue
				if jq -e '.harness=="cursor" or .channel=="cursor-ide"' "$record" >/dev/null 2>&1; then
					seats+=("$(basename -- "$(dirname -- "$record")")")
				fi
			done
			((${#seats[@]} == 1)) || return 1
			seat="${seats[0]}"
		fi
		raw="$(SEAT="$seat" current_model cursor)" || return 1
		jq -c --arg seat "$seat" '. + (if $seat=="" then {} else {seat:$seat} end)' <<<"$raw"
		;;
	hermes)
		raw="$(agent_command hermes hermes fallback list)" || return 1
		awk '/Primary:|^[[:space:]]*[0-9]+\./ {model=$2; provider=$4; sub(/\)$/, "", provider); print model "\t" provider}' <<<"$raw" |
			while IFS=$'\t' read -r model provider; do model_record "$model" "$provider"; done
		;;
	openclaw)
		status="$(agent_command openclaw openclaw models status --json)" || return 1
		fallbacks="$(agent_command openclaw openclaw models fallbacks list --json)" || return 1
		models="$(agent_command openclaw openclaw models list --json)" || return 1
		raw="$(jq -nre --argjson status "$status" --argjson fallbacks "$fallbacks" --argjson models "$models" '
			[$status.defaultModel, $fallbacks.fallbacks[], ($models.models[] | select(.available==true) | .key)]
			| reduce .[] as $m ([]; if index($m)!=null then . else .+[$m] end) | .[]')" || return 1
		while IFS= read -r model; do model_record "$model"; done <<<"$raw"
		;;
	esac
}

handoff_order() {
	local file="${XDG_CONFIG_HOME:-$HOME/.config}/sno/models.toml" value='claude-code,codex,cursor,hermes,openclaw'
	if [[ -f "$file" ]]; then
		value="$(awk '
			/^[[:space:]]*\[/ { models=($0 ~ /^[[:space:]]*\[models\][[:space:]]*(#.*)?$/); next }
			models && /^[[:space:]]*handoff_order[[:space:]]*=/ {
				value=$0; sub(/^[^=]*=[[:space:]]*/, "", value); quote=substr(value,1,1)
				if (quote!="\"" && quote!=sprintf("%c",39)) exit 2
				value=substr(value,2); end=index(value,quote)
				if (!end || substr(value,end+1)!~/^[[:space:]]*(#.*)?$/) exit 2
				print substr(value,1,end-1); exit
			}' "$file")" || die "cannot read quoted handoff_order from $file"
		value="${value:-claude-code,codex,cursor,hermes,openclaw}"
	fi
	jq -cn --arg value "$value" '$value | split(",") | map(gsub("^\\s+|\\s+$";""))'
}

pick_candidate() {
	local agent="$1" entry="$2" in_place="$3" provider vendor verdict='' reason='' detail='' cli login rc=0
	provider="$(jq -r '.provider' <<<"$entry")"
	vendor="$(model_vendor "$provider" "$(jq -r '.model // ""' <<<"$entry")")"
	cli="$agent"
	case "$agent" in claude-code) cli=claude ;; cursor) cli=cursor-agent ;; esac
	if ! command -v "$cli" >/dev/null; then
		printf '%s: agent %s command lookup failed: CLI not on PATH\n' "$PROG" "$agent" >&2
		reason='unavailable'
		detail="$cli command not found on PATH"
	elif [[ "$agent" == cursor ]]; then
		login=cli-file CURSOR_LOGIN_REASON=''
		[[ "$(uname -s)" != Darwin ]] || login='cli-keychain'
		cursor_read_token "$login" || rc=$?
		rm -f -- "$SCRATCH/cursor-token"
		if ((rc != 0)); then
			reason='unavailable'
			detail="${CURSOR_LOGIN_REASON:-Cursor $login login not found}"
		fi
	fi
	if [[ -z "$reason" ]] && ! agent_quota "$agent" "$provider" "$(jq -r '.model // ""' <<<"$entry")" "$(jq -r '.seat // ""' <<<"$entry")"; then
		reason='unavailable'
		if grep -qiE 'Named models unavailable|ActionRequiredError' "$SCRATCH/command.err"; then
			reason='no-quota'
			QUOTA_CACHE["$agent:$provider"]='{"state":"blocked","verdict":"wait"}'
		fi
	elif [[ -z "$reason" ]]; then
		verdict="$(jq -r '.verdict' <<<"$QUOTA")"
		if [[ "$verdict" == unknown || "$verdict" == needs_auth ]]; then
			reason='unavailable'
			[[ "$agent" != cursor ]] || detail="$(jq -r '.reason // "Cursor quota unreadable"' <<<"$QUOTA")"
		elif [[ "$vendor" == "$FROM_VENDOR" ]]; then reason='same-vendor'
		elif [[ "$verdict" == wait || "$verdict" == owner_action ]]; then reason='no-quota'
		fi
	fi
	if [[ -n "$reason" ]]; then
		jq -cn --argjson entry "$entry" --arg agent "$agent" --arg vendor "$vendor" --arg reason "$reason" --arg detail "$detail" \
			'$entry+{agent:$agent,vendor:$vendor,reason:$reason} + (if $agent=="cursor" and $detail!="" then {detail:$detail} else {} end)' >>"$SCRATCH/skipped"
	else
		jq -cn --argjson entry "$entry" --arg agent "$agent" --arg vendor "$vendor" \
			--argjson in_place "$in_place" --arg verdict "$verdict" \
			'$entry+{agent:$agent,vendor:$vendor,in_place:$in_place,verdict:$verdict}' >>"$SCRATCH/candidates"
	fi
}

agent_pick() {
	local sender current from_json order agent entries entry in_place record receiver_model
	agent_read "$FROM" >"$SCRATCH/sender" || true
	sender="$(cat "$SCRATCH/sender")"
	if ! jq -e 'has("model_vendor")' <<<"$sender" >/dev/null; then
		jq --arg purpose "$PICK" '.operation="pick" | .purpose=$purpose' <<<"$sender"
		return 3
	fi
	FROM_VENDOR="$(jq -r '.model_vendor' <<<"$sender")"
	current="$(jq -c '{model,provider}' <<<"$sender")"
	from_json="$(jq -c '{agent,model,provider,vendor:.model_vendor,verdict:.vendor.verdict}' <<<"$sender")"
	order="$(handoff_order)"
	while IFS= read -r agent; do
		case "$agent" in claude-code | codex | cursor | hermes | openclaw) ;;
		*) printf '%s: unknown agent in handoff_order ignored: %s\n' "$PROG" "$agent" >&2 ;;
		esac
	done < <(jq -r '.[]' <<<"$order")
	order="$(jq -c 'map(select(.=="claude-code" or .=="codex" or .=="cursor" or .=="hermes" or .=="openclaw"))' <<<"$order")"
	: >"$SCRATCH/candidates"; : >"$SCRATCH/skipped"
	# Load each model list once; sender's list also serves its review position.
	local -A lists=()
	local -a walk=()
	if [[ "$PICK" == handoff && ( "$FROM" == hermes || "$FROM" == openclaw ) ]]; then walk+=("$FROM"); fi
	while IFS= read -r agent; do
		[[ "$PICK" != handoff || "$agent" != "$FROM" ]] || continue
		walk+=("$agent")
	done < <(jq -r '.[]' <<<"$order")
	for agent in "${walk[@]}"; do
		in_place=false
		[[ "$PICK" != handoff || "$agent" != "$FROM" ]] || in_place=true
		if [[ -n "${lists[$agent]+yes}" ]]; then entries="${lists[$agent]}"
		elif entries="$(agent_models "$agent")" && [[ -n "$entries" ]]; then lists[$agent]="$entries"
		else
			jq -cn --arg agent "$agent" '{agent:$agent,model:null,provider:null,vendor:null,reason:"unavailable"}' >>"$SCRATCH/skipped"
			continue
		fi
		if [[ "$agent" == "$FROM" ]]; then
			entries="$(jq -cs --argjson current "$current" 'map(select({model,provider}!=$current)) | .[]' <<<"$entries")"
		elif [[ "$agent" == hermes || "$agent" == openclaw ]]; then
			# A uniquely recorded seat supplies current state; never guess a newest session.
			local -a seats=()
			for record in "${SNO_REACH_STATE_ROOT:-$HOME/.local/state/sno-reach}"/*/transcript.json; do
				[[ -f "$record" ]] || continue
				if jq -e --arg agent "$agent" '.runtime==$agent' "$record" >/dev/null 2>&1; then
					seats+=("$(basename -- "$(dirname -- "$record")")")
				fi
			done
			if ((${#seats[@]} == 1)) && receiver_model="$(SEAT="${seats[0]}" current_model "$agent")"; then
				entries="$(printf '%s\n%s\n' "$receiver_model" "$entries" | jq -cs '
					reduce .[] as $m ([]; if index($m)!=null then . else .+[$m] end) | .[]')"
			fi
		fi
		while IFS= read -r entry; do
			[[ -n "$entry" ]] || continue
			pick_candidate "$agent" "$entry" "$in_place"
		done <<<"$entries"
	done
	jq -n --arg purpose "$PICK" --argjson from "$from_json" --argjson order "$order" \
		--slurpfile candidates "$SCRATCH/candidates" --slurpfile skipped "$SCRATCH/skipped" \
		'{ok:true,operation:"pick",purpose:$purpose,from:$from,order:$order,
		candidates:$candidates,skipped:$skipped,chosen:($candidates[0] // null)}'
}

# ----------------------------------------------------------------- main ------

VENDOR="both"
FORMAT=""
QUIET=0
AGENT='' SEAT='' MODEL='' PICK='' FROM='' VENDOR_SET=0

while (($# > 0)); do
	case "$1" in
	--vendor)
		VENDOR_SET=1
		[[ $# -ge 2 ]] || die "--vendor needs a value: codex, claude, or both" 2
		VENDOR="$2"
		shift 2
		;;
	--vendor=*)
		VENDOR_SET=1
		VENDOR="${1#*=}"
		shift
		;;
	--agent | --seat | --model | --pick | --from)
		[[ $# -ge 2 && -n "$2" && "$2" != --* ]] || die "$1 needs a value"
		case "$1" in
		--agent) AGENT="$2" ;; --seat) SEAT="$2" ;; --model) MODEL="$2" ;;
		--pick) PICK="$2" ;; --from) FROM="$2" ;;
		esac
		shift 2
		;;
	--json)
		FORMAT="json"
		shift
		;;
	--human)
		FORMAT="human"
		shift
		;;
	--quiet)
		QUIET=1
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*) die "unknown argument: $1 (see --help)" 2 ;;
	esac
done
readonly QUIET

case "$VENDOR" in
codex | claude | both | cursor) ;;
*) die "--vendor must be codex, claude, both, or cursor (got: ${VENDOR})" 2 ;;
esac
[[ -z "$SEAT" || -n "$AGENT$PICK" || "$VENDOR" == cursor ]] || die "--seat applies only to --vendor cursor" 2

if [[ -z "$FORMAT" ]]; then
	if [[ -n "$AGENT$PICK" ]]; then FORMAT="json"
	elif [[ -t 1 ]]; then FORMAT="human"; else FORMAT="json"; fi
fi
readonly VENDOR FORMAT

# One scratch root for the whole run, removed however the script ends. The codex probe
# needs a FIFO on disk; a leaked one would be a live named pipe nobody owns.
SCRATCH="$(mktemp -d "${TMPDIR:-/tmp}/quota-check.XXXXXX")"
readonly SCRATCH
# `|| true` matters: under set -E a failing command inside an EXIT trap becomes the
# script's exit status, which would report a good reading as a failure.
trap 'rm -rf -- "$SCRATCH" 2>/dev/null || true' EXIT

if [[ -n "$AGENT" || -n "$PICK" ]]; then
	[[ "$VENDOR_SET" == 0 && "$FORMAT" != human ]] || die "--agent/--pick use JSON and cannot be combined with --vendor/--human"
	[[ -z "$AGENT" || -z "$PICK" ]] || die "choose --agent or --pick"
	for id in "$AGENT" "$FROM"; do
		case "$id" in '' | claude-code | codex | cursor | hermes | openclaw) ;;
		*) die "unknown agent: $id" ;;
		esac
	done
	if [[ -n "$PICK" ]]; then
		[[ "$PICK" == handoff || "$PICK" == review ]] || die "--pick must be handoff or review"
		[[ -n "$FROM" ]] || die "--pick requires --from"
		agent_pick
	else
		[[ -z "$FROM" ]] || die "--from requires --pick"
		agent_read "$AGENT"
	fi
	exit 0
fi
[[ -z "$FROM$MODEL" && ( -z "$SEAT" || "$VENDOR" == cursor ) ]] || die "--from/--seat/--model require --agent or --pick"

results=()
[[ "$VENDOR" == "codex" || "$VENDOR" == "both" ]] && results+=("$(codex_probe)")
[[ "$VENDOR" == "claude" || "$VENDOR" == "both" ]] && results+=("$(claude_probe)")
[[ "$VENDOR" == "cursor" ]] && results+=("$(cursor_probe "$SEAT")")

((${#results[@]} > 0)) || die "no vendor probed" 2

# Worst state wins the exit code, in this order.
exit_code=0
for obj in "${results[@]}"; do
	case "$(printf '%s' "$obj" | jq -r '.state')" in
	needs_auth) exit_code=4 ;;
	unreadable) ((exit_code == 4)) || exit_code=3 ;;
	blocked) ((exit_code >= 3)) || exit_code=1 ;;
	owner_action) ((exit_code >= 3)) || exit_code=1 ;;
	esac
done

# The overall verdict is the worst one present, in the same order the exit code uses.
overall="go"
for obj in "${results[@]}"; do
	case "$(printf '%s' "$obj" | jq -r '.verdict // "unknown"')" in
	needs_auth) overall="needs_auth" ;;
	unknown) [[ "$overall" == "needs_auth" ]] || overall="unknown" ;;
	owner_action) [[ "$overall" == "needs_auth" || "$overall" == "unknown" ]] || overall="owner_action" ;;
	wait) [[ "$overall" == "needs_auth" || "$overall" == "unknown" || "$overall" == "owner_action" ]] || overall="wait" ;;
	short_only) [[ "$overall" != "go" ]] || overall="short_only" ;;
	esac
done

if [[ "$FORMAT" == "json" ]]; then
	printf '%s\n' "${results[@]}" | jq -s \
		--arg captured_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
		--arg host "$(uname -n)" \
		--arg verdict "$overall" \
		--argjson short "$SHORT_ONLY_REMAINING_PCT" \
		--argjson exit_code "$exit_code" \
		'{ok: ($exit_code == 0), operation: "subscription-quota-check",
		  captured_at: $captured_at,
		  # Provenance travels with the number: these readings describe this host and the
		  # accounts these CLI builds are logged into, and nothing else.
		  host: $host,
		  short_only_below_remaining_pct: $short,
		  verdict: $verdict, exit_code: $exit_code, vendors: .}'
else
	for obj in "${results[@]}"; do human_line "$obj"; done
fi

exit "$exit_code"
